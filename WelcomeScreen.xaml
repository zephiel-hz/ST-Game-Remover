<Window x:Class="SteamPluginManager.WelcomeScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to ST Game Remover" 
        Height="650" Width="800"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <!-- Welcome Screen isolated palette (does NOT use app theme) -->
        <SolidColorBrush x:Key="WS_Background" Color="#0F1115"/>
        <SolidColorBrush x:Key="WS_Surface" Color="#161A20"/>
        <SolidColorBrush x:Key="WS_Border" Color="#262B33"/>
        <SolidColorBrush x:Key="WS_Text" Color="#E8EEF6"/>
        <SolidColorBrush x:Key="WS_TextMuted" Color="#A8B0BC"/>
        <SolidColorBrush x:Key="WS_Accent" Color="#3A86FF"/>
        <LinearGradientBrush x:Key="WS_Header" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#182033" Offset="0"/>
            <GradientStop Color="#111827" Offset="0.45"/>
            <GradientStop Color="#163A6D" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="FeatureGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#a8edea" Offset="0"/>
            <GradientStop Color="#fed6e3" Offset="1"/>
        </LinearGradientBrush>
        
        <!-- Drop Shadow Effects -->
        <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="20" ShadowDepth="5" Opacity="0.3"/>
        <DropShadowEffect x:Key="TextShadow" Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
        
        <!-- Animation -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="RootContainer" From="0" To="1" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Primary CTA Button Style -->
        <LinearGradientBrush x:Key="WS_PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3A86FF" Offset="0"/>
            <GradientStop Color="#2F6EDB" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="PrimaryCTAButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnRoot"
                                CornerRadius="12"
                                Background="{StaticResource WS_PrimaryGradient}"
                                SnapsToDevicePixels="True"
                                Effect="{StaticResource CardShadow}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="20,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnRoot" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4D94FF" Offset="0"/>
                                            <GradientStop Color="#3A86FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnRoot" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnRoot" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <!-- Main Container -->
        <Border x:Name="RootContainer" Background="{StaticResource WS_Surface}" 
                BorderBrush="{StaticResource WS_Border}" BorderThickness="1"
                CornerRadius="20" Margin="16" Effect="{StaticResource CardShadow}">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Header Section -->
                <Border Grid.Row="0" 
                        Background="{StaticResource WS_Header}" 
                        CornerRadius="20,20,0,0"
                        Padding="20,14">
                    <Grid HorizontalAlignment="Center" MaxWidth="900">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Title and Subtitle -->
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <TextBlock Text="{DynamicResource App.Title}" 
                                       FontSize="32" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource WS_Text}"
                                       HorizontalAlignment="Center"
                                       Effect="{StaticResource TextShadow}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            
                            <TextBlock Text="{DynamicResource Welcome.Subtitle}" 
                                       FontSize="16" 
                                       Foreground="{StaticResource WS_Text}" 
                                       Opacity="0.9"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"
                                       Effect="{StaticResource TextShadow}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Content Section (fits without scroll) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" Padding="20">
                    <Grid HorizontalAlignment="Center" MaxWidth="900">
                        <StackPanel>
                        <TextBlock Text="{DynamicResource Welcome.Title}" 
                                   FontSize="22" FontWeight="SemiBold" 
                                   Foreground="{StaticResource WS_Text}" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Welcome.Subtitle}" 
                                   FontSize="13" Opacity="0.8" 
                                   Foreground="{StaticResource WS_TextMuted}" 
                                   HorizontalAlignment="Center" Margin="0,8,0,22"/>

                        <!-- Two-column hero section -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Visual badge / illustration -->
                            <Border Grid.Column="0" Height="150" Width="230"
                                    CornerRadius="16"
                                    Background="{StaticResource WS_Surface}"
                                    BorderBrush="{StaticResource WS_Border}" BorderThickness="1"
                                    Effect="{StaticResource CardShadow}" HorizontalAlignment="Center">
                                <Grid>
                                    <Ellipse Width="120" Height="120" Fill="{StaticResource WS_Accent}" Opacity="0.12"/>
                                    <Ellipse Width="92" Height="92" Fill="{StaticResource WS_Accent}" Opacity="0.18"/>
                                    <Image Source="SGR.ico" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Rich description with styled bullets -->
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Welcome.Description}" 
                                           FontSize="14" 
                                           Foreground="{StaticResource WS_TextMuted}" 
                                           TextWrapping="Wrap" 
                                           LineHeight="22"
                                           Margin="0,0,0,8"/>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="10" Height="10" Fill="{StaticResource WS_Accent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Welcome.Feature1}" Foreground="{StaticResource WS_Text}" FontSize="13" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="10" Height="10" Fill="{StaticResource WS_Accent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Welcome.Feature2}" Foreground="{StaticResource WS_Text}" FontSize="13" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="10" Height="10" Fill="{StaticResource WS_Accent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Welcome.Feature3}" Foreground="{StaticResource WS_Text}" FontSize="13" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="v1.0.5" FontSize="11" Opacity="0.55" HorizontalAlignment="Center" Foreground="{StaticResource WS_TextMuted}"/>
                    </StackPanel>
                    </Grid>
                </ScrollViewer>
                
                <!-- Footer Section -->
                <Border Grid.Row="2" 
                        Background="{StaticResource WS_Surface}" 
                        CornerRadius="0,0,20,20"
                        Padding="20,14">
                    <Grid HorizontalAlignment="Center" MaxWidth="900">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Checkbox + explanation inline above CTA -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="DontShowAgainCheckBox"
                                      Foreground="{StaticResource WS_Text}"
                                      VerticalAlignment="Center"
                                      FontSize="12"/>
                            <TextBlock Text="{DynamicResource Welcome.DontShowAgain}" 
                                       Foreground="{StaticResource WS_TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Get Started Button (modern style) -->
                        <Button x:Name="GetStartedButton" 
                                Grid.Row="1"
                                Style="{StaticResource PrimaryCTAButton}"
                                Content="{DynamicResource Welcome.GetStarted}" 
                                Click="GetStartedButton_Click"/>
                    </Grid>
                </Border>

                <!-- Close Button overlay at top-right of card -->
                <Button x:Name="CloseButton" 
                        Grid.Row="0" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top"
                        Margin="0,6,6,0"
                        Width="30" Height="30"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        Cursor="Hand">
                    <Button.Content>
                        <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" 
                              Stroke="{StaticResource WS_Text}" 
                              StrokeThickness="2" 
                              Stretch="Uniform"/>
                    </Button.Content>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>