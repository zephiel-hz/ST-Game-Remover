# Copy this file to a local .env file and fill in the real values on your machine.
# Do not commit the real .env file or any secrets to Git.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_STORAGE_URL=https://your-project.storage.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET_NAME=hzmanifest

# GameBypass Cloudflare R2 account
R2_ENDPOINT=https://your-gamebypass-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-gamebypass-r2-access-key
R2_SECRET_KEY=your-gamebypass-r2-secret-key
R2_BUCKET=your-gamebypass-bucket

# OnlineFix uses a separate Cloudflare R2 account
ONLINEFIX_R2_ENDPOINT=https://your-onlinefix-account-id.r2.cloudflarestorage.com
ONLINEFIX_R2_ACCESS_KEY=your-onlinefix-r2-access-key
ONLINEFIX_R2_SECRET_KEY=your-onlinefix-r2-secret-key
ONLINEFIX_R2_BUCKET=your-onlinefix-bucket

DISCORD_GAME_REQUEST_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_BUG_REPORT_WEBHOOK_URL=https://discord.com/api/webhooks/...

SPM_BACKUP_PASSWORD=change-me-to-a-long-random-passphrase
