# Copy this file to a local .env file and fill in the real values on your machine.
# Do not commit the real .env file or any secrets to Git.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_STORAGE_URL=https://your-project.storage.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET_NAME=hzmanifest

R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=horizon

DISCORD_GAME_REQUEST_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_BUG_REPORT_WEBHOOK_URL=https://discord.com/api/webhooks/...

SPM_BACKUP_PASSWORD=change-me-to-a-long-random-passphrase
