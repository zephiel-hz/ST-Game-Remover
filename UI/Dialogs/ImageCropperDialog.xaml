<Window x:Class="SteamPluginManager.UI.Dialogs.ImageCropperDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Crop Profile Picture"
        Width="500" Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#1E2638"/>
        
        <Style x:Key="CropperActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="24,20"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="12" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Crop Viewport -->
                <RowDefinition Height="Auto"/> <!-- Zoom Controls -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                        Background="{DynamicResource ButtonBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Crop Profile Picture" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="Drag to reposition and zoom to fit into the avatar circle."
                               FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="CloseButton"
                        Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="Close"
                        Click="CancelButton_Click" VerticalAlignment="Top">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="closeBd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="closeBd" Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. Interactive Cropping Viewport -->
            <Border Grid.Row="1" Background="#0A0E17"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True"
                    Height="330"
                    VerticalAlignment="Center">
                <Grid x:Name="CropCanvasContainer"
                      MouseDown="CropCanvas_MouseDown"
                      MouseMove="CropCanvas_MouseMove"
                      MouseUp="CropCanvas_MouseUp"
                      MouseWheel="CropCanvas_MouseWheel"
                      Cursor="SizeAll"
                      Background="Transparent">

                    <!-- Image to be cropped with Transform -->
                    <Image x:Name="SourceImageDisplay"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="ImageTranslateTransform" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <!-- Dark Overlay Mask with Circular Cutout -->
                    <Path x:Name="CircularMaskPath" Fill="#B5000000" IsHitTestVisible="False"/>

                    <!-- Circular Border Outline & Glowing Ring -->
                    <Ellipse x:Name="AvatarCircleBorder"
                             Width="240" Height="240"
                             Stroke="{DynamicResource AccentBrush}"
                             StrokeThickness="2.5"
                             StrokeDashArray="1 0"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#3B82F6" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Subtle Helper Label -->
                    <Border Background="#90000000" CornerRadius="6" Padding="8,3"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,10" IsHitTestVisible="False">
                        <TextBlock Text="Drag image to position • Scroll to zoom"
                                   FontSize="10.5" Foreground="#CBD5E1"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Zoom Controls Slider -->
            <Grid Grid.Row="2" Margin="0,14,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="-" Width="28" Height="28"
                        Background="{StaticResource SecondaryButtonBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        FontWeight="Bold" FontSize="14"
                        Cursor="Hand"
                        Click="ZoomOutButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Slider Grid.Column="1" x:Name="ZoomSlider"
                        Margin="12,0"
                        Minimum="0.5" Maximum="4.0" Value="1.0"
                        VerticalAlignment="Center"
                        ValueChanged="ZoomSlider_ValueChanged"/>

                <Button Grid.Column="2" Content="+" Width="28" Height="28"
                        Background="{StaticResource SecondaryButtonBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        FontWeight="Bold" FontSize="14"
                        Cursor="Hand"
                        Click="ZoomInButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 4. Footer Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Choose Different Photo"
                        Style="{StaticResource CropperActionButtonStyle}"
                        Background="{StaticResource SecondaryButtonBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Click="ChooseDifferentPhotoButton_Click"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Cancel"
                            Style="{StaticResource CropperActionButtonStyle}"
                            Background="{StaticResource SecondaryButtonBrush}"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click"/>

                    <Button x:Name="ApplyButton"
                            Content="Apply"
                            MinWidth="115"
                            Style="{StaticResource CropperActionButtonStyle}"
                            Background="{DynamicResource AccentBrush}"
                            Click="ApplyButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

