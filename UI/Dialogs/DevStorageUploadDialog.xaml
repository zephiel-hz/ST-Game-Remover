<Window x:Class="SteamPluginManager.UI.Dialogs.DevStorageUploadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upload Storage Archive"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#131926"/>
        <SolidColorBrush x:Key="DialogCardBrush" Color="#1A2234"/>
        <SolidColorBrush x:Key="DialogBorderBrush" Color="#2A364E"/>
        <SolidColorBrush x:Key="DevPinkBrush" Color="#EC4899"/>
        <SolidColorBrush x:Key="DevPinkHoverBrush" Color="#DB2777"/>

        <!-- Modern Dialog Button Style -->
        <Style x:Key="DialogPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#EC4899"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DB2777"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E273A"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2F3E5A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28354E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dialog ComboBox Style -->
        <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0F141F"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid Background="Transparent">
                            <ToggleButton Name="DropDownToggle"
                                          Grid.Column="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Name="toggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Content="{TemplateBinding Content}"
                                                                  Margin="10,0,0,0"
                                                                  VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xE70D;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           Foreground="#94A3B8"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="9"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="toggleBorder" Property="BorderBrush" Value="{StaticResource DevPinkBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="toggleBorder" Property="BorderBrush" Value="{StaticResource DevPinkBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Name="contentPresenter"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            </ToggleButton>
                            <Popup Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   Margin="0,4,0,0">
                                <Border Background="#161E2E"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4">
                                    <ScrollViewer CanContentScroll="True"
                                                  MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                                                  MaxHeight="200">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#25324A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#831843"/>
                                <Setter Property="Foreground" Value="#F472B6"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource DialogBackgroundBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="14"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header with Title and Close Button -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#261022" BorderBrush="#EC4899" BorderThickness="1" Margin="0,0,12,0">
                    <TextBlock Text="☁️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Upload Cloud Storage Archive" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC"/>
                    <TextBlock Text="Upload GameBypass or OnlineFix archive directly to cloud bucket." FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Width="32" Height="32" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontSize="13" Click="CloseButton_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- 2. Target Storage Provider Selection -->
            <Border Grid.Row="1" Background="{StaticResource DialogCardBrush}" BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="TARGET CLOUD STORAGE" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="TargetGameBypassRadio" Grid.Column="0" IsChecked="True" Checked="TargetStorage_Changed" Cursor="Hand" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚀" FontSize="14" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="GameBypass" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Cloudflare R2 (gamebypass/)" FontSize="10.5" Foreground="#94A3B8"/>
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TargetOnlineFixRadio" Grid.Column="1" Checked="TargetStorage_Changed" Cursor="Hand" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📦" FontSize="14" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="OnlineFix" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Backblaze B2 (onlinefix/)" FontSize="10.5" Foreground="#94A3B8"/>
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <!-- Category Selector for GameBypass Subfolder -->
                    <Border x:Name="CategorySelectionPanel" Margin="0,12,0,0" Padding="12,10" Background="#111726" BorderBrush="#25324A" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="CATEGORY FOLDER" FontSize="10.5" FontWeight="Bold" Foreground="#EC4899"/>
                                <TextBlock Text="Subfolder on R2" FontSize="10" Foreground="#64748B" Margin="0,1,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="CategoryComboBox"
                                      Grid.Column="1"
                                      Style="{StaticResource DialogComboBoxStyle}"
                                      SelectionChanged="CategoryComboBox_SelectionChanged">
                                <ComboBoxItem Content="🛡️  DENUVO" Tag="DENUVO" IsSelected="True"/>
                                <ComboBoxItem Content="🌀  UBISOFT" Tag="UBISOFT"/>
                                <ComboBoxItem Content="🔴  EA" Tag="EA"/>
                                <ComboBoxItem Content="⭐️  ROCKSTAR" Tag="ROCKSTAR"/>
                                <ComboBoxItem Content="📦  OTHERS" Tag="OTHERS"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. Local File Selection -->
            <Border Grid.Row="2" Background="{StaticResource DialogCardBrush}" BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="LOCAL ARCHIVE FILE" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="LocalFilePathTextBox"
                                 Grid.Column="0"
                                 IsReadOnly="True"
                                 Height="36"
                                 Background="#0F141F"
                                 Foreground="#F8FAFC"
                                 BorderBrush="{StaticResource DialogBorderBrush}"
                                 BorderThickness="1"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="12"
                                 Text="Select a local archive file (.zip, .7z, .rar)..."/>

                        <Button Grid.Column="1"
                                Content="Browse File..."
                                Style="{StaticResource DialogSecondaryBtn}"
                                Height="36"
                                Margin="8,0,0,0"
                                Click="BrowseLocalFile_Click"/>
                    </Grid>

                    <StackPanel x:Name="LocalFileInfoPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                        <Border Background="#2010B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,10,0">
                            <TextBlock x:Name="LocalFileSizeBadge" Text="Size: 0 MB" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>
                        <TextBlock x:Name="LocalFileNameText" Text="archive.zip" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. Remote Key & Associated Game -->
            <Border Grid.Row="3" Background="{StaticResource DialogCardBrush}" BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="REMOTE OBJECT KEY (STORAGE PATH)" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <TextBox x:Name="RemoteKeyTextBox"
                             Height="36"
                             Background="#0F141F"
                             Foreground="#F8FAFC"
                             BorderBrush="{StaticResource DialogBorderBrush}"
                             BorderThickness="1"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             FontSize="12"
                             TextChanged="RemoteKeyTextBox_TextChanged"/>

                    <Border x:Name="MatchedGameCard" Background="#1B162B" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🎮" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="MatchedGameTitleText" Text="Detected Game: Title" FontWeight="Bold" FontSize="12" Foreground="#C084FC"/>
                                <TextBlock x:Name="MatchedGameAppIdText" Text="AppID: 0" FontSize="10.5" Foreground="#A78BFA"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5. Upload Progress Status Panel -->
            <Border x:Name="UploadProgressPanel" Grid.Row="4" Background="#131B2A" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock x:Name="UploadStatusLabel" Text="Uploading archive to cloud..." FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        <TextBlock x:Name="UploadPercentText" Text="0%" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                    </Grid>
                    <ProgressBar x:Name="UploadProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#0284C7" Background="#1E273A" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- 6. Bottom Action Buttons -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ErrorNoticeText" Text="" FontSize="11.5" Foreground="#F87171" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="1" Content="Cancel" Style="{StaticResource DialogSecondaryBtn}" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button Grid.Column="2" x:Name="UploadNowButton" Content="Start Upload" Style="{StaticResource DialogPrimaryBtn}" IsEnabled="False" Click="UploadNowButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
