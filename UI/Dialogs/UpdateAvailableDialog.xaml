<Window x:Class="SteamPluginManager.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available" 
        SizeToContent="Height" 
        Width="640" 
        MinHeight="280" 
        MaxHeight="720" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize" 
        WindowStyle="None" 
        Background="Transparent" 
        AllowsTransparency="True" 
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Window Close Button Style -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButton" BasedOn="{StaticResource WindowButton}" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{DynamicResource DangerButtonBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Dialog Button -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (Download & Install) -->
        <Style x:Key="PrimaryActionButton" BasedOn="{StaticResource DialogButton}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="16" 
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="12" Opacity="0.45"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Version Hero Card -->
                    <RowDefinition Height="*"/>    <!-- Changelog Container -->
                    <RowDefinition Height="Auto"/> <!-- Footer Actions -->
                </Grid.RowDefinitions>

                <!-- Top Window Controls Bar -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource HeaderBackgroundBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Update Icon Badge -->
                            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Update Available" 
                                       FontSize="13.5" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center"/>

                            <Border x:Name="HeaderVersionBadge"
                                    Background="{DynamicResource ButtonBackgroundBrush}" 
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="6,1" 
                                    Margin="10,0,0,0" 
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderVersionText" Text="Latest" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Window Controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="CloseBtn" 
                                    Style="{StaticResource CloseWindowButton}" 
                                    Click="CloseButton_Click"
                                    Content="✕" 
                                    ToolTip="Close"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Version Comparison Hero Card -->
                <Border Grid.Row="1" Margin="20,16,20,12" 
                        Background="{DynamicResource BackgroundBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Hero Title & Subtitle -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="New Version Ready to Install" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="A newer version of HZ Lua Manager is available with the latest updates and fixes." 
                                       FontSize="11.5" 
                                       Foreground="{DynamicResource MutedForegroundBrush}" 
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Version Comparison Pills -->
                        <Border Grid.Row="1" 
                                Background="{DynamicResource CardBackgroundBrush}" 
                                BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Installed Version -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="CURRENT VERSION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center"/>
                                    <Border Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="0,4,0,0">
                                        <TextBlock x:Name="CurrentVersionText" Text="v1.0.0" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Arrow Connector -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0">
                                    <TextBlock Text="➜" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Latest Version -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="LATEST RELEASE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                    <Border Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="LatestVersionText" Text="Latest" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                                                <TextBlock Text="NEW" FontSize="8.5" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Changelog Area -->
                <Grid Grid.Row="2" Margin="20,0,20,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Changelog Section Header -->
                    <Border Grid.Row="0" Margin="0,0,0,6">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Release Notes &amp; Changelog" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="GitHub Release" FontSize="10.5" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- GitHub Styled Markdown Changelog Box -->
                    <Border Grid.Row="1" 
                            Background="#0B0F19" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Padding="14,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="260" Padding="0,0,6,0">
                            <!-- Dynamic GitHub Markdown Content injected here -->
                            <ContentControl x:Name="ChangelogContentHost"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Footer Area -->
                <Border Grid.Row="3" 
                        Background="{DynamicResource HeaderBackgroundBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,1,0,0" 
                        Padding="20,14">
                    <Grid>
                        <!-- Question / Info -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Download and install update now?" FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="CancelButton" 
                                    Style="{StaticResource DialogButton}" 
                                    Click="CancelButton_Click" 
                                    Content="Remind Later"/>

                            <Button x:Name="DownloadButton" 
                                    Style="{StaticResource PrimaryActionButton}" 
                                    Click="DownloadButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Download &amp; Install" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
