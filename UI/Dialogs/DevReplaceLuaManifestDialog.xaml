<Window x:Class="SteamPluginManager.UI.Dialogs.DevReplaceLuaManifestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replace Lua &amp; Manifest Files"
        Width="660"
        MinHeight="620"
        MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#111622"/>
        <SolidColorBrush x:Key="DialogCardBrush" Color="#182030"/>
        <SolidColorBrush x:Key="DialogBorderBrush" Color="#253248"/>
        <SolidColorBrush x:Key="AccentPinkBrush" Color="#EC4899"/>
        <SolidColorBrush x:Key="AccentPinkHoverBrush" Color="#DB2777"/>
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#38BDF8"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Primary Action Button -->
        <Style x:Key="DialogPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#EC4899"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DB2777"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger/Execute Button -->
        <Style x:Key="DialogDangerExecuteBtn" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="DialogSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1C2537"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2D3B54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#27344D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Outer Window Border -->
    <Border Background="{StaticResource DialogBackgroundBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="20,18,20,18">
            <Grid.RowDefinitions>
                <!-- 0: Header -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Target AppID Card -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Source Type Selection -->
                <RowDefinition Height="Auto"/>
                <!-- 3: Staging Preview DataGrid -->
                <RowDefinition Height="*"/>
                <!-- 4: Warning Alert -->
                <RowDefinition Height="Auto"/>
                <!-- 5: Progress Bar (collapsible) -->
                <RowDefinition Height="Auto"/>
                <!-- 6: Action Footer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0: Header with Draggable Area -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9" Background="#261022" BorderBrush="{StaticResource AccentPinkBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="🔄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Replace Lua &amp; Manifest Files" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Clean-wipe cloud folder {appId}/ on Supabase Storage and upload new files" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Width="30" Height="30" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                    <TextBlock Text="✕" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 1: Target AppID Card -->
            <Border Grid.Row="1" Background="{StaticResource DialogCardBrush}" BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="TARGET APPID:" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <TextBox Grid.Column="1" x:Name="AppIdTextBox"
                                 Background="#0F141F"
                                 Foreground="#F8FAFC"
                                 BorderBrush="{StaticResource DialogBorderBrush}"
                                 BorderThickness="1"
                                 Padding="10,6"
                                 FontSize="12.5"
                                 FontWeight="Bold"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 TextChanged="AppIdTextBox_TextChanged"/>

                        <Button Grid.Column="2" x:Name="CheckCloudBtn" Content="Check Cloud" Style="{StaticResource DialogSecondaryBtn}" Height="34" Margin="8,0,0,0" Click="CheckCloudBtn_Click"/>
                    </Grid>

                    <!-- Game Match & Cloud Status Card -->
                    <Border x:Name="GameMatchBanner" Background="#0C1A2E" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="MatchedGameTitleText" Text="Grand Theft Auto V" FontWeight="Bold" FontSize="12" Foreground="#38BDF8"/>
                                <TextBlock x:Name="MatchedGameSubtitleText" Text="AppID: 271590 • Action / Adventure" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" x:Name="CloudStatusBadge" Background="#1E293B" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock x:Name="CloudStatusText" Text="Checking cloud..." FontSize="10.5" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2: Source Type Selection & File Picker -->
            <Border Grid.Row="2" Background="{StaticResource DialogCardBrush}" BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="REPLACEMENT SOURCE:" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>

                    <!-- Radio Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="SourceZipRadio" Content="📦 Zip Archive (.zip)" GroupName="ReplacementSource" IsChecked="True" Checked="SourceRadio_Checked" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,18,0"/>
                        <RadioButton x:Name="SourceFilesRadio" Content="📄 Direct Files / Folder" GroupName="ReplacementSource" Checked="SourceRadio_Checked" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    </StackPanel>

                    <!-- Panel for Zip Archive -->
                    <StackPanel x:Name="ZipSourcePanel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" x:Name="ZipPathTextBox"
                                     Background="#0F141F"
                                     Foreground="#F8FAFC"
                                     BorderBrush="{StaticResource DialogBorderBrush}"
                                     BorderThickness="1"
                                     Padding="10,6"
                                     FontSize="11.5"
                                     Height="34"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Text="Select a .zip archive containing .lua and .manifest files..."/>

                            <Button Grid.Column="1" x:Name="BrowseZipBtn" Content="Browse Zip..." Style="{StaticResource DialogPrimaryBtn}" Height="34" Margin="8,0,0,0" Click="BrowseZipBtn_Click"/>
                        </Grid>

                        <!-- Filter Options: Include Manifest vs Lua only -->
                        <Border Margin="0,10,0,0" Padding="12,8" Background="#0C1320" BorderBrush="#1E2A3E" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="ZIP UPLOAD OPTIONS:" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="ZipFilterAllRadio"
                                                 Content="Include .manifest (.lua + .manifest)"
                                                 GroupName="ZipFilterGroup"
                                                 IsChecked="True"
                                                 Checked="ZipFilterRadio_Checked"
                                                 Cursor="Hand"
                                                 FontSize="11.5"
                                                 FontWeight="SemiBold"
                                                 Foreground="#F8FAFC"
                                                 Margin="0,0,18,0"/>

                                    <RadioButton x:Name="ZipFilterLuaOnlyRadio"
                                                 Content="Lua only (.lua only)"
                                                 GroupName="ZipFilterGroup"
                                                 Checked="ZipFilterRadio_Checked"
                                                 Cursor="Hand"
                                                 FontSize="11.5"
                                                 FontWeight="SemiBold"
                                                 Foreground="#F8FAFC"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Panel for Direct Files / Folder -->
                    <Grid x:Name="DirectFilesSourcePanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" x:Name="DirectFilesCountLabel" Text="No direct files selected yet." FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>

                        <Button Grid.Column="1" x:Name="BrowseFilesBtn" Content="Browse Files..." Style="{StaticResource DialogSecondaryBtn}" Height="34" Margin="6,0,0,0" Click="BrowseFilesBtn_Click"/>
                        <Button Grid.Column="2" x:Name="BrowseFolderBtn" Content="Browse Folder..." Style="{StaticResource DialogPrimaryBtn}" Height="34" Margin="6,0,0,0" Click="BrowseFolderBtn_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3: Staging Preview DataGrid -->
            <Border Grid.Row="3" Background="{StaticResource DialogCardBrush}" BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,2,4,8">
                        <TextBlock Text="FILES STAGED FOR UPLOAD:" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StagedFilesCounterText" Text="(0 files)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentPinkBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="StagedFilesDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              CanUserResizeRows="False"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="170"
                              RowHeaderWidth="0">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#222B3D"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- File Icon + Name -->
                            <DataGridTemplateColumn Header="File Name" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11.5" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Type -->
                            <DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="120" FontSize="11" Foreground="#94A3B8" IsReadOnly="True"/>

                            <!-- Formatted Size -->
                            <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="90" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Margin="4,6,4,0" Padding="0,4,0,0">
                        <TextBlock x:Name="TotalStagedSizeText" Text="Total replacement payload: 0 B" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 4: Danger Warning Alert -->
            <Border Grid.Row="4" Background="#260D12" BorderBrush="#DC2626" BorderThickness="1.2" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="WARNING: PERMANENT CLOUD REPLACEMENT" FontWeight="Bold" FontSize="11" Foreground="#F87171"/>
                        <TextBlock x:Name="WarningDetailText" Text="Executing this will wipe all existing files in Supabase Storage folder '{appId}/' before uploading the staged replacement files." FontSize="10.5" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5: Progress Bar & Status (Collapsed by default) -->
            <Border Grid.Row="5" x:Name="ProgressPanel" Background="#0F141F" BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="ProgressStatusLabel" Text="Preparing replace..." FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ProgressPercentText" Text="0%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentPinkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar x:Name="ExecutionProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Background="#1E273A" Foreground="{StaticResource AccentPinkBrush}" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- 6: Action Footer -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="NoticeText" Text="" FontSize="11" Foreground="#F87171" VerticalAlignment="Center"/>

                <Button Grid.Column="1" x:Name="CancelButton" Content="Cancel" Style="{StaticResource DialogSecondaryBtn}" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button Grid.Column="2" x:Name="ExecuteReplaceButton" Content="EXECUTE REPLACE (DELETE &amp; UPLOAD)" Style="{StaticResource DialogDangerExecuteBtn}" IsEnabled="False" Click="ExecuteReplaceButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
