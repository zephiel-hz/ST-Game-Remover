<Window x:Class="SteamPluginManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" 
        Height="500" Width="750"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource ForegroundBrush}">
    
    <Window.Resources>
        <!-- Window Button Style -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="root" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseWindowButton" BasedOn="{StaticResource WindowButton}" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{DynamicResource DangerButtonBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="root" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Control Template matching MainWindow style -->
        <ControlTemplate x:Key="SettingsButtonTemplate" TargetType="Button">
            <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                    <Setter TargetName="root" Property="Opacity" Value="0.95"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="root" Property="Opacity" Value="0.6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Border Style for Settings Sections -->
        <Style x:Key="SettingsSectionBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
        </Style>

        <!-- TextBlock Style for Section Titles -->
        <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>

        <!-- TextBlock Style for Regular Text -->
        <Style x:Key="SettingsText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Background Card -->
        <Border Grid.RowSpan="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="0"/>
        <!-- Top Window Controls Bar -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Height="50" VerticalAlignment="Top" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <!-- Title -->
                <TextBlock Text="⚙️ Settings" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"/>
                
                <!-- Window Controls -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                    <Button x:Name="CloseBtn" 
                            Style="{StaticResource CloseWindowButton}" 
                            Click="CloseWindowButton_Click"
                            Content="✕" 
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Content Area -->
        <Border Grid.Row="1" Padding="20" Margin="0,8,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Performance Section -->
                    <Border Style="{StaticResource SettingsSectionBorder}">
                        <StackPanel>
                            <TextBlock Text="PERFORMANCE" Style="{StaticResource SettingsSectionTitle}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Hardware Acceleration" 
                                               Style="{StaticResource SettingsText}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="May improve performance but could increase GPU usage. Restart required." 
                                               Style="{StaticResource SettingsText}"
                                               Foreground="{DynamicResource BorderBrush}"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          x:Name="HardwareAccelerationCheckBox"
                                          VerticalAlignment="Center"
                                          Width="20"
                                          Height="20"
                                          Margin="20,0,0,0"
                                          Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Cache Section -->
                    <Border Style="{StaticResource SettingsSectionBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="CACHE" Style="{StaticResource SettingsSectionTitle}"/>
                                <TextBlock x:Name="CacheSizeText"
                                           Text="0 KB of Cache" 
                                           Style="{StaticResource SettingsText}"/>
                                <TextBlock Text="Only unused cache will be cleared. Active game data is preserved." 
                                           Style="{StaticResource SettingsText}"
                                           Foreground="{DynamicResource BorderBrush}"
                                           FontSize="11"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="CLEAR CACHE" 
                                    Width="140" 
                                    Height="36"
                                    Padding="8,6"
                                    Background="{DynamicResource PrimaryButtonBrush}"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    FontSize="11"
                                    Click="ClearCacheButton_Click"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    Margin="20,0,0,0"
                                    Template="{StaticResource SettingsButtonTemplate}"/>
                        </Grid>
                    </Border>

                    <!-- About Section -->
                    <Border Style="{StaticResource SettingsSectionBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="ABOUT" Style="{StaticResource SettingsSectionTitle}"/>
                                <TextBlock x:Name="VersionText"
                                           Text="Version 2.2.2"
                                           Style="{StaticResource SettingsText}"/>
                                <TextBlock x:Name="CreatedByText"
                                           Text="Created by: Zephiel" 
                                           Margin="0,4,0,0"
                                           Style="{StaticResource SettingsText}"/>
                            </StackPanel>

                                <!-- Update check removed - dashboard handles update checks -->
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
