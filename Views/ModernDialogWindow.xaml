<Window x:Class="SteamPluginManager.Views.ModernDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialog"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        MaxWidth="540"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#1E2638"/>
        <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#2E384D"/>

        <!-- Modern Dialog Button Base Style (Modeled from Request Modal) -->
        <Style x:Key="ModernDialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryDialogButton" TargetType="Button" BasedOn="{StaticResource ModernDialogButton}">
            <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SecondaryButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource ModernDialogButton}">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Danger / Destructive Action Button Style -->
        <Style x:Key="DangerDialogButton" TargetType="Button" BasedOn="{StaticResource ModernDialogButton}">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Close Icon Button Style -->
        <Style x:Key="DialogCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="6">
                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#22EF4444"/>
                                <Setter TargetName="btnBorder" Property="TextBlock.Foreground" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Body Message -->
                <RowDefinition Height="Auto"/> <!-- Footer / Action Buttons -->
            </Grid.RowDefinitions>

            <!-- Header with Icon Badge, Title and Close Button -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="15,15,0,0"
                    Padding="18,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Badge -->
                    <Border x:Name="IconBadgeBorder"
                            Grid.Column="0"
                            Width="34" Height="34"
                            CornerRadius="10"
                            Background="#226366F1"
                            BorderBrush="#446366F1"
                            BorderThickness="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="IconGlyphText"
                                   Text="&#xE897;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="#818CF8"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title Text -->
                    <TextBlock x:Name="TitleTextBlock"
                               Grid.Column="1"
                               Text="Confirm Delete"
                               FontSize="14.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Close Button -->
                    <Button Grid.Column="2"
                            Style="{StaticResource DialogCloseButton}"
                            Click="CloseButton_Click"
                            ToolTip="Close (Esc)"/>
                </Grid>
            </Border>

            <!-- Body Message -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="320"
                          Padding="20,16">
                <TextBlock x:Name="MessageTextBlock"
                           Text="Message details go here..."
                           FontSize="13.5"
                           LineHeight="21"
                           Foreground="{DynamicResource ForegroundBrush}"
                           TextWrapping="Wrap"/>
            </ScrollViewer>

            <!-- Footer / Action Buttons -->
            <Border Grid.Row="2"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,15,15"
                    Padding="20,16">
                <StackPanel x:Name="ButtonsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <!-- Cancel Button -->
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Style="{StaticResource SecondaryDialogButton}"
                            Margin="0,0,10,0"
                            Visibility="Collapsed"
                            Click="CancelButton_Click"/>

                    <!-- No Button -->
                    <Button x:Name="NoButton"
                            Content="No"
                            Style="{StaticResource SecondaryDialogButton}"
                            Margin="0,0,10,0"
                            Visibility="Collapsed"
                            Click="NoButton_Click"/>

                    <!-- Yes / OK / Primary Button -->
                    <Button x:Name="PrimaryButton"
                            Content="Yes"
                            Style="{StaticResource PrimaryDialogButton}"
                            Click="PrimaryButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
