<UserControl x:Class="SteamPluginManager.Views.ToolsPostDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SteamPluginManager.Models"
             Background="{DynamicResource CardBackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}"
             Loaded="ToolsPostDetailView_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
        <Style x:Key="AttachmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ButtonHoverBorderBrush}"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MarkdownLinkButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AttachmentButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Author}"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <TextBlock Text="  ·  "
                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                <TextBlock Text="{Binding CreatedAtText, Mode=OneWay}"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           FontSize="11"/>
            </StackPanel>

            <TextBlock Text="{Binding Title}"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>

            <ItemsControl ItemsSource="{Binding Tags}"
                          Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,3"
                                Margin="0,0,6,5">
                            <TextBlock Text="{Binding}"
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Margin="0,14,0,0"
                    Padding="0,14,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                    <TextBlock Tag="{Binding DisplayContent}"
                               Loaded="LinkedContentText_Loaded"
                               Foreground="{DynamicResource ForegroundBrush}"
                               TextWrapping="Wrap"
                               LineHeight="21"/>
                    <ItemsControl ItemsSource="{Binding Attachments}"
                                  Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}"
                                        Click="DownloadAttachment_Click"
                                        Style="{StaticResource AttachmentButtonStyle}"
                                        Margin="0,0,7,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FileName}"
                                                   MaxWidth="220"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="  ·  "
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <TextBlock Text="{Binding SizeText}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,20,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Replies"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ReplyCountText, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{DynamicResource MutedForegroundBrush}"/>
            </Grid>

            <TextBlock Text="{Binding RepliesStatus}"
                       Margin="0,0,0,9"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"/>

            <ItemsControl ItemsSource="{Binding Replies}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:DiscordForumReply}">
                        <Border Background="{DynamicResource ButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,10"
                                Margin="0,0,0,9">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Author}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="11"/>
                                    <TextBlock Text="  ·  "
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock Text="{Binding CreatedAtText, Mode=OneWay}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               FontSize="10"/>
                                </StackPanel>
                                <TextBlock Tag="{Binding DisplayContent}"
                                           Loaded="LinkedContentText_Loaded"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding Attachments}"
                                              Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding}"
                                                    Click="DownloadAttachment_Click"
                                                    Style="{StaticResource AttachmentButtonStyle}"
                                                    Padding="8,5"
                                                    Margin="0,0,6,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FileName}"
                                                               MaxWidth="190"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="  ·  "
                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                    <TextBlock Text="{Binding SizeText}"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Load earlier replies"
                    Click="LoadEarlierReplies_Click"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Foreground="{DynamicResource ForegroundBrush}"
                    Padding="10,6"
                    Cursor="Hand"
                    Visibility="{Binding HasMoreReplies, Converter={StaticResource BooleanToVisibility}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
