<UserControl x:Class="SteamPluginManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SteamPluginManager.Helpers"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style x:Key="PremiumManifestCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeeMoreButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecentSegmentRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="DashboardScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"
                  ScrollChanged="DashboardScrollViewer_ScrollChanged"
                  helpers:SmoothScrollViewerHelper.EnableSmoothScrolling="True">
        <Grid Margin="20,16,20,20" MaxWidth="1280">
            <StackPanel>
                <!-- Featured Most Downloaded Games Slider -->
                <Border x:Name="FeaturedSliderCard"
                        Height="340"
                        CornerRadius="12"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,24"
                        ClipToBounds="True"
                        Cursor="Hand"
                        SnapsToDevicePixels="True"
                        MouseEnter="FeaturedSlider_MouseEnter"
                        MouseLeave="FeaturedSlider_MouseLeave"
                        GotKeyboardFocus="FeaturedSlider_GotKeyboardFocus"
                        LostKeyboardFocus="FeaturedSlider_LostKeyboardFocus">
                    <Grid>
                        <Button x:Name="FeaturedSliderActionButton"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Focusable="True"
                                IsTabStop="True"
                                AutomationProperties.Name="View featured game manifest"
                                ToolTip="View Manifest &amp; Download"
                                Click="FeaturedSliderCard_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="FeaturedSliderFocusBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="12"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="FeaturedSliderFocusBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="FeaturedSliderFocusBorder" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="FeaturedSliderFocusBorder" Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Layer 1: Dual Image Elements for Smooth Cross-Fade (Matching GameLibraryDetailView) -->
                        <Image x:Name="SlideImageA"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Opacity="1.0"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="Linear"/>
                        <Image x:Name="SlideImageB"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Opacity="0.0"
                               IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="Linear"/>

                        <!-- The left fade keeps text readable over game artwork. -->
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#D90D111A" Offset="0.0"/>
                                    <GradientStop Color="#A60D111A" Offset="0.30"/>
                                    <GradientStop Color="#330D111A" Offset="0.60"/>
                                    <GradientStop Color="#00000000" Offset="0.85"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- A low fade anchors the pagination and keeps it visible over bright artwork. -->
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.0"/>
                                    <GradientStop Color="#00000000" Offset="0.45"/>
                                    <GradientStop Color="#400D111A" Offset="0.65"/>
                                    <GradientStop Color="#B30D111A" Offset="0.85"/>
                                    <GradientStop Color="#F00D111A" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Layer 3: Foreground Content (Game Title, Badges, Description, CTA) -->
                        <Grid Margin="72,24,36,24" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="680" HorizontalAlignment="Left">
                                <!-- Badges Row -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                    <!-- Top Downloaded Highlight Badge -->
                                    <Border Background="{DynamicResource SelectedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="TOP DOWNLOADED" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Downloads Count Badge -->
                                    <Border x:Name="SlideDownloadsBadge" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="SlideDownloadsText" Text="0 Downloads" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- AppID Badge -->
                                    <Border Background="#22FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6" Padding="8,5">
                                        <TextBlock x:Name="SlideAppIdText" Text="AppID: 0" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <!-- Game Title -->
                                <TextBlock x:Name="SlideGameTitle"
                                           Text="Game Title"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           TextWrapping="Wrap"
                                           MaxHeight="75"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8"/>

                                <!-- Description Snippet -->
                                <TextBlock x:Name="SlideGameDescription"
                                           Text="Game description preview goes here..."
                                           FontSize="12.5"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="38"
                                           LineHeight="19"
                                           Margin="0,0,0,18"/>

                                <!-- Action CTA Button -->
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="18,10" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="View Manifest &amp; Download" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BackgroundBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource BackgroundBrush}" Margin="8,1,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Navigation Arrows (Left / Right) - Visible on Carousel Hover -->
                        <Button x:Name="SliderPrevButton"
                                Width="40" Height="40"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                Cursor="Hand"
                                Opacity="0"
                                IsHitTestVisible="False"
                                IsEnabled="False"
                                Click="SliderPrevButton_Click"
                                AutomationProperties.Name="Previous featured game"
                                ToolTip="Previous Game">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="arrowBorder" Background="#7A0A0E17" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="20">
                                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                             <Setter TargetName="arrowBorder" Property="Background" Value="#CC0A0E17"/>
                                             <Setter TargetName="arrowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                         </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="arrowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="arrowBorder" Property="Background" Value="#CC0A0E17"/>
                                        </Trigger>
                                     </ControlTemplate.Triggers>
                                 </ControlTemplate>
                             </Button.Template>
                         </Button>

                        <Button x:Name="SliderNextButton"
                                Width="40" Height="40"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0"
                                Cursor="Hand"
                                Opacity="0"
                                IsHitTestVisible="False"
                                IsEnabled="False"
                                Click="SliderNextButton_Click"
                                AutomationProperties.Name="Next featured game"
                                ToolTip="Next Game">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="arrowBorder" Background="#7A0A0E17" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="20">
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="arrowBorder" Property="Background" Value="#CC0A0E17"/>
                                            <Setter TargetName="arrowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="arrowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="arrowBorder" Property="Background" Value="#CC0A0E17"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="SliderAutoAdvanceButton"
                                Width="36" Height="36"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,14,16,0"
                                Cursor="Hand"
                                Opacity="0"
                                IsHitTestVisible="False"
                                IsEnabled="False"
                                Click="SliderAutoAdvanceButton_Click"
                                AutomationProperties.Name="Pause carousel"
                                ToolTip="Pause carousel"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="13"
                                Foreground="White"
                                Content="&#xE769;">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="autoAdvanceBorder" Background="#7A0A0E17" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="18">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="autoAdvanceBorder" Property="Background" Value="#CC0A0E17"/>
                                            <Setter TargetName="autoAdvanceBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="autoAdvanceBorder" Property="Background" Value="#CC0A0E17"/>
                                            <Setter TargetName="autoAdvanceBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Pagination Dots Bar at Bottom Center -->
                        <StackPanel x:Name="SliderDotsPanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,14"/>

                        <!-- Loading State Shimmer / Placeholder -->
                        <Border x:Name="SliderLoadingOverlay" Background="#0D111A" Visibility="Collapsed" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="28" HorizontalAlignment="Center" Opacity="0.3" Margin="0,0,0,8"/>
                                <TextBlock Text="Loading featured games..." FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Recently Updated Section (Manifest, Bypass, OnlineFix) -->
                <Border Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Recently Updated" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Segmented Tab Navigation -->
                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TabManifestRadio"
                                                 Content="Manifest"
                                                 GroupName="RecentTabs"
                                                 IsChecked="True"
                                                 Checked="RecentTab_Checked"
                                                 Style="{StaticResource RecentSegmentRadioButtonStyle}"/>
                                    <RadioButton x:Name="TabBypassRadio"
                                                 Content="Bypass"
                                                 GroupName="RecentTabs"
                                                 Checked="RecentTab_Checked"
                                                 Style="{StaticResource RecentSegmentRadioButtonStyle}"/>
                                    <RadioButton x:Name="TabOnlineFixRadio"
                                                 Content="OnlineFix"
                                                 GroupName="RecentTabs"
                                                 Checked="RecentTab_Checked"
                                                 Style="{StaticResource RecentSegmentRadioButtonStyle}"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="SeeMoreRecentButton"
                                    Style="{StaticResource SeeMoreButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="SeeMoreRecent_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="SeeMoreRecentText" Text="See more" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="6,1,0,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <UniformGrid x:Name="RecentCardsPanel"
                                     Rows="2"
                                     HorizontalAlignment="Stretch"
                                     Margin="0,4,0,0"
                                     SnapsToDevicePixels="True"/>
                        
                        <TextBlock x:Name="RecentPlaceholder" 
                                   Text="Loading recently updated..." 
                                   Foreground="{DynamicResource MutedForegroundBrush}" 
                                   FontSize="13"
                                   Margin="0,20,0,10" 
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
