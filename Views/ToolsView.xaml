<UserControl x:Class="SteamPluginManager.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SteamPluginManager.Helpers"
             xmlns:models="clr-namespace:SteamPluginManager.Models"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}"
             Loaded="ToolsView_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>

        <Style x:Key="ToolSearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="36,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="SearchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SearchBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ButtonHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SearchBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolQuietButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ForumPostCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ForumPostExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <DockPanel LastChildFill="True">
                            <ToggleButton DockPanel.Dock="Top"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="0"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8">
                                            <ContentPresenter ContentSource="Content"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              ContentSource="Content"
                                              Visibility="Collapsed"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      Padding="0,0,6,0"
                      helpers:SmoothScrollViewerHelper.EnableSmoothScrolling="True">
            <Grid Margin="24,20,24,24"
                  MaxWidth="1280"
                  HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="SearchTextBox"
                                     Style="{StaticResource ToolSearchBoxStyle}"
                                     ToolTip="Search posts, authors, tags, or attachments"
                                     TextChanged="SearchTextBox_TextChanged"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="13,0,0,0"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Search forum posts, authors, or tags..."
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedForegroundBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="14,0,2,0">
                            <Border Width="1"
                                    Height="22"
                                    Background="{DynamicResource BorderBrush}"
                                    Margin="0,0,12,0"/>
                            <TextBlock x:Name="StatusText"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                x:Name="RefreshButton"
                                Click="RefreshButton_Click"
                                Style="{StaticResource ToolIconButtonStyle}"
                                Margin="10,0,0,0"
                                ToolTip="Refresh forum posts">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ItemsControl x:Name="PostsItemsControl"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:DiscordForumPost}">
                                <Border Style="{StaticResource ForumPostCardStyle}"
                                        HorizontalAlignment="Stretch"
                                        PreviewMouseLeftButtonDown="PostCard_PreviewMouseLeftButtonDown">
                                    <Expander Style="{StaticResource ForumPostExpanderStyle}"
                                              IsHitTestVisible="False"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxHeight="38"
                                                               FontSize="12">
                                                        <Run Text="{Binding Author, Mode=OneWay}"
                                                             Foreground="{DynamicResource AccentBrush}"/>
                                                        <Run Text="  "/>
                                                        <Run Text="{Binding DisplayContent, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource ButtonBackgroundBrush}"
                                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6"
                                                                        Padding="8,3"
                                                                        Margin="0,0,6,4">
                                                                    <TextBlock Text="{Binding}"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right"
                                                            MinWidth="118">
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock Text="&#xE8BD;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding ReplyCountText, Mode=OneWay}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CreatedAtText, Mode=OneWay}"
                                                               Margin="0,5,0,0"
                                                               HorizontalAlignment="Right"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="&#xE72A;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            </Grid>
                                        </Expander.Header>

                                        <Grid Margin="0,16,20,4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    Padding="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayContent}"
                                                               Foreground="{DynamicResource ForegroundBrush}"
                                                               TextWrapping="Wrap"
                                                               LineHeight="20"/>
                                                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,10,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Tag="{Binding}"
                                                                        Click="DownloadAttachment_Click"
                                                                        Style="{StaticResource ToolQuietButtonStyle}"
                                                                        Margin="0,0,8,7">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE896;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                                   Margin="0,0,7,0"/>
                                                                        <TextBlock Text="{Binding FileName}"
                                                                                   MaxWidth="280"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="  ·  "
                                                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                        <TextBlock Text="{Binding SizeText}"
                                                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <Grid Grid.Row="1" Margin="0,16,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Replies"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ReplyCountText, Mode=OneWay}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            </Grid>

                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="{Binding RepliesStatus}"
                                                           Margin="0,0,0,8"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           FontSize="11"/>
                                                <ItemsControl ItemsSource="{Binding Replies}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:DiscordForumReply}">
                                                            <Grid Margin="0,0,0,9">
                                                                <Border Background="{DynamicResource ButtonBackgroundBrush}"
                                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="10"
                                                                        Padding="12,9">
                                                                    <StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Author}"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                                       FontSize="11"/>
                                                                            <TextBlock Text="  ·  "
                                                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                            <TextBlock Text="{Binding CreatedAtText, Mode=OneWay}"
                                                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                                                       FontSize="10"/>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding DisplayContent}"
                                                                                   Margin="0,4,0,0"
                                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                                   TextWrapping="Wrap"/>
                                                                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel/>
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Button Tag="{Binding}"
                                                                                            Click="DownloadAttachment_Click"
                                                                                            Style="{StaticResource ToolQuietButtonStyle}"
                                                                                            Padding="8,5"
                                                                                            Margin="0,0,7,5">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <TextBlock Text="{Binding FileName}"
                                                                                                       MaxWidth="240"
                                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                                            <TextBlock Text="  ·  "
                                                                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                                            <TextBlock Text="{Binding SizeText}"
                                                                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="Load earlier replies"
                                                        Style="{StaticResource ToolQuietButtonStyle}"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,3,0,0"
                                                        Visibility="{Binding HasMoreReplies, Converter={StaticResource BooleanToVisibility}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyStateText"
                               Text="No forum posts found."
                               Visibility="Collapsed"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               FontSize="13"/>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Grid x:Name="LoadingOverlay"
              Panel.ZIndex="100"
              Background="#66000000"
              Visibility="Collapsed">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="32,24"
                    MinWidth="260"
                    MaxWidth="360">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="32"
                                      ShadowDepth="12"
                                      Opacity="0.45"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Grid Width="56"
                          Height="56"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,16">
                        <Ellipse Width="56"
                                 Height="56"
                                 Stroke="{DynamicResource BorderBrush}"
                                 StrokeThickness="3.5"
                                 Opacity="0.4"/>
                        <Canvas Width="56"
                                Height="56"
                                RenderTransformOrigin="0.5,0.5">
                            <Canvas.RenderTransform>
                                <RotateTransform x:Name="ContinuousRotate" Angle="0"/>
                            </Canvas.RenderTransform>
                            <Ellipse Width="56"
                                     Height="56"
                                     Stroke="{DynamicResource AccentBrush}"
                                     StrokeThickness="3.5"
                                     StrokeDashArray="42 100"
                                     StrokeStartLineCap="Round"
                                     StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Grid>
                    <TextBlock x:Name="LoadingStatusText"
                               Text="Loading posts..."
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="13.5"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="Fetching posts and preparing discussions..."
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               FontSize="11"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
