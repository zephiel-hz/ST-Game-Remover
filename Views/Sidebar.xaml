<UserControl x:Class="SteamPluginManager.Views.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}"
             Width="74">
    <UserControl.Resources>
        <!-- Modern Sleek Rail Button Style -->
        <Style x:Key="RailNavButton" TargetType="Button">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" 
                                Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Saweria Support Button Style with Glowing Rose Hover Effect -->
        <Style x:Key="SaweriaButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" 
                                Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22F43F5E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#80F43F5E"/>
                                <Setter Property="Foreground" Value="#F43F5E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#35F43F5E"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UnlockerSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="Track"
                                    CornerRadius="10"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"/>
                            <Border x:Name="Thumb"
                                    Width="14"
                                    Height="14"
                                    CornerRadius="7"
                                    Background="{DynamicResource MutedForegroundBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="2,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTranslateTransform" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="Background" Value="White"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Background="{DynamicResource HeaderBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>    <!-- Navigation Rail Items -->
                <RowDefinition Height="Auto"/> <!-- Bottom Actions & Support -->
            </Grid.RowDefinitions>

            <!-- Main Navigation Rail -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,0,4">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Home / Hub -->
                    <Button x:Name="DashboardButton" Style="{StaticResource RailNavButton}" Click="Dashboard_Click" ToolTip="Home / Dashboard">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Home" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Manifests -->
                    <Button x:Name="HZManifestButton" Style="{StaticResource RailNavButton}" Click="HZManifest_Click" ToolTip="HZ Manifest Catalog">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Manifest" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Game Bypass -->
                    <Button x:Name="GameBypassButton" Style="{StaticResource RailNavButton}" Click="GameBypass_Click" ToolTip="Game Bypass Patches">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Bypass" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Online Fix -->
                    <Button x:Name="OnlineFixButton" Style="{StaticResource RailNavButton}" Click="OnlineFix_Click" ToolTip="Online Fix Multiplayer">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="OnlineFix" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Game Library -->
                    <Button x:Name="LibraryButton" Style="{StaticResource RailNavButton}" Click="Library_Click" ToolTip="Installed Game Library">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Library" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Subtle Separator -->
                    <Rectangle Width="36" Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,8"/>

                    <!-- Settings Button -->
                    <Button x:Name="SettingsButton" Style="{StaticResource RailNavButton}" Click="Settings_Click" ToolTip="Preferences &amp; Settings">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Settings" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Dev Button (Admin only) -->
                    <Button x:Name="DevButton" Style="{StaticResource RailNavButton}" Click="Dev_Click" ToolTip="Developer &amp; Admin Console" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#EC4899" HorizontalAlignment="Center"/>
                            <TextBlock Text="Dev" FontSize="9" FontWeight="SemiBold" Foreground="#EC4899" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Actions & Saweria -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                <!-- Saweria Heart Support Button -->
                <Button x:Name="SaweriaButton"
                        Style="{StaticResource SaweriaButtonStyle}"
                        Margin="0,0,0,6"
                        Click="Saweria_Click"
                        ToolTip="Donate &amp; Support via Saweria">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xEB52;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#F43F5E" HorizontalAlignment="Center"/>
                        <TextBlock Text="Saweria" FontSize="8.5" FontWeight="Bold" Foreground="#F43F5E" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Hidden/Preserved Controls for Code-behind Compatibility -->
                <StackPanel Visibility="Collapsed">
                    <Border x:Name="SaweriaCard"/>
                    <Button x:Name="RestartSteamButton" Click="RestartSteam_Click"/>
                    <Button x:Name="CheckUpdatesButton" Click="CheckUpdates_Click"/>
                    <Button x:Name="AboutButton" Click="About_Click"/>
                    <CheckBox x:Name="UnlockerToggle" Checked="UnlockerToggle_Checked" Unchecked="UnlockerToggle_Checked"/>
                    <TextBlock x:Name="ProfileNameText" Text="User" MouseLeftButtonDown="ProfileNameText_MouseLeftButtonDown"/>
                    <TextBlock x:Name="ProfileStatusText" Text="Online"/>
                    <Expander x:Name="MainMenuExpander" Expanded="Expander_Expanded"/>
                    <Expander x:Name="ToolsExpander" Expanded="Expander_Expanded"/>
                    <Expander x:Name="SettingsExpander" Expanded="Expander_Expanded"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
