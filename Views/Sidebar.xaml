<UserControl x:Class="SteamPluginManager.Views.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}"
             Width="260">
    <UserControl.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="8" Opacity="0.18"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarMenuButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="UnlockerSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track"
                                    CornerRadius="13"
                                    Background="{DynamicResource MutedForegroundBrush}"
                                    Opacity="0.35"/>
                            <Border x:Name="Thumb"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="3,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTranslateTransform" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslateTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="20"
                                                             Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Track"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslateTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0"
                                                             Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Track"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.35"
                                                             Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarExpanderHeaderButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="0 10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarImageButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          Style="{StaticResource SidebarExpanderHeaderButton}"
                                          FontSize="13"
                                          FontWeight="Bold"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{TemplateBinding Header}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="Arrow" Grid.Column="1" Text="▾" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </ToggleButton>
                            <Border x:Name="ContentContainer" Background="Transparent" ClipToBounds="True" Visibility="Collapsed" Opacity="0" Margin="0,8,0,0">
                                <ContentPresenter x:Name="ExpandSite" ContentSource="Content" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Stretch" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ContentContainer" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentContainer" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ContentContainer" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ContentContainer" Property="Opacity" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderSite" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="0,0,24,0" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="14" Grid.Row="0">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="WELCOME BACK" Style="{StaticResource SidebarSectionTitle}"/>
                    <TextBlock x:Name="ProfileNameText"
                               Text="-"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               TextWrapping="Wrap"
                               Cursor="Hand"
                               Margin="0,8,0,0"
                               ToolTip="Click to edit profile"
                               MouseLeftButtonDown="ProfileNameText_MouseLeftButtonDown"/>
                    <TextBlock x:Name="ProfileStatusText" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,14" Padding="12,10" CornerRadius="14" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="Unlocker" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="UnlockerToggle"
                                  Style="{StaticResource UnlockerSwitchStyle}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Checked="UnlockerToggle_Checked"
                                  Unchecked="UnlockerToggle_Checked"/>
                </Grid>
            </Border>

            <Expander x:Name="MainMenuExpander" Header="Main Menu" Style="{StaticResource SidebarExpander}" IsExpanded="True" Expanded="Expander_Expanded">
                <StackPanel Margin="0,10,0,0">
                    <Button x:Name="DashboardButton" Style="{StaticResource SidebarMenuButton}" Click="Dashboard_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LibraryButton" Style="{StaticResource SidebarMenuButton}" Click="Library_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="Library"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HZManifestButton" Style="{StaticResource SidebarMenuButton}" Click="HZManifest_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="HZ Manifest"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Expander>

            <Expander x:Name="ToolsExpander" Header="Tools" Style="{StaticResource SidebarExpander}" IsExpanded="False" Expanded="Expander_Expanded">
                <StackPanel Margin="0,10,0,0">
                    <Button x:Name="GameBypassButton" Style="{StaticResource SidebarMenuButton}" Click="GameBypass_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="Game Bypass"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OnlineFixButton" Style="{StaticResource SidebarMenuButton}" Click="OnlineFix_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="Online Fix"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RestartSteamButton" Style="{StaticResource SidebarMenuButton}" Click="RestartSteam_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="Restart Steam"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Expander>

            <Expander x:Name="SettingsExpander" Header="Settings" Style="{StaticResource SidebarExpander}" IsExpanded="False" Expanded="Expander_Expanded">
                <StackPanel Margin="0,10,0,0">
                    <Button x:Name="SettingsButton" Style="{StaticResource SidebarMenuButton}" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CheckUpdatesButton" Style="{StaticResource SidebarMenuButton}" Click="CheckUpdates_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="Check Updates"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AboutButton" Style="{StaticResource SidebarMenuButton}" Click="About_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0"/>
                            <TextBlock Text="About"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Expander>

            <Button x:Name="SaweriaButton" Style="{StaticResource SidebarImageButton}" Click="Saweria_Click" Margin="0,8,0,0">
                <Border x:Name="SaweriaCard" CornerRadius="18" Padding="16" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="17" Background="Transparent" Margin="0,0,10,0" ClipToBounds="True">
                            <Image Source="/Config/saweria-icon.png" Width="34" Height="34" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Support the creator" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="Keep the app growing" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
        </StackPanel>

            <TextBlock Grid.Row="1"
                       Margin="16,0,16,12"
                       Text="zorty © 2026"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       FontSize="11"
                       Opacity="0.8"/>
        </Grid>
    </Border>
</UserControl>
