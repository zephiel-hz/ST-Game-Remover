<UserControl x:Class="SteamPluginManager.Views.RequestGameModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="540">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#1E2638"/>

        <Style x:Key="RequestModalButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RequestModalTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Width="520"
            MaxWidth="540"
            Padding="24,20"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="12" Opacity="0.3"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header Icon & Title -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                        Background="{DynamicResource ButtonBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Request Game" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="Enter a Steam AppID, Steam Store, or SteamDB URL to request a game."
                               FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- URL / AppID Input -->
            <TextBlock Text="Steam Store / SteamDB URL or AppID" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8"/>
            <Grid>
                <TextBox x:Name="RequestUrlTextBox" Style="{StaticResource RequestModalTextBoxStyle}"/>
                <TextBlock Text="e.g. 730310 or https://store.steampowered.com/app/..."
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           FontSize="12"
                           Margin="14,0,14,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=RequestUrlTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=RequestUrlTextBox}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Validation Message Text -->
            <TextBlock x:Name="RequestValidationText" Text=""
                       Foreground="{DynamicResource DangerButtonBrush}"
                       FontSize="11.5" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

            <!-- Collapsible Request Flow Guide Card -->
            <Border x:Name="RequestFlowGuideCard"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,10,0,0">
                <StackPanel>
                    <!-- Header / Toggle Button -->
                    <Button x:Name="ToggleRequestGuideButton"
                            Click="ToggleRequestGuideButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,9"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Automated Request Workflow Guide" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="GuideToggleChevron" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Collapsible Guide Details -->
                    <Border x:Name="RequestFlowGuideContent"
                            Visibility="Collapsed"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="14,12"
                            Background="{DynamicResource InputBackgroundBrush}"
                            CornerRadius="0,0,10,10">
                        <StackPanel>
                            <!-- Step 1 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <TextBlock Text="1" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Steam Store &amp; SteamDB Validation" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="Verifies official AppID authenticity and fetches game metadata and artwork." FontSize="10.5" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Step 2 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <TextBlock Text="2" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Hubcap Session &amp; Denuvo DRM Detection" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="Authenticates Hubcap session early and detects live Denuvo DRM status via Hubcap curator and Steam Store." FontSize="10.5" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Step 3 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <TextBlock Text="3" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Repository Search (ManifestHub &amp; Hubcap)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="Automatically downloads .lua (Non-Denuvo) or .lua + .manifest (Denuvo) from ManifestHub and Hubcap archives." FontSize="10.5" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Step 4 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <TextBlock Text="4" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Deploy Manifest &amp; Lua to Catalog" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="Uploads .lua and .manifest to cloud catalog. If unavailable, submits request ticket to Discord Admin." FontSize="10.5" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Step 5 -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <TextBlock Text="5" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Online-Fix Automated Processing" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="Searches Online-Fix, decrypts archive with password, repacks to {appId}.zip, and uploads to Cloudflare R2." FontSize="10.5" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Modern Dedicated Progress Card with Live Stage Stepper -->
            <Border x:Name="RequestProgressContainer"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,10,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <!-- Live 5-Stage Stepper Tracker -->
                    <Grid Margin="0,2,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Stage 1: Steam -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Border x:Name="Stage1Circle" Width="26" Height="26" CornerRadius="13"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1.5" HorizontalAlignment="Center">
                                <TextBlock x:Name="Stage1Icon" Text="1" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="Stage1Label" Text="Steam" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Connector 1-2 -->
                        <Border Grid.Column="1" x:Name="StageConn1" Height="2" Width="22"
                                Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Center" Margin="0,0,0,16"/>

                        <!-- Stage 2: Hubcap & DRM -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Border x:Name="Stage2Circle" Width="26" Height="26" CornerRadius="13"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1.5" HorizontalAlignment="Center">
                                <TextBlock x:Name="Stage2Icon" Text="2" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="Stage2Label" Text="DRM" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Connector 2-3 -->
                        <Border Grid.Column="3" x:Name="StageConn2" Height="2" Width="22"
                                Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Center" Margin="0,0,0,16"/>

                        <!-- Stage 3: Repositories -->
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <Border x:Name="Stage3Circle" Width="26" Height="26" CornerRadius="13"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1.5" HorizontalAlignment="Center">
                                <TextBlock x:Name="Stage3Icon" Text="3" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="Stage3Label" Text="Repo" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Connector 3-4 -->
                        <Border Grid.Column="5" x:Name="StageConn3" Height="2" Width="22"
                                Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Center" Margin="0,0,0,16"/>

                        <!-- Stage 4: Deploy Manifest -->
                        <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                            <Border x:Name="Stage4Circle" Width="26" Height="26" CornerRadius="13"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1.5" HorizontalAlignment="Center">
                                <TextBlock x:Name="Stage4Icon" Text="4" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="Stage4Label" Text="Manifest" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Connector 4-5 -->
                        <Border Grid.Column="7" x:Name="StageConn4" Height="2" Width="22"
                                Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Center" Margin="0,0,0,16"/>

                        <!-- Stage 5: Online-Fix -->
                        <StackPanel Grid.Column="8" HorizontalAlignment="Center">
                            <Border x:Name="Stage5Circle" Width="26" Height="26" CornerRadius="13"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1.5" HorizontalAlignment="Center">
                                <TextBlock x:Name="Stage5Icon" Text="5" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="Stage5Label" Text="Online-Fix" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Sub-step Detail & Status -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RequestProgressSpinner"
                                   Text="⏳"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="RequestProgressRotate" Angle="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Grid.Column="1"
                                   x:Name="RequestProgressText"
                                   Text="Searching ManifestHub..."
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Grid>
                    <ProgressBar x:Name="RequestProgressBar"
                                 IsIndeterminate="True"
                                 Height="3"
                                 Margin="0,8,0,0"
                                 BorderThickness="0"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>

            <!-- Bottom Actions -->
            <Grid Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Your request will be queued and reviewed by the team."
                           FontSize="11"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelRequestButton" Width="105" Height="38" Content="Cancel"
                            Click="CancelRequestButton_Click"
                            Background="{StaticResource SecondaryButtonBrush}"
                            Foreground="White"
                            Style="{StaticResource RequestModalButtonStyle}" Margin="0,0,8,0"/>
                    <Button x:Name="SubmitRequestButton" Width="110" Height="38" Content="Submit"
                            Click="SubmitRequestButton_Click"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            Style="{StaticResource RequestModalButtonStyle}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
