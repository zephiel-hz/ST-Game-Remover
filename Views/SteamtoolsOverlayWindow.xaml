<Window x:Class="SteamPluginManager.Views.SteamtoolsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Processing" SizeToContent="WidthAndHeight" MinWidth="520" MinHeight="300" MaxWidth="900" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False" Topmost="True">
    <Window.Resources>
        <!-- Rotation Animation for Loading Icon -->
        <Storyboard x:Key="RotateStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.5" />
        </Storyboard>

        <!-- Window Button Style -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="root" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseWindowButton" BasedOn="{StaticResource WindowButton}" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{DynamicResource DangerButtonBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="root" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Background Card -->
        <Border Grid.RowSpan="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="0"/>

        <!-- Top Window Controls Bar -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Height="50" VerticalAlignment="Top" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <!-- Title -->
                <TextBlock x:Name="SteamtoolsOverlayText" Text="Processing..." 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"/>
                
                <!-- Window Controls -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                    <Button x:Name="CloseBtn" 
                            Style="{StaticResource CloseWindowButton}" 
                            Click="CloseButton_Click"
                            Content="✕" 
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Content Area -->
        <Border Grid.Row="1" Padding="20" Margin="0,8,0,0">
            <StackPanel>
                <!-- Status Text -->
                <TextBlock x:Name="SteamtoolsOverlayStatus" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,16" TextWrapping="Wrap" Text="Initializing..."/>

                <!-- Progress Bar -->
                <ProgressBar x:Name="SteamtoolsOverlayProgress" Height="6" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource SuccessButtonBrush}" Margin="0,0,0,12" IsIndeterminate="True"/>

                <!-- Step Indicator -->
                <StackPanel x:Name="SteamtoolsStepsPanel" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="SteamtoolsStep1Icon" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="&#xE7BA;" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="SteamtoolsStep1Text" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Text="Stopping Steam..."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="SteamtoolsStep2Icon" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="&#xE7BA;" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="SteamtoolsStep2Text" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Text="Removing modifications..."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="SteamtoolsStep3Icon" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="&#xE7BA;" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="SteamtoolsStep3Text" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Text="Cleaning registry..."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SteamtoolsStep4Icon" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="&#xE7BA;" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="SteamtoolsStep4Text" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Text="Restarting Steam..."/>
                    </StackPanel>
                </StackPanel>

                <!-- Result Notification (Hidden by default) -->
                <Border x:Name="SteamtoolsResultNotification" Visibility="Collapsed" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16" Margin="0,16,0,0" BorderBrush="{DynamicResource SuccessButtonBrush}" BorderThickness="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SteamtoolsResultIcon" FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE73E;" Foreground="{DynamicResource SuccessButtonBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="SteamtoolsResultMessage" FontSize="12" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
