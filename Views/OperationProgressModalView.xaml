<UserControl x:Class="SteamPluginManager.Views.OperationProgressModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="500">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#1E2638"/>

        <!-- Action Button Style -->
        <Style x:Key="ModalActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ProgressBar Style -->
        <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessButtonBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderThickness="0"/>
                            <Border x:Name="PART_Track" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" CornerRadius="4" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Width="490"
            MaxWidth="520"
            Padding="24,22"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="12" Opacity="0.45"/>
        </Border.Effect>

        <StackPanel>
            <!-- Top Header & Game Info -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                        Background="{DynamicResource ButtonBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderIcon" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title & Context Pill -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressTitle" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Text="Operation in Progress..."/>

                    <!-- Game Information Pill (Appears when Game Name / AppID is known) -->
                    <Border x:Name="GameInfoPill"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,3"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GameTitleText" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       MaxWidth="240" TextTrimming="CharacterEllipsis"
                                       Text="Game Title" VerticalAlignment="Center"/>
                            <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="GameAppIdText" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="AppID: 0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Optional Dismiss Button -->
                <Button Grid.Column="2" x:Name="DismissButton" Width="28" Height="28"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="DismissButton_Click" VerticalAlignment="Top"
                        Visibility="Collapsed" ToolTip="Close Modal">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="dismissBd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="dismissBd" Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 4-Step Pipeline Stepper -->
            <Border x:Name="StepsBorder"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,14"
                    Margin="0,0,0,16">
                <!-- Keep StepsPanel for backward compatibility -->
                <StackPanel x:Name="StepsPanel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Step 1 Node -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Width="85">
                            <Border x:Name="Step1Circle" Width="30" Height="30" CornerRadius="15"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="Step1Icon" Text="1" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="Step1Text" Text="Verify" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextAlignment="Center" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Connector 1 -->
                        <Border Grid.Column="1" x:Name="StepConn1" Height="2"
                                Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Center" Margin="2,0,2,16"/>

                        <!-- Step 2 Node -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Width="85">
                            <Border x:Name="Step2Circle" Width="30" Height="30" CornerRadius="15"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="Step2Icon" Text="2" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="Step2Text" Text="Download" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextAlignment="Center" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Connector 2 -->
                        <Border Grid.Column="3" x:Name="StepConn2" Height="2"
                                Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Center" Margin="2,0,2,16"/>

                        <!-- Step 3 Node -->
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center" Width="85">
                            <Border x:Name="Step3Circle" Width="30" Height="30" CornerRadius="15"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="Step3Icon" Text="3" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="Step3Text" Text="Extract" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextAlignment="Center" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Connector 3 -->
                        <Border Grid.Column="5" x:Name="StepConn3" Height="2"
                                Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Center" Margin="2,0,2,16"/>

                        <!-- Step 4 Node -->
                        <StackPanel Grid.Column="6" HorizontalAlignment="Center" Width="85">
                            <Border x:Name="Step4Circle" Width="30" Height="30" CornerRadius="15"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="Step4Icon" Text="4" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="Step4Text" Text="Apply" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextAlignment="Center" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Active Progress Card (Status, Percentage, Detailed Info, Progress Bar) -->
            <Border x:Name="ProgressCard"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    Margin="0,0,0,6">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status & Detailed Substatus -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="ProgressStatus" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Text="Initializing..."/>
                            <TextBlock x:Name="ProgressDetail" FontSize="11"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"
                                       Visibility="Collapsed" Text=""/>
                        </StackPanel>

                        <!-- High-Precision Percentage Text -->
                        <TextBlock Grid.Column="1" x:Name="ProgressPercentageText"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Text="0%"/>
                    </Grid>

                    <!-- High-Precision Progress Bar -->
                    <ProgressBar x:Name="ProgressBar"
                                 Style="{StaticResource ModernProgressBarStyle}"
                                 Margin="0,10,0,2"
                                 IsIndeterminate="True"
                                 Minimum="0" Maximum="100"/>
                </StackPanel>
            </Border>

            <!-- Result Notification Card (Success / Error) -->
            <Border x:Name="ResultNotification" Visibility="Collapsed"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    CornerRadius="12" Padding="14,14" Margin="0,10,0,0"
                    BorderBrush="{DynamicResource SuccessButtonBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                            Background="#2010B981" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ResultIcon" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                   Text="&#xE73E;" Foreground="{DynamicResource SuccessButtonBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ResultTitle" Text="Operation Completed" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock x:Name="ResultMessage" FontSize="11.5"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Interactive Action Controls (Pause / Cancel / Done) -->
            <StackPanel x:Name="ControlButtonsPanel" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,16,0,0"
                        Visibility="Collapsed">
                <Button x:Name="PauseResumeButton" Style="{StaticResource ModalActionButtonStyle}"
                        Width="105" Margin="0,0,8,0"
                        Foreground="White" Background="{DynamicResource PrimaryButtonBrush}"
                        Click="PauseResume_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PauseResumeIcon" Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PauseResumeText" Text="Pause" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button x:Name="CancelDownloadButton" Style="{StaticResource ModalActionButtonStyle}"
                        Width="105" Foreground="White" Background="{DynamicResource DangerButtonBrush}"
                        Click="CancelDownload_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="CloseModalButton" Style="{StaticResource ModalActionButtonStyle}"
                        Width="110" Visibility="Collapsed"
                        Foreground="White" Background="{DynamicResource AccentBrush}"
                        Click="CloseModal_Click">
                    <TextBlock Text="Done" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
