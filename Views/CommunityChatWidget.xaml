<UserControl x:Class="SteamPluginManager.Views.CommunityChatWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SteamPluginManager.Models"
             xmlns:helpers="clr-namespace:SteamPluginManager.Helpers"
             xmlns:local="clr-namespace:SteamPluginManager.Views"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVis"/>

        <!-- Header Window-style Button -->
        <Style x:Key="ChatHeaderButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnRoot" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnRoot" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnRoot" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chat Header Tab Button Style -->
        <Style x:Key="ChatTabNavButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Message Action Mini Button Style -->
        <Style x:Key="ChatActionMiniButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="actRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="actRoot" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Message Context Menus -->
        <ContextMenu x:Key="OtherMessageContextMenu">
            <MenuItem Header="Reply" Click="ReplyContextMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy" Click="CopyContextMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="View Profile" Click="ViewProfileContextMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="OwnMessageContextMenu">
            <MenuItem Header="Reply" Click="ReplyContextMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy" Click="CopyContextMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Margin="0,2"/>
            <MenuItem Header="Delete Message" Click="DeleteContextMenuItem_Click" Foreground="#EF4444">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#EF4444"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- User Directory Card Template (Online & Offline) -->
        <DataTemplate x:Key="UserDirectoryItemTemplate" DataType="{x:Type models:UserProfile}">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar with Online/Offline Indicator -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                Cursor="Hand"
                                ToolTip="View profile"
                                MouseLeftButtonDown="OnlineUserItem_MouseLeftButtonDown">
                            <Grid>
                                <TextBlock Text="{Binding AvatarInitial}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Image Source="{Binding AvatarImage}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <EllipseGeometry Center="13,13" RadiusX="13" RadiusY="13"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>
                        <!-- Green Dot for Online -->
                        <Border Width="8" Height="8" CornerRadius="4"
                                Background="#10B981"
                                BorderBrush="{DynamicResource CardBackgroundBrush}"
                                BorderThickness="1.5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,-1,-1"
                                Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- User Name + Role + Last Seen / Bio -->
                    <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="Bold"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       Cursor="Hand"
                                       ToolTip="View profile"
                                       MouseLeftButtonDown="OnlineUserItem_MouseLeftButtonDown"/>

                            <!-- Role Badge (Admin: Red, Supporter: Green, Moderator: Blue, Member: Gray) -->
                            <Border CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#6B7280"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                <Setter Property="Background" Value="#EF4444"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSupporter}" Value="True">
                                                <Setter Property="Background" Value="#10B981"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsModerator}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMember}" Value="True">
                                                <Setter Property="Background" Value="#6B7280"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding BadgeText}" FontSize="7.5" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </WrapPanel>

                        <!-- Last Seen text for Offline or Bio for Online -->
                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <!-- Status Indicator Text: e.g. "Last seen 5m ago" or "Online now" -->
                            <TextBlock Text="{Binding LastSeenText}"
                                       FontSize="10"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,0,6,0"/>

                            <!-- Bio snippet if present -->
                            <TextBlock Text="{Binding Bio, StringFormat='• {0}'}"
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="110"
                                       Visibility="{Binding Bio, Converter={StaticResource StringToVis}}"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Mention Quick Button -->
                    <Button Grid.Column="2"
                            Style="{StaticResource ChatActionMiniButton}"
                            Width="26" Height="24"
                            ToolTip="Tag this user in chat"
                            Click="OnlineUserTagBtn_Click"
                            VerticalAlignment="Center">
                        <TextBlock Text="@" FontSize="11" FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Message Item Template -->
        <DataTemplate x:Key="ChatMessageTemplate" DataType="{x:Type models:ChatMessage}">
            <Grid Margin="0,3,0,6">
                <!-- ========================================================= -->
                <!-- 1. OTHER USER'S MESSAGE (LEFT ALIGNED)                   -->
                <!-- ========================================================= -->
                <Grid x:Name="OtherUserMessageRoot" HorizontalAlignment="Left" MaxWidth="290">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar Circle + Online Dot -->
                    <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0">
                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                ToolTip="View profile"
                                Cursor="Hand"
                                MouseLeftButtonDown="SenderAvatar_MouseLeftButtonDown">
                            <Grid>
                                <TextBlock Text="{Binding AvatarInitial}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Image Source="{Binding AvatarImage}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>
                        <!-- Green Dot Indicator for Online Status -->
                        <Border Width="8" Height="8" CornerRadius="4"
                                Background="#10B981"
                                BorderBrush="{DynamicResource BackgroundBrush}"
                                BorderThickness="1.5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,-1,-1"
                                Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <!-- Sender Name + Badge + Timestamp -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SenderName}"
                                       FontWeight="SemiBold"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       Cursor="Hand"
                                       ToolTip="View profile"
                                       MouseLeftButtonDown="SenderName_MouseLeftButtonDown"/>

                            <!-- Role Badge (Admin: Red, Supporter: Green, Moderator: Blue, Member: Gray) -->
                            <Border CornerRadius="3"
                                    Padding="4,1"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Background" Value="#6B7280"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                <Setter Property="Background" Value="#EF4444"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSupporter}" Value="True">
                                                <Setter Property="Background" Value="#10B981"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsModerator}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMember}" Value="True">
                                                <Setter Property="Background" Value="#6B7280"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding BadgeText}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Timestamp -->
                            <TextBlock Text="{Binding FormattedTime}"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </WrapPanel>

                        <!-- Bubble + Action Bar Container -->
                        <Grid Margin="0,3,0,0">
                            <Border x:Name="OtherBubbleBorder"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12,12,12,2"
                                    Padding="9,6"
                                    HorizontalAlignment="Left"
                                    MaxWidth="256"
                                    ContextMenu="{StaticResource OtherMessageContextMenu}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <!-- In-Bubble Reply Quote Block -->
                                    <Border Visibility="{Binding HasReply, Converter={StaticResource BoolToVis}}"
                                            Background="{DynamicResource HoverBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="2.5,0,0,0"
                                            CornerRadius="4"
                                            Padding="6,3"
                                            Margin="0,0,0,5"
                                            Cursor="Hand"
                                            ToolTip="Click to jump to replied message"
                                            MouseLeftButtonDown="ReplyQuoteBlock_MouseLeftButtonDown">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ReplyToSender, StringFormat='↩ {0}'}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding ReplySnippet}"
                                                       FontSize="10"
                                                       FontStyle="Italic"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Formatted Message Text with Clickable Mentions and Links -->
                                    <TextBlock local:CommunityChatWidget.FormattedMessage="{Binding}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               MaxWidth="238"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Hover Actions (Reply & Copy) -->
                            <StackPanel x:Name="OtherActionPanel"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-10,-4,0"
                                        Opacity="0">
                                <Button Style="{StaticResource ChatActionMiniButton}"
                                        ToolTip="Reply to this message"
                                        Click="ReplyMiniButton_Click">
                                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                                </Button>
                                <Button Style="{StaticResource ChatActionMiniButton}"
                                        ToolTip="Copy text"
                                        Click="CopyMiniButton_Click">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ========================================================= -->
                <!-- 2. OWN USER'S MESSAGE (RIGHT ALIGNED)                     -->
                <!-- ========================================================= -->
                <Grid x:Name="OwnUserMessageRoot" HorizontalAlignment="Right" MaxWidth="290" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0" HorizontalAlignment="Right" MaxWidth="256">
                        <!-- Timestamp + Badge + "You" -->
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Timestamp -->
                            <TextBlock Text="{Binding FormattedTime}"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>

                            <!-- Role Badge (Admin: Red, Supporter: Green, Moderator: Blue, Member: Gray) -->
                            <Border CornerRadius="3"
                                    Padding="4,1"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Background" Value="#6B7280"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                <Setter Property="Background" Value="#EF4444"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSupporter}" Value="True">
                                                <Setter Property="Background" Value="#10B981"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsModerator}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMember}" Value="True">
                                                <Setter Property="Background" Value="#6B7280"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding BadgeText}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="You"
                                       FontWeight="SemiBold"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       ToolTip="View your profile"
                                       MouseLeftButtonDown="SenderName_MouseLeftButtonDown"/>
                        </WrapPanel>

                        <!-- Bubble + Action Bar Container -->
                        <Grid Margin="0,3,0,0" HorizontalAlignment="Right">
                            <Border x:Name="OwnBubbleBorder"
                                    Background="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12,12,2,12"
                                    Padding="9,6"
                                    HorizontalAlignment="Right"
                                    MaxWidth="256"
                                    ContextMenu="{StaticResource OwnMessageContextMenu}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter Property="BorderBrush" Value="White"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <!-- In-Bubble Reply Quote Block (Own message) -->
                                    <Border Visibility="{Binding HasReply, Converter={StaticResource BoolToVis}}"
                                            Background="#26FFFFFF"
                                            BorderBrush="White"
                                            BorderThickness="2.5,0,0,0"
                                            CornerRadius="4"
                                            Padding="6,3"
                                            Margin="0,0,0,5"
                                            Cursor="Hand"
                                            ToolTip="Click to jump to replied message"
                                            MouseLeftButtonDown="ReplyQuoteBlock_MouseLeftButtonDown">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ReplyToSender, StringFormat='↩ {0}'}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
                                            <TextBlock Text="{Binding ReplySnippet}"
                                                       FontSize="10"
                                                       FontStyle="Italic"
                                                       Foreground="#DDFFFFFF"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Formatted Message Text with Clickable Mentions and Links -->
                                    <TextBlock local:CommunityChatWidget.FormattedMessage="{Binding}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               MaxWidth="238"
                                               Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <!-- Hover Actions (Reply, Copy & Delete) for Own Bubble -->
                            <StackPanel x:Name="OwnActionPanel"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="-4,-10,0,0"
                                        Opacity="0">
                                <Button Style="{StaticResource ChatActionMiniButton}"
                                        ToolTip="Reply to this message"
                                        Click="ReplyMiniButton_Click">
                                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                                </Button>
                                <Button Style="{StaticResource ChatActionMiniButton}"
                                        ToolTip="Copy text"
                                        Click="CopyMiniButton_Click">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                                </Button>
                                <Button Style="{StaticResource ChatActionMiniButton}"
                                        ToolTip="Delete message"
                                        Click="DeleteMiniButton_Click">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#EF4444"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Own Avatar Circle + Online Dot -->
                    <Grid Grid.Column="1" VerticalAlignment="Top" Margin="0,2,0,0">
                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource AccentBrush}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                ClipToBounds="True"
                                Cursor="Hand"
                                ToolTip="View your profile"
                                MouseLeftButtonDown="SenderAvatar_MouseLeftButtonDown">
                            <Grid>
                                <TextBlock Text="{Binding AvatarInitial}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Image Source="{Binding AvatarImage}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <EllipseGeometry Center="13,13" RadiusX="13" RadiusY="13"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>
                        <!-- Green Dot -->
                        <Border Width="8" Height="8" CornerRadius="4"
                                Background="#10B981"
                                BorderBrush="{DynamicResource BackgroundBrush}"
                                BorderThickness="1.5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,-1,-1"
                                Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Triggers for Switching between Other and Own and Hover Effects -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOwnMessage}" Value="True">
                    <Setter TargetName="OtherUserMessageRoot" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="OwnUserMessageRoot" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <EventTrigger RoutedEvent="MouseEnter" SourceName="OtherUserMessageRoot">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="OtherActionPanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave" SourceName="OtherUserMessageRoot">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="OtherActionPanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseEnter" SourceName="OwnUserMessageRoot">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="OwnActionPanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave" SourceName="OwnUserMessageRoot">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="OwnActionPanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ======================================================== -->
        <!-- COLLAPSED STATE: Floating Pill Button                    -->
        <!-- ======================================================== -->
        <Border x:Name="CollapsedPill"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="12,8"
                Cursor="Hand"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Visibility="Visible"
                MouseLeftButtonDown="CollapsedPill_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE8BD;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="15"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="Community Chat"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"
                           VerticalAlignment="Center"/>
                <Border Width="7" Height="7" CornerRadius="3.5" Background="#10B981" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- EXPANDED STATE: Full Chat Drawer / Widget                -->
        <!-- ======================================================== -->
        <Border x:Name="ExpandedDrawer"
                Width="340"
                Height="480"
                Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="10" Opacity="0.45"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER WITH TABS -->
                <Border Grid.Row="0"
                        Background="{DynamicResource HeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="10,0">
                    <Grid VerticalAlignment="Center">
                        <!-- Left: Tab Buttons (Chat & Online) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Tab 1: Chat -->
                            <Button x:Name="TabChatBtn"
                                    Style="{StaticResource ChatTabNavButton}"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    Click="TabChatBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Margin="0,0,5,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chat" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Tab 2: Online Users -->
                            <Button x:Name="TabOnlineBtn"
                                    Style="{StaticResource ChatTabNavButton}"
                                    Margin="4,0,0,0"
                                    Click="TabOnlineBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="7" Height="7" CornerRadius="3.5" Background="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OnlineCountText" Text="Online (0)" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Right: Window Controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="RefreshChatBtn"
                                    Style="{StaticResource ChatHeaderButton}"
                                    ToolTip="Refresh chat messages"
                                    Click="RefreshChatBtn_Click">
                                <TextBlock x:Name="RefreshIcon" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="RefreshIconRotate" Angle="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>
                            <Button x:Name="CollapseChatBtn"
                                    Style="{StaticResource ChatHeaderButton}"
                                    ToolTip="Minimize chat"
                                    Click="CollapseChatBtn_Click">
                                <TextBlock Text="—" FontSize="12" FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- BODY AREA (TAB 1: MESSAGES / TAB 2: ONLINE USERS) -->
                <Grid Grid.Row="1" Margin="12,8,12,8">
                    <!-- VIEW 1: MESSAGES LIST AREA -->
                    <Grid x:Name="ChatViewPanel" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- PINNED SYSTEM ANNOUNCEMENT RUNNING TEXT BANNER -->
                        <Border x:Name="PinnedAnnouncementBanner"
                                Grid.Row="0"
                                Height="30"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="6,0"
                                Margin="0,0,0,6"
                                ClipToBounds="True"
                                Visibility="Collapsed"
                                MouseEnter="PinnedAnnouncementBanner_MouseEnter"
                                MouseLeave="PinnedAnnouncementBanner_MouseLeave">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Pinned Badge -->
                                <Border Grid.Column="0"
                                        Background="#1E1B4B"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="5,2"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xEC42;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="9.5"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,0,3,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="PINNED"
                                                   FontSize="8.5"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Running Marquee Text Area -->
                                <Canvas Grid.Column="1" x:Name="MarqueeCanvas" ClipToBounds="True" VerticalAlignment="Center" Height="20" SizeChanged="MarqueeCanvas_SizeChanged">
                                    <TextBlock x:Name="PinnedMarqueeTextBlock"
                                               Text="📢 Announcement loading..."
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               VerticalAlignment="Center"
                                               Canvas.Top="1">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="MarqueeTranslateTransform" X="0"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Canvas>
                            </Grid>
                        </Border>

                        <!-- Messages List Container -->
                        <Grid Grid.Row="1">
                            <!-- Animated Loading State -->
                            <StackPanel x:Name="ChatLoadingPanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <Canvas Width="26" Height="26" Margin="0,0,0,10" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Canvas.RenderTransform>
                                        <RotateTransform x:Name="ChatSpinnerRotate" Angle="0"/>
                                    </Canvas.RenderTransform>
                                    <Ellipse Width="26" Height="26"
                                             Stroke="{DynamicResource AccentBrush}"
                                             StrokeThickness="2.8"
                                             StrokeDashArray="32 100"/>
                                </Canvas>
                                <TextBlock Text="Loading messages..."
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Loading / Empty State -->
                            <TextBlock x:Name="EmptyChatText"
                                       Text="No messages yet. Be the first to chat!"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>

                            <ScrollViewer x:Name="MessagesScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="MessagesItemsControl"
                                              ItemTemplate="{StaticResource ChatMessageTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- VIEW 2: ONLINE & OFFLINE USERS DIRECTORY AREA -->
                    <Grid x:Name="OnlineUsersViewPanel" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyOnlineUsersText"
                                   Text="No users found."
                                   FontSize="11.5"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,0,10">
                                <!-- ONLINE CATEGORY HEADER -->
                                <Border x:Name="OnlineSectionHeader"
                                        Background="{DynamicResource HeaderBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="6"
                                        Padding="8,5"
                                        Margin="0,2,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="7" Height="7" CornerRadius="3.5" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="OnlineSectionTitle" Text="ONLINE — 0" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- ONLINE USERS LIST -->
                                <ItemsControl x:Name="OnlineUsersItemsControl"
                                              ItemTemplate="{StaticResource UserDirectoryItemTemplate}"/>

                                <!-- OFFLINE CATEGORY HEADER -->
                                <Border x:Name="OfflineSectionHeader"
                                        Background="{DynamicResource HeaderBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="6"
                                        Padding="8,5"
                                        Margin="0,12,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="7" Height="7" CornerRadius="3.5" Background="#6B7280" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="OfflineSectionTitle" Text="OFFLINE — 0" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- OFFLINE USERS LIST -->
                                <ItemsControl x:Name="OfflineUsersItemsControl"
                                              ItemTemplate="{StaticResource UserDirectoryItemTemplate}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Toast Notification (e.g. copied text, reply target, delete feedback) -->
                    <Border x:Name="ChatToastNotification"
                            Background="#D81F2937"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,4,0,0"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="ChatToastText"
                                   FontSize="10.5"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- FOOTER / INPUT AREA -->
                <Border Grid.Row="2"
                        Background="{DynamicResource HeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <Grid>
                        <!-- Case 1: User does not have a display name set -->
                        <Border x:Name="NoNameBanner"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Set your name in profile to join the conversation."
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        x:Name="SetProfileNameBtn"
                                        Content="Set Name"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="10,4"
                                        Margin="8,0,0,0"
                                        Cursor="Hand"
                                        Click="SetProfileNameBtn_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Case 2: User has display name set (Active Input) -->
                        <StackPanel x:Name="ActiveInputPanel" Visibility="Visible">
                            <!-- Mention Autocomplete Popup -->
                            <Popup x:Name="MentionSuggestionPopup"
                                   Placement="Top"
                                   PlacementTarget="{Binding ElementName=ChatInputContainer}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        MinWidth="200"
                                        MaxWidth="260"
                                        MaxHeight="160"
                                        Padding="4"
                                        Margin="0,0,0,6">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.35"/>
                                    </Border.Effect>
                                    <ListBox x:Name="MentionListBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             KeyDown="MentionListBox_KeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="6,4"
                                                        CornerRadius="6"
                                                        Cursor="Hand"
                                                        PreviewMouseLeftButtonDown="MentionItem_PreviewMouseLeftButtonDown">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9"
                                                                Background="{DynamicResource ButtonBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1">
                                                            <TextBlock Text="{Binding AvatarInitial}"
                                                                       FontSize="8.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                        </Border>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DisplayNameWithAt}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                                   Margin="6,0,4,0"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Border Grid.Column="2"
                                                                CornerRadius="3"
                                                                Padding="3,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#6B7280"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                                            <Setter Property="Background" Value="#EF4444"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSupporter}" Value="True">
                                                                            <Setter Property="Background" Value="#10B981"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsModerator}" Value="True">
                                                                            <Setter Property="Background" Value="#3B82F6"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding BadgeText}"
                                                                       FontSize="7"
                                                                       FontWeight="Bold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>

                            <!-- Active Reply Target Preview Bar -->
                            <Border x:Name="ReplyPreviewBar"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="2.5,0,0,0"
                                    CornerRadius="6"
                                    Padding="8,5"
                                    Margin="0,0,0,6"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="ReplyTargetSenderText"
                                                   Text="Replying to @user"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock x:Name="ReplyTargetSnippetText"
                                                   Text="Message snippet..."
                                                   FontSize="10"
                                                   FontStyle="Italic"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            x:Name="CancelReplyBtn"
                                            Width="20"
                                            Height="20"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource MutedForegroundBrush}"
                                            Cursor="Hand"
                                            ToolTip="Cancel reply"
                                            Click="CancelReplyBtn_Click">
                                        <TextBlock Text="✕" FontSize="9.5" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Input Row with Placeholder -->
                            <Grid x:Name="ChatInputContainer">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,0">
                                    <Grid>
                                        <TextBox x:Name="ChatInputTextBox"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{DynamicResource ForegroundBrush}"
                                                 CaretBrush="{DynamicResource ForegroundBrush}"
                                                 FontSize="12"
                                                 VerticalContentAlignment="Center"
                                                 Height="34"
                                                 MaxLength="300"
                                                 TextChanged="ChatInputTextBox_TextChanged"
                                                 PreviewKeyDown="ChatInputTextBox_PreviewKeyDown"/>

                                        <!-- Placeholder Text -->
                                        <TextBlock x:Name="ChatInputPlaceholder"
                                                   Text="Write a message... (@ to tag user)"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Margin="2,0,0,0"
                                                   Opacity="0.6"/>
                                    </Grid>
                                </Border>

                                <!-- Send Button -->
                                <Button Grid.Column="1"
                                        x:Name="SendChatBtn"
                                        Width="36"
                                        Height="34"
                                        Margin="8,0,0,0"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="Send message (Enter)"
                                        Click="SendChatBtn_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ======================================================== -->
                <!-- MINI USER PROFILE CARD POPUP (IN-DRAWER OVERLAY)          -->
                <!-- ======================================================== -->
                <Grid x:Name="MiniProfileCardOverlay"
                      Grid.Row="0" Grid.RowSpan="3"
                      Background="#66000000"
                      Visibility="Collapsed"
                      MouseLeftButtonDown="MiniProfileCardOverlay_MouseLeftButtonDown">
                    <Border x:Name="MiniProfileCardContent"
                            Width="260"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16,14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MouseLeftButtonDown="MiniProfileCardContent_MouseLeftButtonDown">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Header Row with Close Button -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar with Online Dot -->
                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <Border x:Name="MiniCardAvatarBorder"
                                            Width="40" Height="40" CornerRadius="20"
                                            Background="{DynamicResource ButtonBackgroundBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="2"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock x:Name="MiniCardAvatarInitial"
                                                       Text="?"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Image x:Name="MiniCardAvatarImage"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="Collapsed">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <!-- Online Dot on Profile Card -->
                                    <Border x:Name="MiniCardOnlineDot"
                                            Width="10" Height="10" CornerRadius="5"
                                            Background="#10B981"
                                            BorderBrush="{DynamicResource CardBackgroundBrush}"
                                            BorderThickness="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,2,0"
                                            Visibility="Collapsed"/>
                                </Grid>

                                <!-- Name + Badge -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,6,0">
                                    <TextBlock x:Name="MiniCardDisplayName"
                                               Text="Username"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border x:Name="MiniCardLevelBadge"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="0,3,0,0"
                                            HorizontalAlignment="Left"
                                            Background="#6B7280">
                                        <TextBlock x:Name="MiniCardLevelText"
                                                   Text="MEMBER"
                                                   FontSize="8.5"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>

                                <!-- Close Button -->
                                <Button Grid.Column="2"
                                        Width="24" Height="24"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource MutedForegroundBrush}"
                                        Cursor="Hand"
                                        VerticalAlignment="Top"
                                        Click="MiniCardCloseBtn_Click">
                                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold"/>
                                </Button>
                            </Grid>

                            <!-- Bio -->
                            <Border Background="{DynamicResource ButtonBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Margin="0,0,0,14">
                                <TextBlock x:Name="MiniCardBioText"
                                           Text="No bio description available."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           MaxHeight="80"/>
                            </Border>

                            <!-- Action Buttons -->
                            <UniformGrid Columns="2">
                                <Button x:Name="MiniCardMentionBtn"
                                        Content="@ Mention"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Height="32"
                                        Margin="0,0,4,0"
                                        Cursor="Hand"
                                        Click="MiniCardMentionBtn_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <Button x:Name="MiniCardCopyNameBtn"
                                        Content="Copy Name"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Background="{DynamicResource HoverBrush}"
                                        Foreground="{DynamicResource ForegroundBrush}"
                                        BorderThickness="0"
                                        Height="32"
                                        Margin="4,0,0,0"
                                        Cursor="Hand"
                                        Click="MiniCardCopyNameBtn_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
