<UserControl x:Class="SteamPluginManager.Views.OnlineFixDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <!-- Settings Button Template -->
        <ControlTemplate x:Key="SettingsButtonTemplate" TargetType="Button">
            <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource ButtonIconBackground}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{TemplateBinding Tag}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" FontSize="12" FontFamily="Segoe MDL2 Assets"/>
                    </Border>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                    <Setter TargetName="root" Property="Opacity" Value="0.95"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="root" Property="Opacity" Value="0.6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Storyboard x:Key="SpinAnimation">
            <DoubleAnimation Storyboard.TargetName="LoadingSpinner"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1.5" RepeatBehavior="Forever"/>
        </Storyboard>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Progress Overlay -->
        <Grid x:Name="ProgressOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="24" Effect="{DynamicResource DropShadowEffect}">
                    <StackPanel>
                        <TextBlock x:Name="ProgressTitle" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,12" Text="Applying Online Fix..."/>
                        <TextBlock x:Name="ProgressStatus" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,8" TextWrapping="Wrap" Text="Initializing..."/>
                        <TextBlock x:Name="ProgressDetail" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,16" TextWrapping="Wrap" Visibility="Collapsed" Text=""/>
                        <ProgressBar x:Name="ProgressBar" Height="6" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource SuccessButtonBrush}" Margin="0,0,0,12" IsIndeterminate="True"/>
                        <StackPanel x:Name="StepsPanel" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="Step1Icon" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="&#xE7BA;" Margin="0,0,8,0"/>
                                <TextBlock x:Name="Step1Text" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Text="Verifying file availability..."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="Step2Icon" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="&#xE7BA;" Margin="0,0,8,0"/>
                                <TextBlock x:Name="Step2Text" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Text="Downloading file..."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="Step3Icon" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="&#xE7BA;" Margin="0,0,8,0"/>
                                <TextBlock x:Name="Step3Text" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Text="Extracting files..."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Step4Icon" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="&#xE7BA;" Margin="0,0,8,0"/>
                                <TextBlock x:Name="Step4Text" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Text="Moving to game folder..."/>
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="ResultNotification" Visibility="Collapsed" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16" Margin="0,16,0,0" BorderBrush="{DynamicResource SuccessButtonBrush}" BorderThickness="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ResultIcon" FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE73E;" Foreground="{DynamicResource SuccessButtonBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ResultMessage" FontSize="12" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" Padding="24,20,24,20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailTitle" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Text="Online Fix Details"/>
                    <TextBlock x:Name="DetailSubtitle" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0" Text="Multiplayer/Online Fix Information"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AddToLibraryButton" Width="130" Height="38" Padding="8,6" Margin="0,0,12,0"
                            Background="{DynamicResource SuccessButtonBrush}"
                            Foreground="White" FontWeight="SemiBold"
                            Click="AddToLibrary_Click" Cursor="Hand" FontSize="11"
                            BorderThickness="0"
                            Template="{StaticResource SettingsButtonTemplate}" Tag="{StaticResource Icon.Plus}">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="Apply Online Fix"/>
                    </Button>
                    <Button x:Name="BackButton" Width="90" Height="38" Padding="8,6"
                            Background="{DynamicResource PrimaryButtonBrush}"
                            Foreground="White" FontWeight="SemiBold"
                            Click="BackToDashboard_Click" Cursor="Hand" FontSize="11"
                            BorderThickness="0"
                            Template="{StaticResource SettingsButtonTemplate}" Tag="{StaticResource Icon.Back}">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="Back"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,30,30,30">
                <Border x:Name="ThumbnailBorder"
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="18"
                        Margin="0,0,0,24"
                        HorizontalAlignment="Stretch"
                        SnapsToDevicePixels="True"
                        MinHeight="280">
                    <Grid ClipToBounds="True">
                        <Image x:Name="GameThumbnail"
                               Stretch="UniformToFill"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Stretch"
                               MaxHeight="340"/>
                        <Rectangle HorizontalAlignment="Stretch"
                                   VerticalAlignment="Bottom"
                                   Height="140"
                                   IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#22000000" Offset="0.45"/>
                                    <GradientStop Color="#99000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Border>
                <TextBlock x:Name="GameNameDetail" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}">
                        <Run Text="Genre: "/>
                    </TextBlock>
                    <TextBlock x:Name="GenreDetail" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0,0,0"/>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,20"/>
                <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8">
                    <Run Text="Description"/>
                </TextBlock>
                <TextBlock x:Name="DescriptionDetail" FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,24" TextWrapping="Wrap" LineHeight="18"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
