<UserControl x:Class="SteamPluginManager.Views.OnlineFixDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <!-- Modern Button Template -->
        <ControlTemplate x:Key="SettingsButtonTemplate" TargetType="Button">
            <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ButtonIconBackground}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,7,0">
                        <TextBlock Text="{TemplateBinding Tag}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" FontSize="11" FontFamily="Segoe MDL2 Assets"/>
                    </Border>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="root" Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="root" Property="Opacity" Value="0.75"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="root" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DetailSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Storyboard x:Key="SpinAnimation">
            <DoubleAnimation Storyboard.TargetName="LoadingSpinner"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1.5" RepeatBehavior="Forever"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>



        <!-- Modern Header Section -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" Padding="16,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid MaxWidth="1050" HorizontalAlignment="Center">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AddToLibraryButton" Height="36" Padding="14,6" Margin="0,0,10,0"
                            Background="{DynamicResource SuccessButtonBrush}"
                            Foreground="White" FontWeight="SemiBold"
                            Click="AddToLibrary_Click" Cursor="Hand" FontSize="11.5"
                            BorderThickness="0"
                            Template="{StaticResource SettingsButtonTemplate}" Tag="{StaticResource Icon.Plus}">
                        <TextBlock x:Name="AddToLibraryButtonText" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Apply Online Fix"/>
                    </Button>

                    <Button x:Name="RestoreGameButton" Height="36" Padding="14,6"
                            Background="{DynamicResource DangerButtonBrush}"
                            Foreground="White" FontWeight="SemiBold"
                            Click="RestoreGame_Click" Cursor="Hand" FontSize="11.5"
                            BorderThickness="0"
                            Template="{StaticResource SettingsButtonTemplate}" Tag="{StaticResource Icon.Refresh}">
                        <TextBlock x:Name="RestoreGameButtonText" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Restore Original Game"/>
                    </Button>

                    <!-- Validation In Progress Indicator Badge -->
                    <Border x:Name="ValidationStatusBadge"
                            Visibility="Collapsed"
                            Background="#22A855F7"
                            BorderBrush="#A855F7"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,7"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="12.5" Foreground="#C084FC" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Steam is validating / verifying files... Please wait until verification completes."
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#E9D5FF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel x:Name="DetailContentPanel" Margin="16,14,16,20" MaxWidth="1050" HorizontalAlignment="Center">
                <Border x:Name="ThumbnailBorder"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Margin="0,0,0,18"
                        HorizontalAlignment="Stretch"
                        SnapsToDevicePixels="True"
                        MinHeight="140"
                        MaxHeight="320"
                        ClipToBounds="True">
                    <Grid ClipToBounds="True">
                        <Image x:Name="GameThumbnail"
                               Stretch="UniformToFill"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Stretch"
                               MaxHeight="320"/>
                        <Rectangle HorizontalAlignment="Stretch"
                                   VerticalAlignment="Bottom"
                                   Height="120"
                                   IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#550A0D14" Offset="0.5"/>
                                    <GradientStop Color="#DD0A0D14" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Border>

                <!-- Game Header Info Card -->
                <Border Style="{StaticResource DetailSectionCard}">
                    <StackPanel>
                        <TextBlock x:Name="GameNameDetail" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <Border Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Genre: " FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="GenreDetail" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                        
                        <TextBlock Text="ABOUT THIS FIX" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="DescriptionDetail" FontSize="12.5" Foreground="{DynamicResource ForegroundBrush}" Opacity="0.9" TextWrapping="Wrap" LineHeight="19"/>
                    </StackPanel>
                </Border>

                <!-- Custom Launch Tutorial Card (Visible only when tutorial exists) -->
                <Border x:Name="TutorialCard" Visibility="Collapsed" Style="{StaticResource DetailSectionCard}"
                        BorderBrush="#0284C7" BorderThickness="1.5" Margin="0,0,0,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0B1E2E" Offset="0"/>
                            <GradientStop Color="#081420" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <!-- Header with Glowing Icon -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#260284C7" BorderBrush="#0284C7" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="CUSTOM LAUNCH GUIDE &amp; TUTORIAL" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <Border Background="#0C4A6E" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="RECOMMENDED SETUP" FontSize="9" FontWeight="Bold" Foreground="#7DD3FC"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TutorialSummaryText" FontSize="13" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Parameters Grid (Exe & Arguments) -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Target Executable -->
                            <Border Grid.Column="0" Background="#0A1622" BorderBrush="#162E40" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="TARGET EXECUTABLE (EXE/BAT)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,4"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TutorialExeText" Grid.Column="0" Text="Game.exe" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Width="26" Height="26" Click="CopyExe_Click" ToolTip="Copy Executable Name" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Launch Arguments -->
                            <Border Grid.Column="2" Background="#0A1622" BorderBrush="#162E40" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="LAUNCH ARGUMENTS (PARAMETERS)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,4"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TutorialArgsText" Grid.Column="0" Text="(None)" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Width="26" Height="26" Click="CopyArgs_Click" ToolTip="Copy Launch Arguments" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Step-by-Step Instructions -->
                        <TextBlock Text="LAUNCH INSTRUCTIONS:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="TutorialStepsList" Margin="0,0,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0C1B28" BorderBrush="#162E40" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#0284C7" Margin="0,0,12,0" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding StepNumber}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="17"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Notes / Notice Block -->
                        <Border x:Name="TutorialNotesBorder" Background="#1B172E" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C084FC" Margin="0,1,10,0" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="NOTES &amp; TROUBLESHOOTING" FontSize="10.5" FontWeight="Bold" Foreground="#C084FC"/>
                                    <TextBlock x:Name="TutorialNotesText" FontSize="11.5" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="17"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Action Buttons Bar -->
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="ApplyTutorialButton" Height="36" Padding="16,0" Click="ApplyTutorialButton_Click"
                                    Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11.5"
                                    BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Auto-Apply to Custom Launch" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#0369A1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="OpenGameInLibraryBtn" Height="36" Padding="14,0" Click="OpenGameInLibrary_Click"
                                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="11.5" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Open Game in Library" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
