<Window x:Class="SteamPluginManager.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wc="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SGR - Steam Game Manager" Height="700" Width="1200"
        WindowStyle="None" ResizeMode="CanResize"
        MaxHeight="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenHeight}}"
        MaxWidth="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenWidth}}"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">
    <WindowChrome.WindowChrome>
        <wc:WindowChrome CaptionHeight="0"
                          ResizeBorderThickness="7"
                          CornerRadius="12"
                          GlassFrameThickness="0"
                          UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        
        <!-- Window control button style -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="root" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButton" BasedOn="{StaticResource WindowButton}" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{DynamicResource DangerButtonBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="root" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Feature Card Style -->
        <Style x:Key="FeatureCardButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Title Style -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Title Bar -->
        <Border Background="{DynamicResource HeaderBackgroundBrush}" 
                Height="50" 
                VerticalAlignment="Top"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                x:Name="TitleBar">
            <Grid>
                <TextBlock Text="🎮 SGR Dashboard" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"/>
                
                <!-- Window Controls -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                    <Button x:Name="MinimizeBtn" 
                            Style="{StaticResource WindowButton}" 
                            Click="MinimizeButton_Click"
                            Content="➖" 
                            ToolTip="Minimize"/>
                    <Button x:Name="MaximizeBtn" 
                            Style="{StaticResource WindowButton}" 
                            Click="MaximizeButton_Click"
                            Content="🔲" 
                            ToolTip="Maximize"/>
                    <Button x:Name="CloseBtn" 
                            Style="{StaticResource CloseWindowButton}" 
                            Click="CloseButton_Click"
                            Content="✕" 
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Margin="0,50,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">
                <!-- Welcome Section -->
                <TextBlock Text="Welcome to SGR" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Steam Game Remover - Manage your games, backups, and fixes" 
                           FontSize="14" 
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,30"/>

                <!-- Newest Manifests Section -->
                <StackPanel Margin="0,0,0,40">
                    <TextBlock Text="📦 Newest Manifest Files" Style="{StaticResource SectionTitle}"/>
                    <Grid x:Name="ManifestCardsGrid" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Manifest cards will be added dynamically here -->
                    </Grid>
                    <Button Style="{StaticResource FeatureCardButton}" Click="ViewAllManifests_Click" Height="Auto" Padding="20,12">
                        <TextBlock Text="View All Manifest Files →" FontSize="12" TextAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Game Management Section -->
                <TextBlock Text="🎮 Game Library" Style="{StaticResource SectionTitle}"/>
                <StackPanel Margin="0,0,0,30" HorizontalAlignment="Center" Width="350">
                    <!-- Library (consolidated) -->
                    <Button Style="{StaticResource FeatureCardButton}" Click="Library_Click" Height="Auto" Padding="30,20">
                        <StackPanel HorizontalAlignment="Center" Width="280">
                            <TextBlock FontSize="48" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,10">📚</TextBlock>
                            <TextBlock Text="Game Library" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="View, manage, backup, and securely remove games" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Text="See detailed info, thumbnails, and system impact" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.8"/>
                        </StackPanel>
                    </Button>

                    <!-- Online Fix -->
                    <Button Style="{StaticResource FeatureCardButton}" Click="OnlineFix_Click" Height="Auto" Padding="30,20" Margin="0,15,0,0">
                        <StackPanel HorizontalAlignment="Center" Width="280">
                            <TextBlock FontSize="48" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,10">🌐</TextBlock>
                            <TextBlock Text="Online Fix" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="Fix multiplayer and online connectivity issues" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Text="Resolve DRM and network-related problems" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.8"/>
                        </StackPanel>
                    </Button>

                    <!-- Restore Backup -->
                    <Button Style="{StaticResource FeatureCardButton}" Click="Restore_Click" Height="Auto" Padding="30,20" Margin="0,15,0,0">
                        <StackPanel HorizontalAlignment="Center" Width="280">
                            <TextBlock FontSize="48" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,10">🔄</TextBlock>
                            <TextBlock Text="Restore Backup" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="Restore games from backup .spmb files" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Text="Recover previously removed games safely" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.8"/>
                        </StackPanel>
                    </Button>

                    <!-- HZ Manifest -->
                    <Button Style="{StaticResource FeatureCardButton}" Click="HZManifest_Click" Height="Auto" Padding="30,20" Margin="0,15,0,0">
                        <StackPanel HorizontalAlignment="Center" Width="280">
                            <TextBlock FontSize="48" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,10">📦</TextBlock>
                            <TextBlock Text="HZ Manifest Files" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="Download and manage manifest files" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Text="Ensure game compatibility and updates" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.8"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Additional Tools Section -->
                <TextBlock Text="🛠️ Additional Tools" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Game Bypass -->
                    <Button Grid.Column="0" Style="{StaticResource FeatureCardButton}" Click="GameBypass_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock FontSize="48" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,10">🔓</TextBlock>
                            <TextBlock Text="Game Bypass" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="Bypass game protections" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- Restart Steam -->
                    <Button Grid.Column="2" Style="{StaticResource FeatureCardButton}" Click="RestartSteam_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock FontSize="48" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,10">🔄</TextBlock>
                            <TextBlock Text="Restart Steam" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="Refresh Steam client" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </Grid>


            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
