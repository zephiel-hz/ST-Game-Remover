<UserControl x:Class="SteamPluginManager.Views.CustomizeProfileModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="490">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#1E2638"/>

        <!-- Action Button Style -->
        <Style x:Key="ProfileModalButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Single-line TextBox Style -->
        <Style x:Key="ProfileModalTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Multi-line TextBox Style -->
        <Style x:Key="ProfileModalMultiLineTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10,12,10"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Width="470"
            MaxWidth="500"
            Padding="24,22"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="12" Opacity="0.45"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header Section (Icon, Title, Subtitle, Close Button) -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                        Background="{DynamicResource ButtonBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ModalTitleText" Text="Customize Profile" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock x:Name="ModalSubtitleText" Text="Update your public display name and account bio."
                               FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" x:Name="CloseButton"
                        Width="30" Height="30"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="Close (Esc)"
                        Click="CloseButton_Click" VerticalAlignment="Top">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="closeBd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="closeBd" Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Live Profile Preview Card with Avatar Upload / Crop -->
            <Border Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,14"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar Preview Circle with Clickable Camera Badge -->
                    <Grid Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                        <!-- Outer Shadow & Background Circle -->
                        <Border x:Name="AvatarBorderContainer" Width="64" Height="64" CornerRadius="32"
                                ClipToBounds="True" Cursor="Hand"
                                ToolTip="Click to select and crop profile picture"
                                MouseLeftButtonDown="ChangePhoto_Click">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#EC4899" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            
                            <Grid>
                                <!-- Initial Text Fallback -->
                                <TextBlock x:Name="AvatarPreviewInitial" Text="U"
                                           FontSize="24" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- Custom Avatar Image -->
                                <Image x:Name="AvatarPreviewImage"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32"/>
                                    </Image.Clip>
                                </Image>

                                <!-- Semi-transparent Hover / Camera Overlay -->
                                <Border x:Name="AvatarHoverOverlay" Background="#70000000" Opacity="0"
                                        CornerRadius="32">
                                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Camera Badge on Corner -->
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource CardBackgroundBrush}"
                                BorderThickness="2"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,-2,-2"
                                Cursor="Hand"
                                ToolTip="Change Profile Picture"
                                MouseLeftButtonDown="ChangePhoto_Click">
                            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="10.5"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Name, Status, Bio Preview & Photo Action Buttons -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AvatarPreviewName" Text="User"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,3">
                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DeviceIdPreviewText" Text="Device ID: UNKNOWN"
                                       FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>

                        <TextBlock x:Name="AvatarPreviewBio" Text="No bio provided."
                                   FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextTrimming="CharacterEllipsis" MaxHeight="32"
                                   FontStyle="Italic" Margin="0,0,0,6"/>

                        <!-- Photo Action Buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ChangePhotoButton"
                                     Content="Change Photo..."
                                    FontSize="11" FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Background="#153B82F6"
                                    BorderBrush="#303B82F6"
                                    BorderThickness="1"
                                    Padding="8,3" Height="24"
                                    Cursor="Hand"
                                    Click="ChangePhoto_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="RemovePhotoButton"
                                     Content="Remove Photo"
                                    FontSize="11" FontWeight="Medium"
                                    Foreground="#EF4444"
                                    Background="#15EF4444"
                                    BorderBrush="#30EF4444"
                                    BorderThickness="1"
                                    Padding="8,3" Height="24"
                                    Margin="8,0,0,0"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="RemovePhoto_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Badge -->
                    <Border Grid.Column="2" VerticalAlignment="Top"
                            Background="#18FFFFFF" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,2,0,0">
                        <TextBlock Text="PREVIEW" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Form Fields -->
            <StackPanel Margin="0,0,0,6">
                <!-- Display Name Field -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Display Name" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text=" *" FontSize="12" FontWeight="Bold" Foreground="#EF4444"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="NameCharCountText" Text="0/30"
                               FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <TextBox x:Name="DisplayNameTextBox"
                             Style="{StaticResource ProfileModalTextBoxStyle}"
                             MaxLength="30"
                             TextChanged="DisplayNameTextBox_TextChanged"
                             KeyDown="DisplayNameTextBox_KeyDown"/>
                    <TextBlock x:Name="DisplayNamePlaceholder"
                               Text="Enter your display name..."
                               Foreground="{DynamicResource PlaceholderBrush}"
                               FontSize="13"
                               Margin="13,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>

                <!-- Bio Field -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="About / Bio" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text=" (Optional)" FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="BioCharCountText" Text="0/180"
                               FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <TextBox x:Name="BioTextBox"
                             Style="{StaticResource ProfileModalMultiLineTextBoxStyle}"
                             Height="85"
                             MaxLength="180"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="BioTextBox_TextChanged"/>
                    <TextBlock x:Name="BioPlaceholder"
                               Text="Tell the community a little about yourself..."
                               Foreground="{DynamicResource PlaceholderBrush}"
                               FontSize="13"
                               Margin="13,10,0,0"
                               VerticalAlignment="Top"
                               IsHitTestVisible="False"/>
                </Grid>
            </StackPanel>

            <!-- Validation Alert Banner -->
            <Border x:Name="ValidationBanner"
                    Background="#25EF4444"
                    BorderBrush="#55EF4444"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,9"
                    Margin="0,0,0,14"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE783;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Foreground="#EF4444" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="ValidationText"
                               Text="Display Name cannot be empty."
                               FontSize="12" Foreground="#FCA5A5"
                               FontWeight="Medium" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- Action Buttons Bar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource ProfileModalButtonStyle}"
                        Background="{StaticResource SecondaryButtonBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button x:Name="SaveButton"
                        Content="Save Changes"
                        MinWidth="125"
                        Style="{StaticResource ProfileModalButtonStyle}"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
