<UserControl x:Class="SteamPluginManager.Views.GameLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SteamPluginManager"
             xmlns:helpers="clr-namespace:SteamPluginManager.Helpers"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}"
             AllowDrop="True"
             DragOver="UserControl_DragOver"
             Drop="UserControl_Drop">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:InstalledBadgeTextConverter x:Key="InstalledBadgeTextConverter"/>
        
        <!-- Rounded Button Style -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        
        <!-- Stretch Icon Button Style for full-width buttons like Copy Log -->
        <Style x:Key="StretchIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                      <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource ButtonIconBackground}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{TemplateBinding Tag}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" FontSize="11" FontFamily="Segoe MDL2 Assets"/>
                      </Border>
                      <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                      <Setter TargetName="root" Property="Opacity" Value="0.95"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="root" Property="Opacity" Value="0.6"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ManifestComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="DropDownToggle"
                                         Grid.Column="0"
                                         IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                         ClickMode="Press"
                                         Background="{TemplateBinding Background}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         Foreground="{TemplateBinding Foreground}"
                                         Padding="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Name="toggleBorder"
                                               Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="4"
                                               Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                 Content="{TemplateBinding Content}"
                                                                 Margin="8,0,0,0"
                                                                 VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                          Text="▼"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          FontSize="10"
                                                          Margin="0,2,4,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="toggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="toggleBorder" Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="toggleBorder" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="toggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Name="contentPresenter"
                                                 Content="{TemplateBinding SelectionBoxItem}"
                                                 ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                 ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            </ToggleButton>
                            <Popup Name="PART_Popup"
                                  AllowsTransparency="True"
                                  IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  Placement="Bottom"
                                  PopupAnimation="Fade"
                                  Margin="0,2,0,0">
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                       BorderBrush="{DynamicResource AccentBrush}"
                                       BorderThickness="1"
                                       CornerRadius="4"
                                       Padding="4">
                                    <ScrollViewer CanContentScroll="True"
                                                 MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                                                 MaxHeight="150">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                               Background="{TemplateBinding Background}"
                               Padding="{TemplateBinding Padding}"
                               CornerRadius="3"
                               Margin="2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GameCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="0" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" Padding="20,16,20,24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock x:Name="GameLibraryTitleText" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock x:Name="GameLibrarySubtitleText" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Right: Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="SelectAllBtn" Width="120" Height="34" Click="SelectAll_Click" Margin="0,0,8,0" Padding="8,6"
                            Background="{DynamicResource PrimaryButtonBrush}"
                            Foreground="White" FontWeight="SemiBold" Cursor="Hand" FontSize="12"
                            Style="{StaticResource CompactIconButtonStyle}"
                            Tag="{StaticResource Icon.Check}">
                        <TextBlock x:Name="SelectAllText" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                    </Button>
                        <Button x:Name="RefreshBtn" Width="120" Height="34" Click="Refresh_Click" Margin="0,0,8,0" Padding="8,6"
                            Background="{DynamicResource SuccessButtonBrush}"
                            Foreground="White" FontWeight="SemiBold" Cursor="Hand" FontSize="12"
                            Style="{StaticResource CompactIconButtonStyle}"
                            Tag="{StaticResource Icon.Refresh}">
                        <TextBlock x:Name="RefreshText" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                    </Button>
                    <Button x:Name="ImportBtn" Width="120" Height="34" Click="ImportButton_Click" Margin="0,0,8,0" Padding="8,6"
                            Background="{DynamicResource PrimaryButtonBrush}"
                            Foreground="White" FontWeight="SemiBold" Cursor="Hand" FontSize="12"
                            Style="{StaticResource CompactIconButtonStyle}"
                            Tag="{StaticResource Icon.Download}">
                        <TextBlock x:Name="ImportText" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                    </Button>
                    <StackPanel Orientation="Vertical" Margin="8,0,0,0">
                        <Button x:Name="BackButton" Width="120" Height="34" Padding="8,6"
                                Background="{DynamicResource PrimaryButtonBrush}"
                                Foreground="White" FontWeight="SemiBold" FontSize="12"
                                Click="BackToDashboard_Click" Cursor="Hand"
                                Style="{StaticResource CompactIconButtonStyle}"
                                Tag="{StaticResource Icon.Back}"
                                Content="Back"/>
                        <TextBlock x:Name="BackButtonText" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">Back</TextBlock>
                        <TextBlock x:Name="HeaderSelectionCounterText" 
                                   Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"
                                   TextAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area with Game Cards -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Game Cards Grid -->
            <Border Grid.Column="0" Background="{DynamicResource BackgroundBrush}" Margin="20,0,10,20" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                
                    <!-- Content Grid (Search Box + Game Cards) -->
                    <Grid Grid.Row="0" Grid.RowSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search Box -->
                        <Border Grid.Row="0" Background="{DynamicResource InputBackgroundBrush}" Padding="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- SearchBox -->
                            <TextBox Grid.Column="0" x:Name="SearchBox" Height="30"
                                     Background="{DynamicResource BackgroundBrush}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     CaretBrush="{DynamicResource ForegroundBrush}"
                                     Padding="8,2" FontSize="12"
                                     TextChanged="SearchBox_TextChanged"
                                     GotFocus="SearchBox_GotFocus"
                                     LostFocus="SearchBox_LostFocus"
                                     BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                     VerticalAlignment="Center"/>

                            <!-- Category Filter -->
                            <ComboBox Grid.Column="1" x:Name="CategoryFilterComboBox" MinWidth="180" MaxWidth="260" Height="32"
                                      Style="{StaticResource ManifestComboBoxStyle}"
                                      VerticalAlignment="Center" Margin="8,0,0,0"
                                      SelectionChanged="CategoryFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="All" Tag="All" IsSelected="True"/>
                                <ComboBoxItem Content="Installed" Tag="Installed"/>
                                <ComboBoxItem Content="Not Installed" Tag="NotInstalled"/>
                            </ComboBox>
                             
                            <!-- Spacer -->
                            <Border Grid.Column="2"/>
                            
                            <!-- Backup Button -->
                                    <Button Grid.Column="3" x:Name="BackupBtn" Width="140" Height="32" Click="BackupSelected_Click" Margin="4,0,0,0" Padding="8,6"
                                    Visibility="Collapsed" VerticalAlignment="Center"
                                    	    Style="{StaticResource CompactIconButtonStyle}"
                                    Tag="{StaticResource Icon.Save}">
                                <TextBlock x:Name="BackupBtnText" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/>
                            </Button>
                            
                            <!-- Delete Button -->
                                <Button Grid.Column="4" x:Name="DeleteBtn" Width="140" Height="32" Click="DeleteSelected_Click" Margin="4,0,0,0" Padding="8,6"
                                    Foreground="White" FontWeight="SemiBold" Cursor="Hand" FontSize="11"
                                    	    Visibility="Collapsed" VerticalAlignment="Center"
                                    	    Style="{StaticResource CompactIconButtonStyle}"
                                    Tag="{StaticResource Icon.Delete}"
                                    Content="Delete"/>
                            
                            <!-- Clear All Button -->
                                <Button Grid.Column="5" x:Name="ClearAllBtn" Width="120" Height="32" Click="ClearAll_Click" Margin="4,0,0,0" Padding="8,6"
                                    Background="{DynamicResource BorderBrush}"
                                    Foreground="White" FontWeight="SemiBold" Cursor="Hand" FontSize="11"
                                    	    Visibility="Collapsed" VerticalAlignment="Center"
                                    	    Style="{StaticResource CompactIconButtonStyle}"
                                    Tag="{StaticResource Icon.Cancel}"
                                    Content="Clear"/>
                        </Grid>
                    </Border>

                    <!-- Game Cards -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="CardsScrollViewer">
                        <ItemsControl x:Name="GameCards" ItemsSource="{Binding Games}" Margin="16,16,16,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid x:Name="CardGrid" IsItemsHost="True" Columns="3" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GameCardStyle}" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MouseLeftButtonUp="GameCard_MouseLeftButtonUp" Cursor="Hand">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="180"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Image area -->
                                            <Border Grid.Row="0" Background="{DynamicResource BorderBrush}" CornerRadius="8,8,0,0" Margin="0,0,0,8">
                                                <Grid>
                                                    <!-- Screenshot if available -->
                                                    <Image x:Name="CardImage" Source="{Binding ScreenshotUrl}" Stretch="UniformToFill" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ScreenshotUrl}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ScreenshotUrl}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>

                                                    <!-- Placeholder -->
                                                    <Grid x:Name="Placeholder" Background="{DynamicResource BackgroundBrush}" Opacity="0.5">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ScreenshotUrl}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ScreenshotUrl}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                    </Grid>

                                                    <!-- Selection checkbox overlay -->
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Width="24" Height="24"
                                                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                              Checked="ItemCheckBox_Changed" Unchecked="ItemCheckBox_Changed"/>

                                                    <!-- Installed badge -->
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" CornerRadius="4" Padding="6,3" Background="{DynamicResource SuccessButtonBrush}" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="11">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource InstalledBadgeTextConverter}">
                                                                    <Binding Path="IsInstalled"/>
                                                                    <Binding Path="InstallationPath"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Game Info -->
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="12,8,12,8" MinHeight="60">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ForegroundBrush}"/>
                                                <TextBlock Text="{Binding Genre}" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ForegroundBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>
                    
                    <!-- Delete Progress Overlay (on top of content) -->
                    <Grid x:Name="DeleteProgressOverlay" Visibility="Collapsed" Background="#88000000" Grid.Row="0" Grid.RowSpan="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                            <!-- Progress Box -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="24" 
                                    Effect="{DynamicResource DropShadow}"
                                    BorderBrush="{DynamicResource DangerButtonBrush}" BorderThickness="2">
                                <StackPanel>
                                    <!-- Title -->
                                    <TextBlock x:Name="DeleteProgressTitle" 
                                               Text="Deleting Games..."
                                               FontSize="18" FontWeight="Bold" 
                                               Foreground="{DynamicResource DangerButtonBrush}"
                                               TextAlignment="Center" Margin="0,0,0,12"/>
                                    
                                    <!-- Progress Bar -->
                                    <ProgressBar x:Name="DeleteProgressBar" Height="6" 
                                                 Background="{DynamicResource BorderBrush}"
                                                 Foreground="{DynamicResource DangerButtonBrush}"
                                                 IsIndeterminate="True" Margin="0,0,0,12"/>
                                    
                                    <!-- Status Text -->
                                    <TextBlock x:Name="DeleteProgressStatus"
                                               Text="Processing..."
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                    
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Import Progress Overlay (sibling to DeleteProgressOverlay) -->
                    <Grid x:Name="ImportProgressOverlay" Visibility="Collapsed" Background="#88000000" Grid.Row="0" Grid.RowSpan="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                            <!-- Progress Box -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="24" 
                                    Effect="{DynamicResource DropShadow}"
                                    BorderBrush="{DynamicResource SuccessButtonBrush}" BorderThickness="2">
                                <StackPanel>
                                    <!-- Title -->
                                    <TextBlock x:Name="ImportProgressTitle" 
                                               Text="Importing Games..."
                                               FontSize="18" FontWeight="Bold" 
                                               Foreground="{DynamicResource SuccessButtonBrush}"
                                               TextAlignment="Center" Margin="0,0,0,12"/>

                                    <!-- Progress Bar -->
                                    <ProgressBar x:Name="ImportProgressBar" Height="6" 
                                                 Background="{DynamicResource BorderBrush}"
                                                 Foreground="{DynamicResource SuccessButtonBrush}"
                                                 IsIndeterminate="True" Margin="0,0,0,12"/>

                                    <!-- Status Text -->
                                    <TextBlock x:Name="ImportProgressStatus"
                                               Text="Processing..."
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Activity log panel removed (no longer needed) -->
        </Grid>
    </Grid>
</UserControl>
