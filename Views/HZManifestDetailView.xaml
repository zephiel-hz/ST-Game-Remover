<UserControl x:Class="SteamPluginManager.Views.HZManifestDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <!-- Settings Button Template -->
        <ControlTemplate x:Key="SettingsButtonTemplate" TargetType="Button">
            <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource ButtonIconBackground}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{TemplateBinding Tag}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" FontSize="12" FontFamily="Segoe MDL2 Assets"/>
                    </Border>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                    <Setter TargetName="root" Property="Opacity" Value="0.95"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="root" Property="Opacity" Value="0.6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Loading Animation -->
        <Storyboard x:Key="SpinAnimation">
            <DoubleAnimation Storyboard.TargetName="LoadingSpinner"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1.5" RepeatBehavior="Forever"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Progress Overlay -->
        <Grid x:Name="ProgressOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">
                <!-- Progress Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="24" Effect="{DynamicResource DropShadowEffect}">
                    <StackPanel>
                        <!-- Title -->
                        <TextBlock x:Name="ProgressTitle" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,12" Text="Adding to Library..."/>
                        
                        <!-- Status Text -->
                        <TextBlock x:Name="ProgressStatus" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,16" TextWrapping="Wrap" Text="Initializing..."/>
                        
                        <!-- Progress Bar -->
                        <ProgressBar x:Name="ProgressBar" Height="6" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource SuccessButtonBrush}" Margin="0,0,0,12" IsIndeterminate="True"/>
                        
                        <!-- Step Indicator -->
                        <StackPanel x:Name="StepsPanel" Margin="0,0,0,0">
                            <!-- Step 1 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="Step1Icon" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="&#xE7BA;" Margin="0,0,8,0"/>
                                <TextBlock x:Name="Step1Text" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Text="Verifying file availability..."/>
                            </StackPanel>
                            
                            <!-- Step 2 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="Step2Icon" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="&#xE7BA;" Margin="0,0,8,0"/>
                                <TextBlock x:Name="Step2Text" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Text="Downloading file..."/>
                            </StackPanel>
                            
                            <!-- Step 3 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="Step3Icon" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="&#xE7BA;" Margin="0,0,8,0"/>
                                <TextBlock x:Name="Step3Text" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Text="Extracting files..."/>
                            </StackPanel>
                            
                            <!-- Step 4 -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Step4Icon" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="&#xE7BA;" Margin="0,0,8,0"/>
                                <TextBlock x:Name="Step4Text" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Text="Moving to library..."/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Result Notification (Hidden by default) -->
                        <Border x:Name="ResultNotification" Visibility="Collapsed" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16" Margin="0,16,0,0" BorderBrush="{DynamicResource SuccessButtonBrush}" BorderThickness="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ResultIcon" FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE73E;" Foreground="{DynamicResource SuccessButtonBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ResultMessage" FontSize="12" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" Padding="24,20,24,20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailTitle" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock x:Name="DetailSubtitle" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Right: Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Add to Library Button -->
                    <Button x:Name="AddToLibraryButton" Width="130" Height="38" Padding="8,6" Margin="0,0,12,0"
                            Background="{DynamicResource SuccessButtonBrush}"
                            Foreground="White" FontWeight="SemiBold"
                            Click="AddToLibrary_Click" Cursor="Hand" FontSize="11"
                            BorderThickness="0"
                            Template="{StaticResource SettingsButtonTemplate}" Tag="{StaticResource Icon.Plus}">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="Add to Library"/>
                    </Button>

                    <!-- Delete Files Button -->
                    <Button x:Name="DeleteFilesButton" Width="120" Height="38" Padding="8,6" Margin="0,0,12,0"
                            Background="{DynamicResource DangerButtonBrush}"
                            Foreground="White" FontWeight="SemiBold"
                            Click="DeleteFiles_Click" Cursor="Hand" FontSize="11"
                            BorderThickness="0"
                            Template="{StaticResource SettingsButtonTemplate}" Tag="{StaticResource Icon.Delete}"
                            ToolTip="Delete current game's lua and manifest files">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="Delete Files"/>
                    </Button>

                    <!-- Restart Steam Button -->
                    <Button x:Name="RestartSteamButton" Width="120" Height="38" Padding="8,6" Margin="0,0,12,0"
                            Background="{DynamicResource WarningButtonBrush}"
                            Foreground="White" FontWeight="SemiBold"
                            Click="RestartSteam_Click" Cursor="Hand" FontSize="11"
                            BorderThickness="0"
                            Template="{StaticResource SettingsButtonTemplate}" Tag="&#xE777;"
                            ToolTip="Restart Steam to apply changes">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="Restart Steam"/>
                    </Button>

                    <!-- Back Button -->
                    <Button x:Name="BackButton" Width="90" Height="38" Padding="8,6"
                            Background="{DynamicResource PrimaryButtonBrush}"
                            Foreground="White" FontWeight="SemiBold"
                            Click="BackToDashboard_Click" Cursor="Hand" FontSize="11"
                            BorderThickness="0"
                            Template="{StaticResource SettingsButtonTemplate}" Tag="{StaticResource Icon.Back}">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="Back"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,30,30,30">
                <!-- Landscape Banner Image -->
                <Border x:Name="ThumbnailBorder"
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="18"
                        Margin="0,0,0,24"
                        HorizontalAlignment="Stretch"
                        SnapsToDevicePixels="True"
                        MinHeight="280">
                    <Grid ClipToBounds="True">
                        <Image x:Name="GameThumbnail"
                               Stretch="UniformToFill"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Stretch"
                               MaxHeight="340"/>
                        <Rectangle HorizontalAlignment="Stretch"
                                   VerticalAlignment="Bottom"
                                   Height="140"
                                   IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#22000000" Offset="0.45"/>
                                    <GradientStop Color="#99000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Border>


                <!-- Game Name (Title) -->
                <TextBlock x:Name="GameNameDetail" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>

                <!-- Genre and Download Count -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}">
                        <Run Text="Genre: "/>
                    </TextBlock>
                    <TextBlock x:Name="GenreDetail" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0,0,0"/>
                </StackPanel>

                <Border Background="{DynamicResource SuccessButtonBrush}" CornerRadius="12" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,20">
                    <TextBlock x:Name="DownloadCountDetailText" Text="Downloads: 0" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                </Border>

                <!-- Separator -->
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,20"/>

                <!-- Description -->
                <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8">
                    <Run Text="Description"/>
                </TextBlock>
                <TextBlock x:Name="DescriptionDetail" FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,24" TextWrapping="Wrap" LineHeight="18"/>

                <!-- Separator -->
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,20"/>

                <!-- DLC List -->
                <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8">
                    <Run Text="DLC Included"/>
                </TextBlock>
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,20" HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock x:Name="DlcStatusText" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,12" Visibility="Collapsed" />
                        <ItemsControl x:Name="DlcPreviewItemsControl" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding AppId, StringFormat='AppID: {0}'}" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="ShowMoreDlcButton" Content="Show more" Click="ShowMoreDlcButton_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,10" Background="{DynamicResource PrimaryButtonBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryButtonBrush}" BorderThickness="1" FontSize="12" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" Opacity="0.12" ShadowDepth="2"/>
                            </Button.Effect>
                        </Button>
                        <TextBlock x:Name="DlcEmptyText" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Text="No DLC items available." Visibility="Collapsed" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Separator -->
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,20"/>

                <!-- System Requirements Section -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Minimum Requirements -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8">
                            <Run Text="Minimum Requirements"/>
                        </TextBlock>
                        <Border x:Name="MinRequirementsBorder" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Visibility="Collapsed">
                            <TextBlock x:Name="MinimumRequirementsDetail" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" LineHeight="16"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MinRequirementsStatusIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock x:Name="MinRequirementsStatusText" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="MinRequirementsEmpty" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Text="No information available" Visibility="Visible"/>
                    </StackPanel>

                    <!-- Recommended Requirements -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8">
                            <Run Text="Recommended Requirements"/>
                        </TextBlock>
                        <Border x:Name="RecRequirementsBorder" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Visibility="Collapsed">
                            <TextBlock x:Name="RecommendedRequirementsDetail" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" LineHeight="16"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="RecRequirementsStatusIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock x:Name="RecRequirementsStatusText" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="RecRequirementsEmpty" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Text="No information available" Visibility="Visible"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
