<UserControl x:Class="SteamPluginManager.Views.HZManifestDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}"
             SizeChanged="HZManifestDetailView_SizeChanged">
    <UserControl.Resources>
        <!-- Modern Rounded Button Style -->
        <Style x:Key="DetailButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Loading Animation -->
        <Storyboard x:Key="SpinAnimation">
            <DoubleAnimation Storyboard.TargetName="LoadingSpinner"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1.5" RepeatBehavior="Forever"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>



        <!-- Modern Adaptive Header Section -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="16,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid MaxWidth="1050" HorizontalAlignment="Center">
                <!-- Responsive Action Buttons Bar -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Add to Library Button (Primary Accent) -->
                    <Button x:Name="AddToLibraryButton"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,6,6"
                            Background="{DynamicResource SuccessButtonBrush}"
                            BorderThickness="0"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="11.5"
                            Style="{StaticResource DetailButtonStyle}"
                            Click="AddToLibrary_Click"
                            ToolTip="Install and unlock this manifest in Steam">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AddToLibraryButtonText" Text="Add to Library" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Delete Files Button -->
                    <Button x:Name="DeleteFilesButton"
                            Height="34"
                            Padding="10,0"
                            Margin="0,0,6,6"
                            Background="{DynamicResource DangerButtonBrush}"
                            BorderThickness="0"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="11.5"
                            Style="{StaticResource DetailButtonStyle}"
                            Click="DeleteFiles_Click"
                            ToolTip="Delete current game's lua and manifest files">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Delete Files" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Restart Steam Button -->
                    <Button x:Name="RestartSteamButton"
                            Height="34"
                            Padding="10,0"
                            Margin="0,0,6,6"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource ForegroundBrush}"
                            FontWeight="SemiBold"
                            FontSize="11.5"
                            Style="{StaticResource DetailButtonStyle}"
                            Click="RestartSteam_Click"
                            ToolTip="Restart Steam to apply changes">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Restart Steam" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Main Content Area with Adaptive Padding -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel x:Name="MainContentStackPanel" Margin="16,14,16,20" MaxWidth="1050" HorizontalAlignment="Center">
                <!-- Landscape Hero Banner -->
                <Border x:Name="ThumbnailBorder"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Margin="0,0,0,14"
                        HorizontalAlignment="Stretch"
                        SnapsToDevicePixels="True"
                        MinHeight="150"
                        ClipToBounds="True">
                    <Grid ClipToBounds="True">
                        <Image x:Name="GameThumbnail"
                               Stretch="UniformToFill"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Stretch"
                               MaxHeight="260"/>
                        <Rectangle HorizontalAlignment="Stretch"
                                   VerticalAlignment="Bottom"
                                   Height="90"
                                   IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#660A0D14" Offset="0.5"/>
                                    <GradientStop Color="#EE0A0D14" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Border>

                <!-- Game Header Info Card -->
                <Border Style="{StaticResource DetailSectionCard}">
                    <StackPanel>
                        <!-- Game Title -->
                        <TextBlock x:Name="GameNameDetail" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <!-- Tags Row -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <!-- Genre Badge -->
                            <Border Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7,3" Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Genre: " FontSize="10.5" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="GenreDetail" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Download Count Badge -->
                            <Border Background="#2010B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="6" Padding="7,3" Margin="0,0,0,4">
                                <TextBlock x:Name="DownloadCountDetailText" Text="Downloads: 0" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessButtonBrush}"/>
                            </Border>
                        </WrapPanel>

                        <!-- Description -->
                        <TextBlock Text="ABOUT THIS GAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="DescriptionDetail" FontSize="12" Foreground="{DynamicResource ForegroundBrush}" Opacity="0.9" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </Border>

                <!-- DLC List Section -->
                <Border Style="{StaticResource DetailSectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="DLC Included" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="DlcStatusText" FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,8" Visibility="Collapsed" />
                        
                        <ItemsControl x:Name="DlcPreviewItemsControl" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Grid.Column="1" Background="{DynamicResource ButtonBackgroundBrush}" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AppId, StringFormat='ID: {0}'}" FontSize="9.5" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="ShowMoreDlcButton" Content="Show More DLCs" Click="ShowMoreDlcButton_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,6" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Style="{StaticResource DetailButtonStyle}"/>
                        <TextBlock x:Name="DlcEmptyText" FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" Text="No DLC items available for this title." Visibility="Collapsed" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Adaptive System Requirements Section -->
                <Grid x:Name="SystemRequirementsGrid" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Minimum Requirements -->
                    <Border x:Name="MinRequirementsCard" Grid.Column="0" Style="{StaticResource DetailSectionCard}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Minimum Requirements" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8"/>
                            <Border x:Name="MinRequirementsBorder" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Visibility="Collapsed">
                                <TextBlock x:Name="MinimumRequirementsDetail" FontSize="11" Foreground="{DynamicResource ForegroundBrush}" Opacity="0.9" TextWrapping="Wrap" LineHeight="16"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MinRequirementsStatusIcon" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MinRequirementsStatusText" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="MinRequirementsEmpty" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Text="No information available" Visibility="Visible"/>
                        </StackPanel>
                    </Border>

                    <!-- Recommended Requirements -->
                    <Border x:Name="RecRequirementsCard" Grid.Column="1" Style="{StaticResource DetailSectionCard}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Recommended Requirements" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8"/>
                            <Border x:Name="RecRequirementsBorder" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Visibility="Collapsed">
                                <TextBlock x:Name="RecommendedRequirementsDetail" FontSize="11" Foreground="{DynamicResource ForegroundBrush}" Opacity="0.9" TextWrapping="Wrap" LineHeight="16"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="RecRequirementsStatusIcon" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RecRequirementsStatusText" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="RecRequirementsEmpty" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Text="No information available" Visibility="Visible"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
