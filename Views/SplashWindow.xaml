<Window x:Class="SteamPluginManager.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HZ Lua Manager"
        Width="440"
        Height="260"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Storyboard x:Key="IntroStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.35" />
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                             From="0.96"
                             To="1"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                             From="0.96"
                             To="1"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25"
                             To="0.65"
                             Duration="0:0:1.2"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootGrid" Opacity="0">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
        </Grid.RenderTransform>

        <!-- Ambient Backdrop Shadow & Card Wrapper -->
        <Border Margin="14"
                CornerRadius="22"
                Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="10" Color="#000000" Opacity="0.5" />
            </Border.Effect>

            <Grid>
                <!-- Top Accent Highlight Line -->
                <Border Height="2.5" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top"/>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                    <!-- Brand Icon with Ambient Aura -->
                    <Grid Width="70" Height="70" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <!-- Breathing Ambient Glow -->
                        <Ellipse x:Name="LogoGlow"
                                 Width="68"
                                 Height="68"
                                 Fill="{DynamicResource AccentBrush}"
                                 Opacity="0.25"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <BlurEffect Radius="30"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Sleek Rounded Tile -->
                        <Border Width="56"
                                Height="56"
                                CornerRadius="16"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Image x:Name="LogoImage"
                                   Width="32"
                                   Height="32"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform">
                                <Image.Source>
                                    <BitmapImage UriSource="/Config/SGR.ico" CacheOption="OnLoad" />
                                </Image.Source>
                            </Image>
                        </Border>
                    </Grid>

                    <!-- App Title Typography -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="HZ " FontSize="17" FontWeight="Black" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="LUA MANAGER" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>

                    <!-- Subtitle / Status Text -->
                    <TextBlock Text="Starting application..."
                               FontSize="11.5"
                               FontWeight="Normal"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <!-- Ultra-Sleek Minimalist Hairline Progress Bar -->
                    <Border Width="280"
                            Height="3"
                            CornerRadius="1.5"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderThickness="0"
                            ClipToBounds="True"
                            HorizontalAlignment="Center">
                        <ProgressBar x:Name="SplashProgress"
                                     Height="3"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     IsIndeterminate="False"
                                     Background="Transparent"
                                     Foreground="{DynamicResource AccentBrush}"
                                     BorderThickness="0"/>
                    </Border>

                    <!-- Clean Version Footer -->
                    <TextBlock x:Name="SplashVersionText"
                               Text="Ready to Launch"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Opacity="0.6"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
