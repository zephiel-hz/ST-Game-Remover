<UserControl x:Class="SteamPluginManager.Views.DevView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Dev Theme Brushes -->
        <SolidColorBrush x:Key="DevPinkBrush" Color="#EC4899"/>
        <SolidColorBrush x:Key="DevPinkGlowBrush" Color="#26EC4899"/>
        <SolidColorBrush x:Key="DevCardSurfaceBrush" Color="#131926"/>
        <SolidColorBrush x:Key="DevBorderBrush" Color="#222A3B"/>
        <SolidColorBrush x:Key="DevTerminalBrush" Color="#080C14"/>

        <!-- Modern Button Base -->
        <Style x:Key="DevButtonBase" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Pink Button -->
        <Style x:Key="DevPrimaryButton" TargetType="Button" BasedOn="{StaticResource DevButtonBase}">
            <Setter Property="Background" Value="#EC4899"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Secondary Outline Button -->
        <Style x:Key="DevSecondaryButton" TargetType="Button" BasedOn="{StaticResource DevButtonBase}">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <!-- Danger Red Button -->
        <Style x:Key="DevDangerButton" TargetType="Button" BasedOn="{StaticResource DevButtonBase}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Compact Action Button for Tables -->
        <Style x:Key="DevTableActionButton" TargetType="Button" BasedOn="{StaticResource DevButtonBase}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style x:Key="DevTableDangerButton" TargetType="Button" BasedOn="{StaticResource DevTableActionButton}">
            <Setter Property="Background" Value="#3B1219"/>
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="BorderBrush" Value="#7F1D1D"/>
        </Style>

        <!-- DataGrid Header & Cell Styles -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="0,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Tab Navigation Header Style -->
        <Style x:Key="DevModernTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2.5"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,4,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="contentPresenter"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#121826"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#EC4899"/>
                                <Setter TargetName="tabBorder" Property="Background" Value="#181528"/>
                                <Setter Property="Foreground" Value="#EC4899"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Premium Admin Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18,14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="11" Background="#261022" BorderBrush="#EC4899" BorderThickness="1.5" Margin="0,0,14,0">
                        <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#EC4899" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Developer &amp; Admin Console" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                            <Border Background="#33EC4899" BorderBrush="#EC4899" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="10,0,0,0">
                                <TextBlock Text="ADMIN LEVEL 0" FontSize="9.5" FontWeight="Bold" Foreground="#EC4899"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Control center for game catalog, token revocation, hardware bans, role management, and system diagnostics."
                                   FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshAllButton" Style="{StaticResource DevSecondaryButton}" Click="RefreshAllButton_Click" ToolTip="Reload all console datasets">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh Dataset" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Controls (7 Standalone Tabs) -->
        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource DevModernTabItem}">

            <!-- TAB 1: GAME CATALOG & BATCH PURGE -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Game Catalog &amp; Purge" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search Bar & Multi-Select Action Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GameSearchTextBox"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="32,8,12,8"
                                     FontSize="12"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     TextChanged="GameSearchTextBox_TextChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="Search game title or AppID..."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       FontSize="12"
                                       Margin="34,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=GameSearchTextBox, Converter={StaticResource BoolToVis}}"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="Select All" Style="{StaticResource DevSecondaryButton}" Margin="0,0,6,0" Click="SelectAllGames_Click"/>
                                <Button Content="Deselect All" Style="{StaticResource DevSecondaryButton}" Margin="0,0,6,0" Click="DeselectAllGames_Click"/>
                                <Button Content="Reload" Style="{StaticResource DevSecondaryButton}" Click="ReloadGames_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Games List DataGrid (Multi-Select Enabled) -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
                        <DataGrid x:Name="GamesDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  CanUserResizeRows="False"
                                  RowHeaderWidth="0">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="GamesDataGrid_Row_PreviewMouseLeftButtonDown"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E1B2E"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#2A1B36"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!-- Checkbox Column for Multi-select -->
                                <DataGridTemplateColumn Width="45">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Select" FontSize="11" HorizontalAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Click="GameSelectionCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="AppID" Binding="{Binding AppId}" Width="90" FontWeight="Bold" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Game Title" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="160" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Storage Type" Binding="{Binding StorageType}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Folder Path" Binding="{Binding FolderPath}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Uploaded Date" Binding="{Binding UploadDate}" Width="130" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Purge Explanation & Selective Execution Card -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Selection Summary -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Purge Target:" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="SelectedGamesCountLabel" Text="0 Games Selected" FontSize="13" Foreground="#EC4899" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Clear & Informative 4 Component Checkboxes -->
                            <Grid Grid.Row="1" Margin="0,12,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 1 -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <Border Background="#131B2A" BorderBrush="#26344B" BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="PurgeDbCatalogCard_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="PurgeDbCatalogCheck" IsChecked="True" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="🗄️ Database Catalog" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC"/>
                                                <TextBlock Text="Deletes game metadata records from 'hzmanifest_files' &amp; 'games_dlc' tables in Supabase." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Background="#131B2A" BorderBrush="#26344B" BorderThickness="1" CornerRadius="9" Padding="14,12" Cursor="Hand" MouseLeftButtonDown="PurgeSupabaseStorageCard_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="PurgeSupabaseStorageCheck" IsChecked="True" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="☁️ Supabase Storage (Manifest/Lua Files)" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC"/>
                                                <TextBlock Text="Deletes all manifest and lua script files in cloud storage folder '{appId}/'." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Column 2 -->
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <Border Background="#131B2A" BorderBrush="#26344B" BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="PurgeOnlineFixCard_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="PurgeOnlineFixCheck" IsChecked="False" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="📦 Backblaze B2 (Online-Fix Archive)" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC"/>
                                                <TextBlock Text="Deletes multiplayer patch archive 'onlinefix/{appId}.zip' from Backblaze B2." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Background="#131B2A" BorderBrush="#26344B" BorderThickness="1" CornerRadius="9" Padding="14,12" Cursor="Hand" MouseLeftButtonDown="PurgeGameBypassCard_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="PurgeGameBypassCheck" IsChecked="False" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="🚀 Cloudflare R2 (Game Bypass Archive)" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC"/>
                                                <TextBlock Text="Deletes bypass installer archive 'gamebypass/{appId}.zip' from Cloudflare R2." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Action Button Row -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PurgeStatusText" Text="Select one or more games above, then choose the components to purge." FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="ExecutePurgeButton" Style="{StaticResource DevDangerButton}" IsEnabled="False" Click="ExecutePurgeButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="EXECUTE PURGE SELECTED GAMES" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: TOKEN MANAGEMENT & REVOCATION -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Token Management &amp; Revoke" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TokenSearchTextBox"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="32,8,12,8"
                                     FontSize="12"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     TextChanged="TokenSearchTextBox_TextChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="Search by token key or user display name..."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       FontSize="12"
                                       Margin="34,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=TokenSearchTextBox, Converter={StaticResource BoolToVis}}"/>
                            <Button Grid.Column="1" Content="Reload Tokens" Style="{StaticResource DevSecondaryButton}" Margin="8,0,0,0" Click="ReloadTokens_Click"/>
                        </Grid>
                    </Border>

                    <!-- Tokens List DataGrid -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
                        <DataGrid x:Name="TokensDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  CanUserResizeRows="False"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Token Key" Binding="{Binding Token}" Width="220" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Connected Users (Display Names)" Binding="{Binding DisplayNames}" Width="*"/>
                                <DataGridTextColumn Header="Device Slot" Binding="{Binding DeviceCountText}" Width="120"/>
                                <DataGridTemplateColumn Header="Status" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#102A1A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Background" Value="#381014"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusBadge}" FontSize="10.5" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#34D399"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Verified At" Binding="{Binding VerifiedAt}" Width="140"/>
                                <DataGridTemplateColumn Header="Action" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Revoke / Activate" Style="{StaticResource DevTableActionButton}" Click="ToggleTokenActive_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: HARDWARE BANS & DEVICE UNBIND -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Hardware Bans &amp; Unbind" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DeviceSearchTextBox"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="32,8,12,8"
                                     FontSize="12"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     TextChanged="DeviceSearchTextBox_TextChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="Search by Display Name, Device ID, or Token..."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       FontSize="12"
                                       Margin="34,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=DeviceSearchTextBox, Converter={StaticResource BoolToVis}}"/>
                            <Button Grid.Column="1" Content="Reload Devices" Style="{StaticResource DevSecondaryButton}" Margin="8,0,0,0" Click="ReloadDevices_Click"/>
                        </Grid>
                    </Border>

                    <!-- Active Devices List DataGrid -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
                        <DataGrid x:Name="DevicesDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  CanUserResizeRows="False"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="150" MinWidth="130" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Hardware Device ID" Binding="{Binding DeviceId}" Width="180" MinWidth="160"/>
                                <DataGridTextColumn Header="Assigned Token" Binding="{Binding Token}" Width="130" MinWidth="110"/>
                                <DataGridTextColumn Header="Slot" Binding="{Binding SlotName}" Width="75" MinWidth="60"/>
                                <DataGridTemplateColumn Header="Actions" Width="*" MinWidth="215">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Unbind Device" Style="{StaticResource DevTableActionButton}" Margin="0,0,6,0" Click="UnbindDeviceItem_Click"/>
                                                <Button Content="⛔ Ban Hardware" Style="{StaticResource DevTableDangerButton}" Click="BanDeviceItem_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Blocked Hardware Section Title -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,8" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Permanently Blocked Devices (Hardware Blacklist)" FontWeight="Bold" FontSize="13" Foreground="#EF4444"/>
                        <TextBlock Text="— These devices are completely blocked from using the app or binding tokens." FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Blocked Hardware Table -->
                    <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
                        <DataGrid x:Name="BlockedDevicesDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  CanUserResizeRows="False"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hardware ID" Binding="{Binding DeviceId}" Width="250" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Block Reason" Binding="{Binding Reason}" Width="*"/>
                                <DataGridTextColumn Header="Blocked By" Binding="{Binding BlockedBy}" Width="130"/>
                                <DataGridTextColumn Header="Blocked Date" Binding="{Binding CreatedAt}" Width="140"/>
                                <DataGridTemplateColumn Header="Action" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🔓 Unblock" Style="{StaticResource DevTableActionButton}" Click="UnblockDevice_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: USER ROLES & PROFILES -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="User Roles &amp; Profiles" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UserSearchTextBox"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="32,8,12,8"
                                     FontSize="12"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     TextChanged="UserSearchTextBox_TextChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="Search user by Display Name, Device ID, or Bio..."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       FontSize="12"
                                       Margin="34,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=UserSearchTextBox, Converter={StaticResource BoolToVis}}"/>
                            <Button Grid.Column="1" Content="Reload Users" Style="{StaticResource DevSecondaryButton}" Margin="8,0,0,0" Click="ReloadUsers_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
                        <DataGrid x:Name="UsersDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionChanged="UsersDataGrid_SelectionChanged"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  CanUserResizeRows="False"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="UID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="160" FontWeight="Bold"/>
                                <DataGridTemplateColumn Header="Role Badge" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1F2937"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="0">
                                                                <Setter Property="Background" Value="#450A0A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="3">
                                                                <Setter Property="Background" Value="#172554"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="1">
                                                                <Setter Property="Background" Value="#064E3B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="2">
                                                                <Setter Property="Background" Value="#1F2937"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="0">
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="3">
                                                                    <Setter Property="Foreground" Value="#3B82F6"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="1">
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="2">
                                                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceId}" Width="180"/>
                                <DataGridTextColumn Header="Bio" Binding="{Binding Bio}" Width="*"/>
                                <DataGridTextColumn Header="Last Activity" Binding="{Binding CreatedAt}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Role Edit Action Panel -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Change Role:" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <ComboBox Grid.Column="1" x:Name="RoleLevelComboBox" Height="36" VerticalContentAlignment="Center" FontSize="12">
                                <ComboBoxItem Content="0 - ADMIN" Tag="0"/>
                                <ComboBoxItem Content="3 - MODERATOR" Tag="3"/>
                                <ComboBoxItem Content="1 - SUPPORTER" Tag="1"/>
                                <ComboBoxItem Content="2 - MEMBER" Tag="2" IsSelected="True"/>
                            </ComboBox>

                            <Button Grid.Column="2" x:Name="UpdateRoleButton" Content="Save Role" Style="{StaticResource DevPrimaryButton}" Margin="10,0,0,0" Click="UpdateRoleButton_Click"/>

                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <Button Content="Reset Avatar to Default" Style="{StaticResource DevSecondaryButton}" Margin="0,0,8,0" Click="ResetUserAvatar_Click"/>
                                <Button Content="Clear Bio" Style="{StaticResource DevSecondaryButton}" Click="ClearUserBio_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: STORAGE EXPLORER -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Storage Explorer" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Storage Maintenance &amp; Orphan Files" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="Scan Backblaze B2 and Cloudflare R2 for orphan files with no corresponding database entry." FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Clear Local Avatar Cache" Style="{StaticResource DevSecondaryButton}" Margin="0,0,8,0" Click="ClearAvatarDiskCache_Click"/>
                                <Button Content="Scan Orphan Storage" Style="{StaticResource DevPrimaryButton}" Click="ScanOrphanStorage_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource DevTerminalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <TextBox x:Name="StorageLogsTextBox"
                                 Background="Transparent"
                                 Foreground="#34D399"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Text="Click 'Scan Orphan Storage' to analyze Backblaze B2, Cloudflare R2, and Supabase Storage."/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 6: BROADCAST -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEC42;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Pinned Announcement" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- CARD 1: ACTIVE PINNED ANNOUNCEMENT STATUS -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Current Active Pinned Announcement" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="This announcement is currently pinned at the top of Community Chat for all users." FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="RefreshBroadcastBtn" Content="Refresh" Style="{StaticResource DevSecondaryButton}" Margin="0,0,8,0" Click="RefreshBroadcast_Click"/>
                                    <Button x:Name="DeleteBroadcastBtn" Content="🗑️ Delete / Unpin Announcement" Style="{StaticResource DevDangerButton}" Click="DeleteBroadcast_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Active Announcement Card Content -->
                            <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,14,0,0">
                                <Grid>
                                    <StackPanel x:Name="ActiveBroadcastPanel" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="#102A1A" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="PINNED ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                            </Border>
                                            <TextBlock x:Name="ActiveBroadcastTimeText" Text="Posted: 2026-10-02 08:00" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ActiveBroadcastTitleText" Text="📢 Title" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock x:Name="ActiveBroadcastMessageText" Text="Message body..." FontSize="12" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- No Broadcast State -->
                                    <TextBlock x:Name="NoActiveBroadcastText"
                                               Text="ℹ️ No pinned broadcast announcement is currently active."
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Visibility="Visible"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CARD 2: PUBLISH / UPDATE PINNED ANNOUNCEMENT -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                        <StackPanel MaxWidth="750" HorizontalAlignment="Left">
                            <TextBlock Text="Publish New Pinned Announcement" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="Publishing will instantly pin this message at the top of the chat and replace any previous announcement." FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,4,0,16"/>

                            <TextBlock Text="Announcement Title:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="BroadcastTitleInput" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Height="38" Text="📢 System Announcement"/>

                            <TextBlock Text="Message Content:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ForegroundBrush}" Margin="0,12,0,6"/>
                            <TextBox x:Name="BroadcastBodyInput" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Height="100" TextWrapping="Wrap" AcceptsReturn="True" Text="Scheduled maintenance or new game catalog updates are now available."/>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="📢 Publish &amp; Pin Announcement" Style="{StaticResource DevPrimaryButton}" Padding="20,10" Click="BroadcastMessage_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 7: DIAGNOSTICS -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE958;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Diagnostics &amp; Logs" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Live Service Health &amp; Latency Check" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock x:Name="DiagnosticsSummaryText" Text="Click 'Run Diagnostics' to test latency and connectivity for all cloud endpoints." FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Run Diagnostics" Style="{StaticResource DevPrimaryButton}" Click="RunDiagnostics_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource DevTerminalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="DiagnosticsConsoleTextBox"
                                     Background="Transparent"
                                     Foreground="#38BDF8"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Text="System diagnostic console ready."/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="Copy Logs" Style="{StaticResource DevSecondaryButton}" Margin="0,0,8,0" Click="CopyLogs_Click"/>
                                <Button Content="Clear Console" Style="{StaticResource DevSecondaryButton}" Click="ClearConsole_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
