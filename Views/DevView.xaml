<UserControl x:Class="SteamPluginManager.Views.DevView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Dev Theme Brushes -->
        <SolidColorBrush x:Key="DevPinkBrush" Color="#EC4899"/>
        <SolidColorBrush x:Key="DevPinkGlowBrush" Color="#26EC4899"/>
        <SolidColorBrush x:Key="DevCardSurfaceBrush" Color="#131926"/>
        <SolidColorBrush x:Key="DevBorderBrush" Color="#222A3B"/>
        <SolidColorBrush x:Key="DevTerminalBrush" Color="#080C14"/>

        <!-- Modern Button Base -->
        <Style x:Key="DevButtonBase" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Pink Button -->
        <Style x:Key="DevPrimaryButton" TargetType="Button" BasedOn="{StaticResource DevButtonBase}">
            <Setter Property="Background" Value="#EC4899"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Secondary Outline Button -->
        <Style x:Key="DevSecondaryButton" TargetType="Button" BasedOn="{StaticResource DevButtonBase}">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <!-- Danger Red Button -->
        <Style x:Key="DevDangerButton" TargetType="Button" BasedOn="{StaticResource DevButtonBase}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Compact Action Button for Tables -->
        <Style x:Key="DevTableActionButton" TargetType="Button" BasedOn="{StaticResource DevButtonBase}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style x:Key="DevTableDangerButton" TargetType="Button" BasedOn="{StaticResource DevTableActionButton}">
            <Setter Property="Background" Value="#3B1219"/>
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="BorderBrush" Value="#7F1D1D"/>
        </Style>

        <!-- Storage Category Pill RadioButton Style -->
        <Style x:Key="StorageCategoryPillStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="12,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PillBorder" Property="Background" Value="#1F283B"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#3B4B6C"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style for DevView -->
        <Style x:Key="DevComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid Background="Transparent">
                            <ToggleButton Name="DropDownToggle"
                                          Grid.Column="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Name="toggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Content="{TemplateBinding Content}"
                                                                  Margin="10,0,0,0"
                                                                  VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xE70D;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="9"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="toggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="toggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Name="contentPresenter"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            </ToggleButton>
                            <Popup Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   Margin="0,4,0,0">
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4">
                                    <ScrollViewer CanContentScroll="True"
                                                  MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                                                  MaxHeight="200">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DevComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Header & Cell Styles -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="0,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Tab Navigation Header Style -->
        <Style x:Key="DevModernTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2.5"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,4,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="contentPresenter"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#121826"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#EC4899"/>
                                <Setter TargetName="tabBorder" Property="Background" Value="#181528"/>
                                <Setter Property="Foreground" Value="#EC4899"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Premium Admin Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18,14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="11" Background="#261022" BorderBrush="#EC4899" BorderThickness="1.5" Margin="0,0,14,0">
                        <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#EC4899" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Developer &amp; Admin Console" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                            <Border Background="#33EC4899" BorderBrush="#EC4899" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="10,0,0,0">
                                <TextBlock Text="ADMIN LEVEL 0" FontSize="9.5" FontWeight="Bold" Foreground="#EC4899"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Control center for game catalog, token revocation, hardware bans, role management, and system diagnostics."
                                   FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshAllButton" Style="{StaticResource DevSecondaryButton}" Click="RefreshAllButton_Click" ToolTip="Reload all console datasets">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh Dataset" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Controls (7 Standalone Tabs) -->
        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource DevModernTabItem}">

            <!-- TAB 1: GAME CATALOG & BATCH PURGE -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Game Catalog &amp; Purge" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search Bar & Multi-Select Action Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GameSearchTextBox"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="32,8,12,8"
                                     FontSize="12"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     TextChanged="GameSearchTextBox_TextChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="Search game title or AppID..."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       FontSize="12"
                                       Margin="34,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=GameSearchTextBox, Converter={StaticResource BoolToVis}}"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button x:Name="ReplaceLuaManifestButton"
                                        Style="{StaticResource DevPrimaryButton}"
                                        Height="34"
                                        Padding="12,0"
                                        Margin="0,0,6,0"
                                        Click="ReplaceLuaManifestButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Replace Lua &amp; Manifest" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Select All" Style="{StaticResource DevSecondaryButton}" Margin="0,0,6,0" Click="SelectAllGames_Click"/>
                                <Button Content="Deselect All" Style="{StaticResource DevSecondaryButton}" Margin="0,0,6,0" Click="DeselectAllGames_Click"/>
                                <Button Content="Reload" Style="{StaticResource DevSecondaryButton}" Click="ReloadGames_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Games List DataGrid (Multi-Select Enabled) -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
                        <DataGrid x:Name="GamesDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  CanUserResizeRows="False"
                                  RowHeaderWidth="0">
                            <DataGrid.ContextMenu>
                                <ContextMenu Background="#131926" BorderBrush="#253248" Foreground="#F8FAFC">
                                    <MenuItem Header="Replace Lua &amp; Manifest Files..." Click="GameRowReplaceLuaManifest_Click" Foreground="#F8FAFC">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#EC4899"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="GamesDataGrid_Row_PreviewMouseLeftButtonDown"/>
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="GamesDataGrid_Row_PreviewMouseRightButtonDown"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E1B2E"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#2A1B36"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!-- Checkbox Column for Multi-select -->
                                <DataGridTemplateColumn Width="45">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Select" FontSize="11" HorizontalAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Click="GameSelectionCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="AppID" Binding="{Binding AppId}" Width="90" FontWeight="Bold" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Game Title" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="160" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Storage Type" Binding="{Binding StorageType}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Folder Path" Binding="{Binding FolderPath}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Uploaded Date" Binding="{Binding UploadDate}" Width="130" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Purge Explanation & Selective Execution Card -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Selection Summary -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Purge Target:" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="SelectedGamesCountLabel" Text="0 Games Selected" FontSize="13" Foreground="#EC4899" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Clear & Informative 4 Component Checkboxes -->
                            <Grid Grid.Row="1" Margin="0,12,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 1 -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <Border Background="#131B2A" BorderBrush="#26344B" BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="PurgeDbCatalogCard_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="PurgeDbCatalogCheck" IsChecked="True" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="🗄️ Database Catalog" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC"/>
                                                <TextBlock Text="Deletes game metadata records from 'hzmanifest_files' &amp; 'games_dlc' tables in Supabase." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Background="#131B2A" BorderBrush="#26344B" BorderThickness="1" CornerRadius="9" Padding="14,12" Cursor="Hand" MouseLeftButtonDown="PurgeSupabaseStorageCard_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="PurgeSupabaseStorageCheck" IsChecked="True" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="☁️ Supabase Storage (Manifest/Lua Files)" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC"/>
                                                <TextBlock Text="Deletes all manifest and lua script files in cloud storage folder '{appId}/'." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Column 2 -->
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <Border Background="#131B2A" BorderBrush="#26344B" BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="PurgeOnlineFixCard_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="PurgeOnlineFixCheck" IsChecked="False" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="📦 Backblaze B2 (Online-Fix Archive)" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC"/>
                                                <TextBlock Text="Deletes multiplayer patch archive 'onlinefix/{appId}.zip' from Backblaze B2." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Background="#131B2A" BorderBrush="#26344B" BorderThickness="1" CornerRadius="9" Padding="14,12" Cursor="Hand" MouseLeftButtonDown="PurgeGameBypassCard_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="PurgeGameBypassCheck" IsChecked="False" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="🚀 Cloudflare R2 (Game Bypass Archive)" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC"/>
                                                <TextBlock Text="Deletes bypass installer archive 'gamebypass/{appId}.zip' from Cloudflare R2." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Action Button Row -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PurgeStatusText" Text="Select one or more games above, then choose the components to purge." FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="ExecutePurgeButton" Style="{StaticResource DevDangerButton}" IsEnabled="False" Click="ExecutePurgeButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="EXECUTE PURGE SELECTED GAMES" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: TOKEN MANAGEMENT & REVOCATION -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Token Management &amp; Revoke" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TokenSearchTextBox"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="32,8,12,8"
                                     FontSize="12"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     TextChanged="TokenSearchTextBox_TextChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="Search by token key or user display name..."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       FontSize="12"
                                       Margin="34,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=TokenSearchTextBox, Converter={StaticResource BoolToVis}}"/>
                            <Button Grid.Column="1" Content="Reload Tokens" Style="{StaticResource DevSecondaryButton}" Margin="8,0,0,0" Click="ReloadTokens_Click"/>
                        </Grid>
                    </Border>

                    <!-- Tokens List DataGrid -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
                        <DataGrid x:Name="TokensDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  CanUserResizeRows="False"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Token Key" Binding="{Binding Token}" Width="220" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Connected Users (Display Names)" Binding="{Binding DisplayNames}" Width="*"/>
                                <DataGridTextColumn Header="Device Slot" Binding="{Binding DeviceCountText}" Width="120"/>
                                <DataGridTemplateColumn Header="Status" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#102A1A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Background" Value="#381014"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusBadge}" FontSize="10.5" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#34D399"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Verified At" Binding="{Binding VerifiedAt}" Width="140"/>
                                <DataGridTemplateColumn Header="Action" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Revoke / Activate" Style="{StaticResource DevTableActionButton}" Click="ToggleTokenActive_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: HARDWARE BANS & DEVICE UNBIND -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Hardware Bans &amp; Unbind" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DeviceSearchTextBox"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="32,8,12,8"
                                     FontSize="12"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     TextChanged="DeviceSearchTextBox_TextChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="Search by Display Name, Device ID, or Token..."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       FontSize="12"
                                       Margin="34,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=DeviceSearchTextBox, Converter={StaticResource BoolToVis}}"/>
                            <Button Grid.Column="1" Content="Reload Devices" Style="{StaticResource DevSecondaryButton}" Margin="8,0,0,0" Click="ReloadDevices_Click"/>
                        </Grid>
                    </Border>

                    <!-- Active Devices List DataGrid -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
                        <DataGrid x:Name="DevicesDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  CanUserResizeRows="False"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="150" MinWidth="130" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Hardware Device ID" Binding="{Binding DeviceId}" Width="180" MinWidth="160"/>
                                <DataGridTextColumn Header="Assigned Token" Binding="{Binding Token}" Width="130" MinWidth="110"/>
                                <DataGridTextColumn Header="Slot" Binding="{Binding SlotName}" Width="75" MinWidth="60"/>
                                <DataGridTemplateColumn Header="Actions" Width="*" MinWidth="215">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Unbind Device" Style="{StaticResource DevTableActionButton}" Margin="0,0,6,0" Click="UnbindDeviceItem_Click"/>
                                                <Button Content="⛔ Ban Hardware" Style="{StaticResource DevTableDangerButton}" Click="BanDeviceItem_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Blocked Hardware Section Title -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,8" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Permanently Blocked Devices (Hardware Blacklist)" FontWeight="Bold" FontSize="13" Foreground="#EF4444"/>
                        <TextBlock Text="— These devices are completely blocked from using the app or binding tokens." FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Blocked Hardware Table -->
                    <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
                        <DataGrid x:Name="BlockedDevicesDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  CanUserResizeRows="False"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hardware ID" Binding="{Binding DeviceId}" Width="250" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Block Reason" Binding="{Binding Reason}" Width="*"/>
                                <DataGridTextColumn Header="Blocked By" Binding="{Binding BlockedBy}" Width="130"/>
                                <DataGridTextColumn Header="Blocked Date" Binding="{Binding CreatedAt}" Width="140"/>
                                <DataGridTemplateColumn Header="Action" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🔓 Unblock" Style="{StaticResource DevTableActionButton}" Click="UnblockDevice_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: USER ROLES & PROFILES -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="User Roles &amp; Profiles" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UserSearchTextBox"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="32,8,12,8"
                                     FontSize="12"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     TextChanged="UserSearchTextBox_TextChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="Search user by Display Name, Device ID, or Bio..."
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       FontSize="12"
                                       Margin="34,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=UserSearchTextBox, Converter={StaticResource BoolToVis}}"/>
                            <Button Grid.Column="1" Content="Reload Users" Style="{StaticResource DevSecondaryButton}" Margin="8,0,0,0" Click="ReloadUsers_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
                        <DataGrid x:Name="UsersDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionChanged="UsersDataGrid_SelectionChanged"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  CanUserResizeRows="False"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="UID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="160" FontWeight="Bold"/>
                                <DataGridTemplateColumn Header="Role Badge" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1F2937"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="0">
                                                                <Setter Property="Background" Value="#450A0A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="3">
                                                                <Setter Property="Background" Value="#172554"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="1">
                                                                <Setter Property="Background" Value="#064E3B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="2">
                                                                <Setter Property="Background" Value="#1F2937"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="0">
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="3">
                                                                    <Setter Property="Foreground" Value="#3B82F6"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="1">
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="2">
                                                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceId}" Width="180"/>
                                <DataGridTextColumn Header="Bio" Binding="{Binding Bio}" Width="*"/>
                                <DataGridTextColumn Header="Last Activity" Binding="{Binding CreatedAt}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Role Edit Action Panel -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Change Role:" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <ComboBox Grid.Column="1" x:Name="RoleLevelComboBox" Height="36" VerticalContentAlignment="Center" FontSize="12">
                                <ComboBoxItem Content="0 - ADMIN" Tag="0"/>
                                <ComboBoxItem Content="3 - MODERATOR" Tag="3"/>
                                <ComboBoxItem Content="1 - SUPPORTER" Tag="1"/>
                                <ComboBoxItem Content="2 - MEMBER" Tag="2" IsSelected="True"/>
                            </ComboBox>

                            <Button Grid.Column="2" x:Name="UpdateRoleButton" Content="Save Role" Style="{StaticResource DevPrimaryButton}" Margin="10,0,0,0" Click="UpdateRoleButton_Click"/>

                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <Button Content="Reset Avatar to Default" Style="{StaticResource DevSecondaryButton}" Margin="0,0,8,0" Click="ResetUserAvatar_Click"/>
                                <Button Content="Clear Bio" Style="{StaticResource DevSecondaryButton}" Click="ClearUserBio_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: STORAGE EXPLORER -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Cloud Storage Manager" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <!-- Top Summary Metric Cards -->
                        <RowDefinition Height="Auto"/>
                        <!-- Sub-tab Navigation & Actions Toolbar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Main Content (Storage Table or Maintenance) -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Top Summary Metric Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Cloudflare R2 GameBypass -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="#EC4899" BorderThickness="1.2" CornerRadius="12" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#261022" BorderBrush="#EC4899" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="🚀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Cloudflare R2" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Border Background="#33EC4899" BorderBrush="#EC4899" BorderThickness="1" CornerRadius="5" Padding="6,1.5" Margin="8,0,0,0">
                                            <TextBlock Text="gamebypass/" FontSize="10" FontWeight="SemiBold" Foreground="#EC4899"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Game bypass archives and executable patches" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="R2TotalSizeText" Text="Calculating..." FontSize="18" FontWeight="Bold" Foreground="#EC4899" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="R2TotalFilesText" Text="0 files" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 2: Backblaze B2 OnlineFix -->
                        <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="#38BDF8" BorderThickness="1.2" CornerRadius="12" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#0C2338" BorderBrush="#38BDF8" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Backblaze B2" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                                        <Border Background="#2038BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="6,1.5" Margin="8,0,0,0">
                                            <TextBlock Text="onlinefix/" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Multiplayer / OnlineFix crack archives" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="B2TotalSizeText" Text="Calculating..." FontSize="18" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="B2TotalFilesText" Text="0 files" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 2. Sub-Tab Filter & Toolbar -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Main Controls Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Sub-view Segment Toggle -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="StorageSubTabGameBypassRadio"
                                                 Content="🚀 GameBypass (R2)"
                                                 GroupName="StorageSubTabs"
                                                 IsChecked="True"
                                                 Checked="StorageSubTab_Checked"
                                                 Cursor="Hand"
                                                 FontSize="12"
                                                 FontWeight="SemiBold"
                                                 Foreground="{DynamicResource ForegroundBrush}"
                                                 Margin="0,0,14,0"/>
                                    <RadioButton x:Name="StorageSubTabOnlineFixRadio"
                                                 Content="📦 OnlineFix (B2)"
                                                 GroupName="StorageSubTabs"
                                                 Checked="StorageSubTab_Checked"
                                                 Cursor="Hand"
                                                 FontSize="12"
                                                 FontWeight="SemiBold"
                                                 Foreground="{DynamicResource ForegroundBrush}"
                                                 Margin="0,0,14,0"/>
                                    <RadioButton x:Name="StorageSubTabMaintenanceRadio"
                                                 Content="🛠️ Maintenance &amp; Scanner"
                                                 GroupName="StorageSubTabs"
                                                 Checked="StorageSubTab_Checked"
                                                 Cursor="Hand"
                                                 FontSize="12"
                                                 FontWeight="SemiBold"
                                                 Foreground="{DynamicResource ForegroundBrush}"/>
                                </StackPanel>

                                <!-- Search Filter (Active for R2 & B2) -->
                                <Grid Grid.Column="1" Margin="16,0,16,0" x:Name="StorageSearchContainer">
                                    <TextBox x:Name="StorageSearchTextBox"
                                             Background="{DynamicResource InputBackgroundBrush}"
                                             Foreground="{DynamicResource ForegroundBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             BorderThickness="1"
                                             Padding="30,6,12,6"
                                             FontSize="12"
                                             Height="36"
                                             VerticalContentAlignment="Center"
                                             TextChanged="StorageSearchTextBox_TextChanged"/>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBlock Text="Search file name, key, category, or AppID..."
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               FontSize="11.5"
                                               Margin="32,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding Text.IsEmpty, ElementName=StorageSearchTextBox, Converter={StaticResource BoolToVis}}"/>
                                </Grid>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="StorageReplaceLuaManifestButton"
                                            Style="{StaticResource DevSecondaryButton}"
                                            Height="36"
                                            Padding="12,0"
                                            Margin="0,0,8,0"
                                            Click="ReplaceLuaManifestButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Replace Lua/Manifest" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="UploadStorageFileButton"
                                            Style="{StaticResource DevPrimaryButton}"
                                            Height="36"
                                            Padding="14,0"
                                            Margin="0,0,8,0"
                                            Click="UploadStorageFile_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="+" FontWeight="Bold" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Upload File" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="RefreshStorageButton"
                                            Style="{StaticResource DevSecondaryButton}"
                                            Height="36"
                                            Padding="14,0"
                                            Click="RefreshStorageButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Refresh Storage" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Subfolder / Category Filter Row for GameBypass R2 -->
                            <Border x:Name="StorageCategoryFilterContainer" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="CATEGORY FOLDERS:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <!-- ALL -->
                                    <RadioButton x:Name="StorageCatAllRadio" Style="{StaticResource StorageCategoryPillStyle}" GroupName="StorageCategoryFilters" Tag="ALL" IsChecked="True" Checked="StorageCategoryFilter_Checked">
                                        <TextBlock Text="ALL" VerticalAlignment="Center"/>
                                    </RadioButton>

                                    <!-- DENUVO -->
                                    <RadioButton x:Name="StorageCatDenuvoRadio" Style="{StaticResource StorageCategoryPillStyle}" GroupName="StorageCategoryFilters" Tag="DENUVO" Checked="StorageCategoryFilter_Checked">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Width="11" Height="12" Margin="0,0,6,0" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  Data="M12,1 L3,5 V11 C3,16.55 6.84,21.74 12,23 C17.16,21.74 21,16.55 21,11 V5 Z M12,3.18 L19,6.3 V11 C19,15.52 16.02,19.69 12,20.93 C7.98,19.69 5,15.52 5,11 V6.3 Z"/>
                                            <TextBlock Text="DENUVO" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- UBISOFT -->
                                    <RadioButton x:Name="StorageCatUbisoftRadio" Style="{StaticResource StorageCategoryPillStyle}" GroupName="StorageCategoryFilters" Tag="UBISOFT" Checked="StorageCategoryFilter_Checked">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  Data="M12,2 A10,10 0 1,0 22,12 A10,10 0 0,0 12,2 Z M12,4 A8,8 0 0,1 20,12 C20,15.2 18,17.9 15.2,19.2 C13.7,19.9 11.9,19.8 10.5,19 C8.6,17.9 7.4,16 7.1,13.8 C6.8,11.5 7.6,9.3 9.2,7.7 C10.8,6.1 13.1,5.4 15.3,5.8 C14.5,7 13.1,7.8 11.6,7.8 C9.8,7.8 8.4,9.2 8.4,11 C8.4,12.8 9.8,14.2 11.6,14.2 C13,14.2 14.2,13.3 14.6,12 C14.8,11.4 14.7,10.7 14.3,10.2 C13.9,9.7 13.3,9.4 12.6,9.4 C11.7,9.4 11,10.1 11,11 C11,11.9 11.7,12.6 12.6,12.6 C13,12.6 13.4,12.4 13.6,12.1"/>
                                            <TextBlock Text="UBISOFT" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- EA -->
                                    <RadioButton x:Name="StorageCatEARadio" Style="{StaticResource StorageCategoryPillStyle}" GroupName="StorageCategoryFilters" Tag="EA" Checked="StorageCategoryFilter_Checked">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="15" Height="15" CornerRadius="7.5" BorderThickness="1.2" Margin="0,0,6,0"
                                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="EA" FontSize="7" FontWeight="Black" FontStyle="Italic"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-0.5,0,0"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                            </Border>
                                            <TextBlock Text="EA" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- ROCKSTAR -->
                                    <RadioButton x:Name="StorageCatRockstarRadio" Style="{StaticResource StorageCategoryPillStyle}" GroupName="StorageCategoryFilters" Tag="ROCKSTAR" Checked="StorageCategoryFilter_Checked">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="16" Height="16" CornerRadius="3" BorderThickness="1.2" Margin="0,0,6,0"
                                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                    VerticalAlignment="Center">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="R" FontSize="10" FontWeight="Black" Margin="-2.5,-1,2.5,0"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                                    <Path Width="5" Height="5" Margin="4,3,0,0" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                          Data="M12,2 L15.09,8.26 L22,9.27 L17,14.14 L18.18,21.02 L12,17.77 L5.82,21.02 L7,14.14 L2,9.27 L8.91,8.26 Z"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="ROCKSTAR" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- OTHERS -->
                                    <RadioButton x:Name="StorageCatOthersRadio" Style="{StaticResource StorageCategoryPillStyle}" GroupName="StorageCategoryFilters" Tag="OTHERS" Checked="StorageCategoryFilter_Checked">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  Data="M5,12 A2,2 0 1,1 1,12 A2,2 0 1,1 5,12 Z M14,12 A2,2 0 1,1 10,12 A2,2 0 1,1 14,12 Z M23,12 A2,2 0 1,1 19,12 A2,2 0 1,1 23,12 Z"/>
                                            <TextBlock Text="OTHERS" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 3. Main Content Panel -->
                    <Grid Grid.Row="2">
                        <!-- Storage Files DataGrid View -->
                        <Border x:Name="StorageDataGridContainer" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
                            <DataGrid x:Name="StorageDataGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      CanUserResizeRows="False"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <!-- File Name / Key -->
                                    <DataGridTemplateColumn Header="Remote File / Object Key" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Key}">
                                                    <TextBlock Text="{Binding KeyIcon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Category Badge -->
                                    <DataGridTemplateColumn Header="Category" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Center">
                                                    <Border Background="{Binding CategoryBadgeBackground}"
                                                            BorderBrush="{Binding CategoryBadgeBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="6,2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding CategoryBadgeVisibility}">
                                                        <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{Binding CategoryBadgeForeground}"/>
                                                    </Border>
                                                    <TextBlock Text="—" FontSize="11" Foreground="#64748B"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding NoCategoryVisibility}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- AppID Badge -->
                                    <DataGridTemplateColumn Header="AppID" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AppIdText}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Matched Game Title -->
                                    <DataGridTemplateColumn Header="Matched Game Title" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MatchedGameTitle}" FontSize="11.5" Foreground="{Binding MatchedTitleForeground}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- File Size -->
                                    <DataGridTemplateColumn Header="Size" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding SizeBadgeBackground}" BorderBrush="{Binding SizeBadgeBorder}" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FormattedSize}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding SizeBadgeForeground}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Last Modified -->
                                    <DataGridTextColumn Header="Last Modified" Binding="{Binding FormattedDate}" Width="135" IsReadOnly="True" FontSize="11.5"/>

                                    <!-- Row Actions -->
                                    <DataGridTemplateColumn Header="Actions" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="⬇ Download"
                                                            Style="{StaticResource DevTableActionButton}"
                                                            Padding="8,4"
                                                            Margin="0,0,6,0"
                                                            Click="DownloadStorageFile_Click"/>
                                                    <Button Content="🗑 Delete"
                                                            ToolTip="Delete file from cloud storage"
                                                            Style="{StaticResource DevTableDangerButton}"
                                                            Padding="8,4"
                                                            Click="DeleteStorageFile_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Storage Maintenance & Orphan Scanner View (Hidden by default, shown via sub-tab) -->
                        <Grid x:Name="StorageMaintenanceContainer" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Storage Maintenance &amp; Orphan Scanner" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="Scan Backblaze B2 and Cloudflare R2 for orphan files with no corresponding database entry." FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Clear Local Avatar Cache" Style="{StaticResource DevSecondaryButton}" Margin="0,0,8,0" Click="ClearAvatarDiskCache_Click"/>
                                        <Button Content="Scan Orphan Storage" Style="{StaticResource DevPrimaryButton}" Click="ScanOrphanStorage_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="{StaticResource DevTerminalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                <TextBox x:Name="StorageLogsTextBox"
                                         Background="Transparent"
                                         Foreground="#34D399"
                                         BorderThickness="0"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Text="Click 'Scan Orphan Storage' to analyze Backblaze B2, Cloudflare R2, and Supabase Storage."/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 6: BROADCAST -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEC42;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Pinned Announcement" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- CARD 1: ACTIVE PINNED ANNOUNCEMENT STATUS -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Current Active Pinned Announcement" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="This announcement is currently pinned at the top of Community Chat for all users." FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="RefreshBroadcastBtn" Content="Refresh" Style="{StaticResource DevSecondaryButton}" Margin="0,0,8,0" Click="RefreshBroadcast_Click"/>
                                    <Button x:Name="DeleteBroadcastBtn" Content="🗑️ Delete / Unpin Announcement" Style="{StaticResource DevDangerButton}" Click="DeleteBroadcast_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Active Announcement Card Content -->
                            <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,14,0,0">
                                <Grid>
                                    <StackPanel x:Name="ActiveBroadcastPanel" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="#102A1A" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="PINNED ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                            </Border>
                                            <TextBlock x:Name="ActiveBroadcastTimeText" Text="Posted: 2026-10-02 08:00" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ActiveBroadcastTitleText" Text="📢 Title" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock x:Name="ActiveBroadcastMessageText" Text="Message body..." FontSize="12" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- No Broadcast State -->
                                    <TextBlock x:Name="NoActiveBroadcastText"
                                               Text="ℹ️ No pinned broadcast announcement is currently active."
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Visibility="Visible"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CARD 2: PUBLISH / UPDATE PINNED ANNOUNCEMENT -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                        <StackPanel MaxWidth="750" HorizontalAlignment="Left">
                            <TextBlock Text="Publish New Pinned Announcement" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="Publishing will instantly pin this message at the top of the chat and replace any previous announcement." FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,4,0,16"/>

                            <TextBlock Text="Announcement Title:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="BroadcastTitleInput" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Height="38" Text="📢 System Announcement"/>

                            <TextBlock Text="Message Content:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ForegroundBrush}" Margin="0,12,0,6"/>
                            <TextBox x:Name="BroadcastBodyInput" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Height="100" TextWrapping="Wrap" AcceptsReturn="True" Text="Scheduled maintenance or new game catalog updates are now available."/>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="📢 Publish &amp; Pin Announcement" Style="{StaticResource DevPrimaryButton}" Padding="20,10" Click="BroadcastMessage_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 7: DIAGNOSTICS -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE958;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Diagnostics &amp; Logs" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Live Service Health &amp; Latency Check" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock x:Name="DiagnosticsSummaryText" Text="Click 'Run Diagnostics' to test latency and connectivity for all cloud endpoints." FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Run Diagnostics" Style="{StaticResource DevPrimaryButton}" Click="RunDiagnostics_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource DevTerminalBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="DiagnosticsConsoleTextBox"
                                     Background="Transparent"
                                     Foreground="#38BDF8"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Text="System diagnostic console ready."/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="Copy Logs" Style="{StaticResource DevSecondaryButton}" Margin="0,0,8,0" Click="CopyLogs_Click"/>
                                <Button Content="Clear Console" Style="{StaticResource DevSecondaryButton}" Click="ClearConsole_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 8: CUSTOM LAUNCH TUTORIALS -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Custom Launch Tutorials" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT PANEL: Tutorials Directory & Search -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top Section: Header, Filter Pills, Search & New Button -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <!-- Header & Stats -->
                                <TextBlock Text="TUTORIALS DIRECTORY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="TutorialsCountText" Text="Loading tutorials from Cloudflare R2..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,2,0,10"/>

                                <!-- Platform Filter Pills -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton Content="ALL" Tag="ALL" Style="{StaticResource StorageCategoryPillStyle}" IsChecked="True" Checked="TutorialFilter_Checked"/>
                                    <RadioButton Content="GameBypass" Tag="GAMEBYPASS" Style="{StaticResource StorageCategoryPillStyle}" Checked="TutorialFilter_Checked"/>
                                    <RadioButton Content="OnlineFix" Tag="ONLINEFIX" Style="{StaticResource StorageCategoryPillStyle}" Checked="TutorialFilter_Checked"/>
                                </StackPanel>

                                <!-- Search & Action Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TutorialSearchTextBox" Grid.Column="0" Height="36"
                                             Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                             Padding="10,0" VerticalContentAlignment="Center" FontSize="12"
                                             TextChanged="TutorialSearchTextBox_TextChanged"/>
                                    <Button Grid.Column="1" Style="{StaticResource DevPrimaryButton}" Height="36" Padding="14,0" Margin="8,0,0,0" Click="NewTutorialButton_Click" ToolTip="Create new tutorial">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="New" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Tutorials List -->
                            <ListBox x:Name="TutorialsListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="TutorialsListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#131926" BorderBrush="#222A3B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,6" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#263B82F6" BorderBrush="#3B82F6" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GameTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Border Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding AppId, StringFormat='ID: {0}'}" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                                        </Border>
                                                        <Border Background="#162E3B" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding ApplicableTo}" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Steps.Count, StringFormat='{}{0} Steps'}" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Refresh Button -->
                            <Button Grid.Row="2" Content="Refresh Tutorials from R2" Style="{StaticResource DevSecondaryButton}" Height="34" Margin="0,10,0,0" Click="RefreshTutorials_Click"/>
                        </Grid>
                    </Border>

                    <!-- RIGHT PANEL: Tutorial Form Editor -->
                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Form Header -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TutorialEditorTitle" Text="Tutorial Editor: Create / Edit" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="Configure launch bypass guide, executable parameters, and step-by-step instructions for players." FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="DeleteTutorialButton" Content="Delete Tutorial" Style="{StaticResource DevDangerButton}" Height="34" Margin="0,0,8,0" Click="DeleteTutorial_Click"/>
                                        <Button x:Name="PublishTutorialButton" Content="🚀 Publish to Cloud (R2)" Style="{StaticResource DevPrimaryButton}" Height="34" Click="PublishTutorial_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Game Details (Platform & AppId & Game Title) -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="TARGET PLATFORM *" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="EditorPlatformComboBox" Style="{StaticResource DevComboBoxStyle}" ItemContainerStyle="{StaticResource DevComboBoxItemStyle}" Height="36">
                                            <ComboBoxItem Content="ALL (Both)" Tag="ALL" IsSelected="True"/>
                                            <ComboBoxItem Content="GameBypass" Tag="GAMEBYPASS"/>
                                            <ComboBoxItem Content="OnlineFix" Tag="ONLINEFIX"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="STEAM APP ID *" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EditorAppIdTextBox" Height="36" Padding="8,0" VerticalContentAlignment="Center" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" TextChanged="EditorAppIdTextBox_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="GAME TITLE *" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EditorGameTitleTextBox" Height="36" Padding="8,0" VerticalContentAlignment="Center" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                    </StackPanel>
                                    <Button Grid.Column="5" Content="Lookup in Catalog" Style="{StaticResource DevSecondaryButton}" Height="36" Margin="10,18,0,0" Click="LookupCatalogGame_Click"/>
                                </Grid>

                                <!-- Summary / Notice -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="SUMMARY / NOTICE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="EditorSummaryTextBox" Height="54" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                </StackPanel>

                                <!-- Recommended Executable & Arguments -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="RECOMMENDED EXECUTABLE (RELATIVE PATH)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EditorExeTextBox" Height="36" Padding="8,0" VerticalContentAlignment="Center" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ToolTip="Example: PlayGTAV.exe or binaries/game.exe"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="RECOMMENDED ARGUMENTS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EditorArgsTextBox" Height="36" Padding="8,0" VerticalContentAlignment="Center" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ToolTip="Example: -offline -scofflineonly"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Steps Editor -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="STEP-BY-STEP INSTRUCTIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+ Add Step" Style="{StaticResource DevSecondaryButton}" Height="28" Padding="10,0" Click="AddStepButton_Click"/>
                                </Grid>

                                <ItemsControl x:Name="EditorStepsItemsControl" Margin="0,0,0,14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111726" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="#2563EB" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StepNumber}" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBox Grid.Column="1" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="6,0" VerticalContentAlignment="Center" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                                        <Button Grid.Column="2" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="26" Height="26" Margin="6,0,0,0" Style="{StaticResource DevTableDangerButton}" Tag="{Binding}" Click="RemoveStepButton_Click" ToolTip="Delete this step"/>
                                                    </Grid>
                                                    <TextBox Grid.Row="1" Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="46" TextWrapping="Wrap" AcceptsReturn="True" Padding="6" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="30,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Notes & Troubleshooting -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="NOTES / TROUBLESHOOTING" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="EditorNotesTextBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
