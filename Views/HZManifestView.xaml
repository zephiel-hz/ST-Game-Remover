<UserControl x:Class="SteamPluginManager.Views.HZManifestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SteamPluginManager.Helpers"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <!-- Modern Rounded Button Style for category tabs -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Manifest Card Style (Optimized: Hardware Accelerated, No Blur Shader Overhead) -->
        <Style x:Key="ManifestCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style for Dropdown Filters -->
        <Style x:Key="ManifestComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid Background="Transparent">
                            <ToggleButton Name="DropDownToggle"
                                          Grid.Column="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Name="toggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Content="{TemplateBinding Content}"
                                                                  Margin="10,0,0,0"
                                                                  VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="▾"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Margin="0,0,4,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="toggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="toggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Name="contentPresenter"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            </ToggleButton>
                            <Popup Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   Margin="0,3,0,0">
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="4">
                                    <ScrollViewer CanContentScroll="True"
                                                  MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                                                  MaxHeight="180">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Search Box -->
        <Style x:Key="ManifestSearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="30,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="SearchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="SearchBorder" Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <Style x:Key="RequestPopupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Width" Value="520"/>
            <Setter Property="MaxWidth" Value="520"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="12" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RequestPopupTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#1E2638"/>

        <Style x:Key="RequestPopupButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ultra-Modern Loading Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="LoadingOverlay" Background="#66000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="32,24"
                    MinWidth="260"
                    MaxWidth="360">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="12" Opacity="0.45"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- High-Precision Dual Ring Glowing Spinner -->
                    <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <!-- Outer Track Ring -->
                        <Ellipse Width="56" Height="56"
                                 Stroke="{DynamicResource BorderBrush}"
                                 StrokeThickness="3.5"
                                 Opacity="0.4"/>
                        <!-- Inner Glowing Accent Rotating Arc -->
                        <Canvas Width="56" Height="56" RenderTransformOrigin="0.5,0.5">
                            <Canvas.RenderTransform>
                                <RotateTransform x:Name="ContinuousRotate" Angle="0"/>
                            </Canvas.RenderTransform>
                            <Ellipse Width="56" Height="56"
                                     Stroke="{DynamicResource AccentBrush}"
                                     StrokeThickness="3.5"
                                     StrokeDashArray="42 100"
                                     StrokeStartLineCap="Round"
                                     StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Grid>

                    <!-- Status Main Title -->
                    <TextBlock x:Name="LoadingStatusText"
                               Text="Loading manifests..."
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="13.5"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>

                    <!-- Subtitle / Hint -->
                    <TextBlock Text="Please wait while data is being prepared..."
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               FontSize="11"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Debug Info (Hidden) -->
        <Border Grid.Row="0" Background="Red" Padding="10" Visibility="Collapsed">
            <TextBlock x:Name="DebugInfo" Text="DEBUG" Foreground="White" FontSize="12"/>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="14,12,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Command & Filter Bar -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- SearchBox with Placeholder -->
                    <Grid Grid.Column="0">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource ManifestSearchBoxStyle}"
                                 VerticalAlignment="Center" 
                                 Margin="0,0,10,0"/>
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Search games, DLCs, or App IDs..." Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Category Filter Dropdown -->
                    <ComboBox Grid.Column="1" x:Name="CategoryFilterComboBox" Width="170" Height="36"
                              Style="{StaticResource ManifestComboBoxStyle}"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                              SelectionChanged="CategoryFilterComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" FontSize="12"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Sort Dropdown -->
                    <ComboBox Grid.Column="2" x:Name="SortComboBox" Width="130" Height="36"
                              Style="{StaticResource ManifestComboBoxStyle}"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                              SelectionChanged="SortComboBox_SelectionChanged">
                        <ComboBoxItem Content="Name A-Z" Tag="NameAsc"/>
                        <ComboBoxItem Content="Name Z-A" Tag="NameDesc"/>
                        <ComboBoxItem Content="Newest First" Tag="DateDesc"/>
                        <ComboBoxItem Content="Oldest First" Tag="DateAsc"/>
                        <ComboBoxItem Content="Category A-Z" Tag="CategoryAsc"/>
                        <ComboBoxItem Content="Category Z-A" Tag="CategoryDesc"/>
                    </ComboBox>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RefreshButton" Width="36" Height="36" Click="Refresh_Click" Margin="0,0,6,0"
                                Style="{StaticResource RoundedButtonStyle}"
                                ToolTip="Refresh Manifests">
                            <TextBlock x:Name="RefreshText" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="RequestButton" Width="36" Height="36" Click="RequestButton_Click"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="{DynamicResource AccentBrush}"
                                BorderThickness="0"
                                ToolTip="Request New Manifest">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Hidden Preserved Controls for Code-behind Compatibility -->
                        <StackPanel Visibility="Collapsed">
                            <StackPanel x:Name="CategoryTabs"/>
                            <Button x:Name="BackButton" Click="BackToDashboard_Click">
                                <TextBlock x:Name="BackButtonText" Text="Back"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cards & Pagination Area -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cards Grid -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0" x:Name="CardsScrollViewer" Focusable="False" IsTabStop="False">
                    <ItemsControl x:Name="FileCards" ItemsSource="{Binding Files, Mode=OneWay}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel x:Name="CardPanel" IsItemsHost="True" Orientation="Horizontal" HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ManifestCardStyle}" ClipToBounds="True" MinWidth="180" Height="276" MouseLeftButtonUp="FileCard_MouseLeftButtonUp" Cursor="Hand" x:Name="CardBorder" Loaded="CardBorder_Loaded" Margin="0,0,12,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                             <RowDefinition Height="134"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Thumbnail Image Area -->
                                        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" CornerRadius="13,13,0,0" ClipToBounds="True" Loaded="ThumbnailBorder_Loaded" SizeChanged="ThumbnailBorder_SizeChanged">
                                            <Grid>
                                                <!-- Fallback Placeholder Icon -->
                                                <TextBlock Text="🎮" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.25"/>
                                                <!-- Game Thumbnail Image with Direct Binding -->
                                                <Image x:Name="ThumbnailImage"
                                                       Source="{Binding ThumbnailPath, Mode=OneWay, TargetNullValue={x:Null}}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="Linear"
                                                       VerticalAlignment="Stretch"
                                                       HorizontalAlignment="Stretch"/>
                                            </Grid>
                                        </Border>

                                        <!-- Game Information -->
                                        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="12,10,12,10">
                                            <!-- Game Name -->
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ForegroundBrush}" FontSize="12.5" Margin="0,0,0,6" MaxHeight="34"/>

                                            <!-- Badges Row -->
                                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <!-- Genre Badge -->
                                                <Border Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,5,3" HorizontalAlignment="Left" Visibility="{Binding GenreBadgeDisplay, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding GenreBadgeDisplay}" FontSize="9" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                                </Border>

                                                <!-- Download Count Badge -->
                                                <Border Background="#2010B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding DownloadCountDisplay, StringFormat='Downloads: {0}'}" FontSize="9" Foreground="{DynamicResource SuccessButtonBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                            </WrapPanel>

                                            <!-- App ID -->
                                            <TextBlock Text="{Binding AppId, StringFormat='ID: {0}'}" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Modern Pagination Footer -->
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Previous Button -->
                        <Button Grid.Column="0" x:Name="PreviousPageButton" Width="105" Height="34" 
                                Background="{DynamicResource PrimaryButtonBrush}"
                                Style="{StaticResource CompactIconButtonStyle}"
                                Tag="{StaticResource Icon.Back}"
                                Click="PreviousPage_Click">
                            <TextBlock Text="Previous" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11.5"/>
                        </Button>

                        <!-- Page Indicator & Jump To Page -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="PageIndicator" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                            <Border Margin="14,0,0,0" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,3" VerticalAlignment="Center" Visibility="Collapsed" x:Name="JumpToPageContainer">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Go to:" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="JumpToPageTextBox" Width="38" Height="22" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="11" Background="Transparent" Foreground="{DynamicResource ForegroundBrush}" BorderThickness="0" KeyDown="JumpToPageTextBox_KeyDown"/>
                                    <Button x:Name="JumpToPageButton" Width="36" Height="22" Margin="6,0,0,0" Padding="0" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" Foreground="White" FontSize="11" FontWeight="SemiBold" Click="JumpToPage_Click">Go</Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Next Button -->
                        <Button Grid.Column="2" x:Name="NextPageButton" Width="105" Height="34" 
                                Background="{DynamicResource PrimaryButtonBrush}"
                                Style="{StaticResource CompactIconButtonStyle}"
                                Tag="{StaticResource Icon.Forward}"
                                Click="NextPage_Click">
                            <TextBlock Text="Next" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11.5"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Floating Notification Banner -->
        <Border Grid.Row="1" x:Name="NotificationBanner"
                Panel.ZIndex="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="480"
                MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,14"
                Margin="20,12,20,0"
                Visibility="Collapsed"
                Cursor="Hand"
                MouseLeftButtonUp="NotificationBanner_Click">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="8" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="NotificationBannerTitle"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontSize="13.5"/>
                    <TextBlock x:Name="NotificationBannerDetails"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,4,0,0"
                               FontSize="11.5"/>
                    <TextBlock Text="Click to view newly added games →"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="✕"
                        Width="26"
                        Height="26"
                        FontSize="11"
                        Background="Transparent"
                        Foreground="{DynamicResource MutedForegroundBrush}"
                        BorderBrush="Transparent"
                        Cursor="Hand"
                        Click="NotificationBannerClose_Click"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- New Manifests List Modal -->
        <Grid x:Name="NewManifestPopupOverlay"
              Grid.Row="0"
              Grid.RowSpan="2"
              Panel.ZIndex="40"
              Visibility="Collapsed"
              Background="#B2000000">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="480"
                    MaxHeight="560"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="12" Opacity="0.35"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="New Game Manifests"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       FontSize="17"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="NewManifestPopupSubtitle"
                                       Text="Recently added games to the catalog"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="✕"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                Foreground="{DynamicResource MutedForegroundBrush}"
                                BorderBrush="Transparent"
                                FontSize="12"
                                Cursor="Hand"
                                Click="NewManifestPopupClose_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="400">
                        <ItemsControl ItemsSource="{Binding NewManifestFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12.5"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding AppId, StringFormat='ID: {0}'}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           FontSize="11"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="6"
                                                    Padding="8,3"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="NEW"
                                                           Foreground="White"
                                                           FontSize="9.5"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Content="Close"
                            Style="{StaticResource RequestPopupButtonStyle}"
                            Width="100"
                            Height="38"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0"
                            Background="{DynamicResource PrimaryButtonBrush}"
                            Click="NewManifestPopupClose_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
