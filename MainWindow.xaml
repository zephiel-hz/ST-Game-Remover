<Window x:Class="SteamPluginManager.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Steam Plugin Manager" Height="700" Width="1200">
	<Grid x:Name="RootGrid">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Header / Controls -->
		<Border Grid.Row="0" Margin="8" x:Name="CardsArea">
			<StackPanel Orientation="Horizontal">
				<TextBox x:Name="SearchBox" Width="300" Margin="0,0,8,0" />
				<ToggleButton x:Name="ThemeToggle" Content="Theme" Margin="0,0,8,0" />
				<Button x:Name="SelectAllBtn" Content="Select All" Margin="0,0,4,0" />
				<Button x:Name="SelectNoneBtn" Content="Select None" />
			</StackPanel>
		</Border>

		<!-- Main content area -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="3*" />
				<ColumnDefinition Width="2*" />
			</Grid.ColumnDefinitions>

			<!-- Left: Game list -->
			<Border Grid.Column="0" Margin="8" x:Name="GameListBorder">
				<ListView x:Name="GameList">
					<ListView.View>
						<GridView x:Name="GameGridView">
							<GridViewColumn x:Name="SelectColumn" Header="Select" Width="60" />
							<GridViewColumn x:Name="NameColumn" Header="Name" Width="300" />
						</GridView>
					</ListView.View>
				</ListView>
			</Border>

			<!-- Right: Game details -->
			<Border Grid.Column="1" Margin="8" x:Name="GameDetailsBorder">
				<ScrollViewer>
					<StackPanel x:Name="GameDetailsPanel" Margin="8">
						<TextBlock x:Name="GameDetailName" FontSize="18" FontWeight="Bold" />
						<TextBlock>
							<Run Text="AppID: " /><Run x:Name="GameDetailAppId" />
						</TextBlock>
						<TextBlock>
							<Run Text="Genre: " /><Run x:Name="GameDetailGenre" />
						</TextBlock>
						<TextBlock x:Name="GameDetailInstallationStatus" />
						<Image x:Name="GameScreenshot" Height="180" Stretch="Uniform" Margin="0,8,0,8" />
						<TextBlock x:Name="GameDetailReleaseDateLabel" FontWeight="Bold" />
						<TextBlock x:Name="GameDetailReleaseDate" />
						<StackPanel x:Name="GameDetailPublisherPanel">
							<TextBlock Text="Publisher:" FontWeight="Bold" />
							<TextBlock x:Name="GameDetailPublisher" />
						</StackPanel>
						<StackPanel x:Name="GameDetailDRMPanel">
							<TextBlock Text="DRM:" FontWeight="Bold" />
							<TextBlock x:Name="GameDetailDRM" />
						</StackPanel>
						<StackPanel x:Name="GameDetailAntiCheatPanel">
							<TextBlock Text="Anti-Cheat:" FontWeight="Bold" />
							<TextBlock x:Name="GameDetailAntiCheat" />
						</StackPanel>
						<TextBlock x:Name="GameDetailDescription" TextWrapping="Wrap" Margin="0,8,0,0" />
						<TextBlock x:Name="GameDetailsEmpty" Foreground="Gray" Text="No game selected" Visibility="Collapsed" />
					</StackPanel>
				</ScrollViewer>
			</Border>
		</Grid>

		<!-- Footer / Log -->
		<DockPanel Grid.Row="2" LastChildFill="True" Margin="8">
			<Border DockPanel.Dock="Top" Height="120" x:Name="LogBorder" Margin="0,8,0,0">
				<TextBox x:Name="LogBox" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" />
			</Border>
			<TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="4" />
		</DockPanel>
	</Grid>
</Window>
